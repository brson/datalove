; # Datalove Expressions example

; this is an example of the data language.
; there is also a code language.
; values need to have specified binary runtime representation

; This whole file is a single expression.
; This is opening a tuple.
; Each of the examples in this file is an element of this tuple.
(

  ; A basic example.
  ;
  ; The part between `: ... /` is on optional type hint,
  ; with the `:` token generally for naming types.
  ;
  ; fixme better example
  : [
    (@u32, @bool),
  ] / [
    (1 , @true),
    (2 , @true),
  ],

)

; fixme below is not strictly valid .dle syntax
; since it contains multiple expressions.
; Imagine them in the above tuple.






; ## Basic scalars

: @bool / @true
: @bool / @false
; with no heap sigils - infered and defaulted.
; unclear to what extent this will be supported.
; the heap sigils allow us to avoid reserving lots of keywords in type
; and expression namespaces.
: bool / true
: bool / false

: @u32 / 1
: @f32 / 1.0


; ## Heap sigils

; Every type has an associated heap - local, global, inferred,
; indicated by a sigil: @-, #-, or none for inferred.
; having sigil-less types and expressions will introduce lots
; of keywords.

: @u32 / @1
: #u32 / #1
: #u32 / 1
; infers to @
: u32 / 1

; ## Bigints

; unbounded unsigned, the default int type
: @int / 1




; ## Special types

; placeholder, zero-sized
: @nil / @nil

; named token, zero-sized
: @token Nil




; ## Tuples, structs, and enums

; anonymous tuple
: (@bool, @u32) / (@true, 1)
: (@u32 ) / (1)
: () / ()

; named tuple
: @tuple Bar (
  @bool, @u32,
) / @tuple Bar (@true, 1)

; anonymous struct
: {
  field1: @bool,
  field2: @u32,
  field3: @u32,
} / {
  ; asignment without type hint
  field1 = @true,
  ; type hint in the field syntax
  field2: @u32 = 1,
  ; type hint in expression
  field3 = : @u32 / 2,
}

; named struct
: @struct Foo {
  field1 : @bool,
} / @struct Foo {
  field1 = @true,
}

; anonymous enum
: @enum {
  Foo,
  Bar: @u32,
  Baz: (@bool, @u32),
} / @enum Foo

: @enum {
  Bar: @u32,
} / @enum Bar 2

: @enum {
  Bar: @u32,
} / @enum Bar : @u32 / 2

: @enum {
  Baz (@bool, @u32),
} / @enum Bar (@true, 1)

; named enum
@enum Quux {
  Foo,
  Bar @u32,
  Baz (@bool, @u32),
}

: @enum Quux / @enum Quux.Bar (@true, 1)

; coerced from anonymous enum
: @enum Quux / @enum Bar (@true, 1)




; ## Collection types

; list
: [@u32] / [1, 2, 3]

; string
: @string / "abc"

; map
: @map <@u32, @u32> / @map {
  0 = 5,
  2 = 2,
  ; type hint in the key syntax?
  3: @u32 = 2,
  ; type hint in the expression
  3 = : @u32 / 2,
}

; set
: @set <@u32> / @set { 1, 2, 3 }




; ## Special generic containers

; option - hm...
: @?@u32 / 4
: @?@u32 / @none
; inferred heap
: ?@u32 / 4
: ?u32 / none

; result - hm...
: @!@u32 / 4
: @!@u32 / @error "oops"
; inferred heap
: !@u32 / 4
: !@u32 / @error "oops"




; ## Dynamic types

; a dynamic any type for data types.
: @data / 1

; similar to @data
: @error / @error "oops"


