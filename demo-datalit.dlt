// # Datalove Literals example

// This whole file is a single expression.
// This is opening a tuple.
// Each of the examples in this file is an element of this tuple.
(

  // A basic example.
  //
  // The part between `: ... /` is on optional type hint,
  // with `:` always followed by a type in Datalove.
  //
  // fixme better example
  : [
    (u32, bool),
  ] / [
    (1, true),
    (2, true),
  ],

  // The type hint is optional.
  [
    (1, true),
    (2, true),
  ],

  // Type hints can go before any expression.
  [
    (1, : bool / true),
    (: u32 / 2, true),
  ],
  




  // ## Basic scalars

  : bool / true,
  : bool / false,

  : u32 / 1,
  : f32 / 1.0,

  // Also all these in this tuple.
  : (
    u8, u16, u32, u64,
    i8, i16, i32, i64,
  ) / (
    1, 2, 3, 4,
    -1, -2, -3, -4,
  ),

  // Float bitpattern coercion from hex literals (not dec literals).
  // Must have correct number of digits.
  // For when you want to preserve floats exactly.
  : f32 / 0xABABABAB,




  // ## Bigints

  // Unbounded signed.
  // Fixed-sized integer math widens to `int`,
  // and simple script computation is encouraged to use `int`.
  : int / 1,




  // ## Tuples, structs, and enums

  // Anonymous tuples.
  : (bool, u32) / (true, 1),
  : (u32 ) / (1),
  : () / (),

  // Anonymous struct.
  : {
    field1: bool,
    field2: u32,
    field3: u32,
  } / {
    // Assignment without type hint
    field1 = true,
    // Type hint in expression.
    field2 = : u32 / 1,
    // Type hint in field name.
    field3: u32 = 1,
  },

  // Anonymous enum.
  //
  // Enums either have a single-value/type payload or no payload.
  // if you want multiple values the payload should be a tuple.
  : enum {
    Foo,
    Bar(u32),
    Baz((bool, u32)),
  } / enum Foo,

  : enum {
    Bar(u32),
  } / enum Bar(2),

  : enum {
    Bar(u32),
  } / enum Bar(: u32 / 2), // with type hint in expression

  : enum {
    Baz((bool, u32)),
  } / enum Baz((true, 1)),




  // ## Collection types

  // list
  : [u32] / [1, 2, 3]
  : [u32] / []

  // string
  : string / "abc"

  // map
  : map <u32, u32>) / map {
    0 = 5,
    2 = 2,
    // Type hint in the expression.
    3 = : u32 / 2,
  }

  : map <u32, u32> / map { }

  // set
  : set <u32> / set { 1, 2, 3 }




  // ## Special generic containers

  // Option
  : ?u32 / some 4
  : ?u32 / none

  // Result
  : !u32 / ok 4
  // `er` is like Rust`s `Result::Err`, `error` is the error constructor itself.
  : !u32 / er error "oops"




  // ## Existential types

  // `data` constructor accepts any datalit value.
  : data / data 1
  // With type hint.
  : data / data : int / 1

  // Error type for representing failures.
  : error / error "oops"
  // With type hint.
  : error / error : int / 1



  // ## Heap sigils

  // Every type has an associated heap - local, global, inferred,
  // indicated by a sigil: @-, #-, or none for inferred.
  // Heaps cannot be intermixed within a single type.

  // For more heap sigil examples see demo-datalit-heap.dlt.

  : @u32 / @1,
  : #u32 / #1,
  : #u32 / 1,
  : u32 / 1,

  : @enum {
    Baz(@(@bool, @u32)),
  } / @enum Baz(@(@true, @1)),

) // end of tuple
