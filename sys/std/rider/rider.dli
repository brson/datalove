// Native string operations for sys/std.

// Basic properties.
native fun string_len(ref self: string): index
native fun string_char_count(ref self: string): index
native fun string_is_ascii(ref self: string): bool

// Searching.
native fun string_contains(ref self: string, ref pattern: string): bool
native fun string_starts_with(ref self: string, ref prefix: string): bool
native fun string_ends_with(ref self: string, ref suffix: string): bool

// Comparison.
native fun string_eq(ref self: string, ref other: string): bool
native fun string_cmp(ref self: string, ref other: string): i32
native fun string_eq_ignore_ascii_case(ref self: string, ref other: string): bool

// Character predicates.
native fun string_is_ascii_alphabetic(ref self: string): bool
native fun string_is_ascii_digit(ref self: string): bool
native fun string_is_ascii_alphanumeric(ref self: string): bool
native fun string_is_ascii_whitespace(ref self: string): bool

// Trimming.
native fun string_trim(ref self: string): string
native fun string_trim_start(ref self: string): string
native fun string_trim_end(ref self: string): string

// Case conversion.
native fun string_to_ascii_lowercase(ref self: string): string
native fun string_to_ascii_uppercase(ref self: string): string

// Construction.
native fun string_repeat(ref self: string, n: index): string
native fun string_concat(ref a: string, ref b: string): string

// Replacement.
native fun string_replace(ref self: string, ref pattern: string, ref replacement: string): string

// Byte access.
native fun string_get_byte(ref self: string, index: index): ?u8

// Searching (option returns).
native fun string_find(ref self: string, ref pattern: string): ?index
native fun string_rfind(ref self: string, ref pattern: string): ?index

// Trimming (option returns).
native fun string_strip_prefix(ref self: string, ref prefix: string): ?string
native fun string_strip_suffix(ref self: string, ref suffix: string): ?string

// Unicode case conversion.
native fun string_to_lowercase(ref self: string): string
native fun string_to_uppercase(ref self: string): string

// Construction.
native fun string_from_char(ch: u32): string

// Replacement.
native fun string_replacen(ref self: string, ref pattern: string, ref replacement: string, n: index): string

// In-place mutation.
native fun string_push_str(mut self: string, ref other: string)
native fun string_push_char(mut self: string, ch: u32)
native fun string_clear(mut self: string)
native fun string_pop(mut self: string): ?u32
native fun string_truncate(mut self: string, new_len: index)
native fun string_remove(mut self: string, index: index): ?u32
native fun string_insert_char(mut self: string, index: index, ch: u32)
native fun string_insert_str(mut self: string, index: index, ref other: string)

// Character access.
native fun string_char_at(ref self: string, index: index): ?u32
native fun string_char_to_byte_index(ref self: string, index: index): ?index

// Slicing.
native fun string_slice(ref self: string, start: index, end_idx: index): ?string
native fun string_slice_from(ref self: string, start: index): ?string
native fun string_slice_to(ref self: string, end_idx: index): ?string

// Parsing.
native fun string_parse_u32(ref self: string): ?u32
native fun string_parse_i32(ref self: string): ?i32
native fun string_parse_f32(ref self: string): ?f32

// Formatting.
native fun string_from_u32(n: u32): string
native fun string_from_i32(n: i32): string

// Splitting (option-of-tuple).
native fun string_split_once(ref self: string, ref delimiter: string): ?(string, string)
native fun string_rsplit_once(ref self: string, ref delimiter: string): ?(string, string)

// Splitting (list returns).
native fun string_split(ref self: string, ref delimiter: string): [string]
native fun string_lines(ref self: string): [string]
native fun string_split_whitespace(ref self: string): [string]

// Joining.
native fun string_join(ref parts: [string], ref separator: string): string

// Bigint conversion.
native fun string_from_int(ref n: int): string
native fun string_parse_int(ref self: string): ?int

// Lists. Each is generic over the element type: the implementation reads it
// off the list's descriptor, so there is one of each for every element type.
native fun list_len<T>(ref self: [T]): index
native fun list_get<T>(ref self: [T], i: index): ?T
native fun list_push<T>(mut self: [T], elem: T)
native fun list_pop<T>(mut self: [T]): ?T
native fun list_clear<T>(mut self: [T])
native fun list_set<T>(mut self: [T], i: index, elem: T): bool
native fun list_insert<T>(mut self: [T], i: index, elem: T): bool
native fun list_remove<T>(mut self: [T], i: index): ?T
native fun list_reserve<T>(mut self: [T], n: index)

// Maps and sets. Generic over their key, value or element type, which the
// implementation reads off the container's descriptor. A key or element being
// looked up is borrowed, so it arrives as itself.
native fun map_len<K, V>(ref self: %{K = V}): index with { K is ord, }
native fun map_clear<K, V>(mut self: %{K = V}) with { K is ord, }
native fun map_contains_key<K, V>(ref self: %{K = V}, ref key: K): bool with { K is ord, }
native fun map_get<K, V>(ref self: %{K = V}, ref key: K): ?V with { K is ord, }
native fun map_insert<K, V>(mut self: %{K = V}, key: K, value: V) with { K is ord, }
native fun map_remove<K, V>(mut self: %{K = V}, ref key: K) with { K is ord, }
// Reaching an entry by position, which is what gives a map the same reach a
// list has: everything written over a collection here is a loop over `len` and
// an index. The order is the keys' own. Walking a whole map this way is
// quadratic in its length, because a tree has no position to jump to.
native fun map_key_at<K, V>(ref self: %{K = V}, i: index): ?K with { K is ord, }
native fun map_value_at<K, V>(ref self: %{K = V}, i: index): ?V with { K is ord, }

// Tensors. The rank is part of the type rather than a parameter, so these are
// written at rank 1 -- the shape a list-like walk wants. What they need that a
// list does not is the length: a tensor's own is in its shape rather than its
// header, and there is no other way to ask for it.
native fun tensor_len<T>(ref self: [|T, 1|]): index
native fun tensor_rank<T>(ref self: [|T, 1|]): index

native fun set_len<T>(ref self: #{T}): index with { T is ord, }
native fun set_clear<T>(mut self: #{T}) with { T is ord, }
native fun set_contains<T>(ref self: #{T}, ref elem: T): bool with { T is ord, }
native fun set_insert<T>(mut self: #{T}, elem: T): bool with { T is ord, }
native fun set_remove<T>(mut self: #{T}, ref elem: T): bool with { T is ord, }
// Reaching an element by position; see `map_key_at`.
native fun set_get<T>(ref self: #{T}, i: index): ?T with { T is ord, }

// Floating point math, from the platform's libm. These are the operations
// that have no machine instruction behind them, which is why they are here
// rather than among the intrinsics f64 and f32 otherwise call.

native fun f64_sin(self: f64): f64
native fun f64_cos(self: f64): f64
native fun f64_tan(self: f64): f64
native fun f64_asin(self: f64): f64
native fun f64_acos(self: f64): f64
native fun f64_atan(self: f64): f64
native fun f64_atan2(self: f64, other: f64): f64
native fun f64_sinh(self: f64): f64
native fun f64_cosh(self: f64): f64
native fun f64_tanh(self: f64): f64
native fun f64_exp(self: f64): f64
native fun f64_exp2(self: f64): f64
native fun f64_ln(self: f64): f64
native fun f64_log2(self: f64): f64
native fun f64_log10(self: f64): f64
native fun f64_log(self: f64, base: f64): f64
native fun f64_pow(self: f64, exp: f64): f64
native fun f64_cbrt(self: f64): f64
native fun f64_hypot(self: f64, other: f64): f64
native fun f64_rem(self: f64, other: f64): f64

native fun f32_sin(self: f32): f32
native fun f32_cos(self: f32): f32
native fun f32_tan(self: f32): f32
native fun f32_asin(self: f32): f32
native fun f32_acos(self: f32): f32
native fun f32_atan(self: f32): f32
native fun f32_atan2(self: f32, other: f32): f32
native fun f32_sinh(self: f32): f32
native fun f32_cosh(self: f32): f32
native fun f32_tanh(self: f32): f32
native fun f32_exp(self: f32): f32
native fun f32_exp2(self: f32): f32
native fun f32_ln(self: f32): f32
native fun f32_log2(self: f32): f32
native fun f32_log10(self: f32): f32
native fun f32_log(self: f32, base: f32): f32
native fun f32_pow(self: f32, exp: f32): f32
native fun f32_cbrt(self: f32): f32
native fun f32_hypot(self: f32, other: f32): f32
native fun f32_rem(self: f32, other: f32): f32

// Conversion between the integers and the floats. The language does not widen
// between them - see botspec section 10 - so these are named conversions, and
// each says what it cannot represent by returning none.

native fun f64_from_int(ref n: int): ?f64
native fun f32_from_int(ref n: int): ?f32
native fun int_from_f64(x: f64): ?int
native fun int_from_f32(x: f32): ?int

// Conversion from the integers to the widest fixed-width integers. The plain
// forms are none out of range; the low-bits forms wrap to 64 bits. Narrower
// widths are reached from these by the fixed-width modules.

native fun int_to_u64(ref n: int): ?u64
native fun int_to_i64(ref n: int): ?i64
native fun int_low_bits_u64(ref n: int): u64
native fun int_low_bits_i64(ref n: int): i64

// Float formatting and parsing.

native fun string_from_f64(x: f64): string
native fun string_from_f32(x: f32): string
native fun string_parse_f64(ref self: string): ?f64

// One-operand operations on a type parameter bounded to `float`. The
// implementation reads the width off the descriptor, so there is one of each
// for both floats rather than one per width.
native fun float_abs<T>(self: T): T with { T is float, }
native fun float_sqrt<T>(self: T): T with { T is float, }
native fun float_floor<T>(self: T): T with { T is float, }
native fun float_ceil<T>(self: T): T with { T is float, }
native fun float_round<T>(self: T): T with { T is float, }
native fun float_trunc<T>(self: T): T with { T is float, }
native fun float_fract<T>(self: T): T with { T is float, }
native fun float_recip<T>(self: T): T with { T is float, }
native fun float_signum<T>(self: T): T with { T is float, }
native fun float_neg<T>(self: T): T with { T is float, }

// Constants of a type parameter bounded to `fixedint`.
//
// A literal has to be written at some type, and inside a generic the type is
// what nobody has picked yet. These take theirs from the descriptor the call
// site hands over -- the type parameter appears only in the return, so no
// argument brings it and the call site passes one after the out parameter.
// See `botdocs/native-abi.md`.
native fun fixedint_zero<T>(): T with { T is fixedint, }
native fun fixedint_one<T>(): T with { T is fixedint, }
native fun fixedint_min_value<T>(): T with { T is fixedint, }
native fun fixedint_max_value<T>(): T with { T is fixedint, }

// The total order every value has.
//
// A three-way comparison: negative when self sorts before other, zero when
// they sort together, positive when it sorts after. This is the order sets and
// maps keep their keys in, which for floats is IEEE 754-2008 `totalOrder` and
// so differs from `.<` over NaN and signed zero. See `sys/std/ord`.
//
// Takes its operands by value rather than by reference. A borrowed bare `T`
// arrives read through its wrapper, and a value packed into a `data`'s own
// words has no address to lend and no descriptor to hand over -- see
// `botdocs/native-abi.md`. Taken by value it arrives as the wrapper itself,
// which the runtime's comparison unpacks for itself.
native fun ord_compare<T>(self: T, other: T): i8 with { T is ord, }

// Constants of a type parameter bounded to `float`.
//
// The same as the `fixedint_*` constants above and for the same reason: a
// literal has to be written at some type, and inside a generic the type is
// what nobody has picked yet. The type parameter appears only in the return,
// so the call site hands a descriptor over after the out parameter. See
// `botdocs/native-abi.md`.
native fun float_zero<T>(): T with { T is float, }
native fun float_one<T>(): T with { T is float, }
native fun float_nan<T>(): T with { T is float, }
native fun float_infinity<T>(): T with { T is float, }
native fun float_neg_infinity<T>(): T with { T is float, }
native fun float_min_value<T>(): T with { T is float, }
native fun float_max_value<T>(): T with { T is float, }
native fun float_min_positive<T>(): T with { T is float, }
native fun float_epsilon<T>(): T with { T is float, }
native fun float_pi<T>(): T with { T is float, }
native fun float_e<T>(): T with { T is float, }
