default:
    just --list

# Path to datalove CLI.
datalove := "../target/release/datalove"

# The interpreter uv resolves, invoked directly so uv's startup is not timed.
python := `uv python find`

# AOT executables and Java classes are built here, outside the timed runs.
aotdir := "../target/benchvs"
javadir := aotdir / "java"

# Julia, Java and V8 are the ones on PATH. V8 is its own shell, d8, as jsvu
# installs it (`just install-v8`) under the name `v8` in ~/.jsvu/bin, which has
# to be on PATH. It warns on stderr that it runs "an unsupported
# configuration", as V8's test shell does; it runs at V8's full speed.

benches := "fib sum primes wordfreq sieve mandelbrot nbody"

# Build datalove CLI in release mode, AOT-compile every bench, and compile
# the Java ones.
build:
    cargo build -p datalove-cli --release
    mkdir -p {{aotdir}}
    for b in {{benches}}; do {{datalove}} aot-compile --link $b.dfs -o {{aotdir}}/$b; done
    javac -d {{javadir}} *.java

# Install V8's shell, d8, as ~/.jsvu/bin/v8.
install-v8:
    npx --yes jsvu --os=linux64 --engines=v8

# Run all benchmarks.
run: build
    for b in {{benches}}; do just bench-one $b; done

# Run one benchmark by name.
bench name: build
    just bench-one {{name}}

# The JIT twice: compiling every function on its first call, and tiered as
# `--jit` is by default, compiling hot functions and entering hot loops.
#
# At least three runs, rather than hyperfine's ten: the benches are sized so the
# fastest implementations take most of a second, which puts the IR walker at
# ten seconds or more a run.
[private]
bench-one name:
    @echo "=== {{name}} ==="
    hyperfine --warmup 1 --min-runs 3 -N \
        -n 'datalove-interp' '{{datalove}} script {{name}}.dfs' \
        -n 'datalove-jit-t1' '{{datalove}} script --jit --jit-threshold 1 {{name}}.dfs' \
        -n 'datalove-jit' '{{datalove}} script --jit {{name}}.dfs' \
        -n 'datalove-aot' '{{aotdir}}/{{name}}' \
        -n 'python' '{{python}} {{name}}.py' \
        -n 'julia' 'julia --startup-file=no {{name}}.jl' \
        -n 'java' 'java -cp {{javadir}} {{capitalize(name)}}' \
        -n 'v8' 'v8 {{name}}.js'
    @echo ""

# Time every implementation, splitting datalove's into compiling and running,
# and keep the result in ../target/benchvs/history; see record.py.
record *names: build
    PYTHON={{python}} uv run --no-project record.py {{names}}

# Compare two recordings, the latest two by default, flagging what moved.
compare *files:
    uv run --no-project compare.py {{files}}

# Datalove has only `debuglog`, which writes to stderr.
# Print every implementation's output, failing if any disagree.
check: build
    #!/usr/bin/env bash
    set -euo pipefail
    for b in {{benches}}; do
        outs=(
            "$({{datalove}} script $b.dfs 2>&1)"
            "$({{datalove}} script --jit --jit-threshold 1 $b.dfs 2>&1)"
            "$({{datalove}} script --jit $b.dfs 2>&1)"
            "$({{aotdir}}/$b 2>&1)"
            "$({{python}} $b.py)"
            "$(julia --startup-file=no $b.jl)"
            "$(java -cp {{javadir}} ${b^})"
            "$(v8 $b.js 2>/dev/null)"
        )
        echo "$b: ${outs[*]}"
        for o in "${outs[@]}"; do
            [ "$o" = "${outs[0]}" ] || { echo "$b: outputs disagree"; exit 1; }
        done
    done
