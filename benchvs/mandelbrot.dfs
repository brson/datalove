// Mandelbrot benchmark - the Mandelbrot set at 750 by 750, folded into a byte
// checksum, several times over. From Are We Fast Yet
// (github.com/smarr/are-we-fast-yet), whose Mandelbrot at 750 gives 50, and
// before it the Computer Language Benchmarks Game.
//
// Prints the sum of the checksums. Uses wrapping arithmetic intrinsics to avoid
// overflow check overhead.

require module sys/std/f64

const ITERATIONS: u32 = 4
const SIZE: u32 = 750

fun mandelbrot(size: u32): u32
  var sum: u32 = 0
  var byte_acc: u32 = 0
  var bit_num: u32 = 0
  let fsize = f64.from_u32(size)
  var y: u32 = 0
  loop while y .< size
    let ci = (2.0 * f64.from_u32(y) / fsize) - 1.0
    var x: u32 = 0
    loop while x .< size
      var zrzr = 0.0
      var zi = 0.0
      var zizi = 0.0
      let cr = (2.0 * f64.from_u32(x) / fsize) - 1.5
      var z: u32 = 0
      var not_done = true
      var escape: u32 = 0
      loop while not_done and z .< 50
        let zr = zrzr - zizi + cr
        set zi = 2.0 * zr * zi + ci
        set zrzr = zr * zr
        set zizi = zi * zi
        if zrzr + zizi .> 4.0
          set not_done = false
          set escape = 1
        end if
        set z = icall add_wrapping_u32(z, : u32 / 1)
      end loop
      set byte_acc = icall add_wrapping_u32(icall shl_u32(byte_acc, : u32 / 1), escape)
      set bit_num = icall add_wrapping_u32(bit_num, : u32 / 1)
      if bit_num == 8
        set sum = icall bitxor_u32(sum, byte_acc)
        set byte_acc = 0
        set bit_num = 0
      else if x == icall sub_wrapping_u32(size, : u32 / 1)
        set byte_acc = icall shl_u32(byte_acc, icall sub_wrapping_u32(: u32 / 8, bit_num))
        set sum = icall bitxor_u32(sum, byte_acc)
        set byte_acc = 0
        set bit_num = 0
      end if
      set x = icall add_wrapping_u32(x, : u32 / 1)
    end loop
    set y = icall add_wrapping_u32(y, : u32 / 1)
  end loop
  ret sum
end fun

var total: u32 = 0
var n: u32 = 0
loop while n .< ITERATIONS
  set total = icall add_wrapping_u32(total, mandelbrot(SIZE))
  set n = icall add_wrapping_u32(n, : u32 / 1)
end loop
debuglog(total)
