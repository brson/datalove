// Mandelbrot benchmark - the Mandelbrot set at 750 by 750, folded into a byte
// checksum, several times over. From Are We Fast Yet
// (github.com/smarr/are-we-fast-yet), whose Mandelbrot at 750 gives 50, and
// before it the Computer Language Benchmarks Game.
//
// Prints the sum of the checksums. Uses sys/std's wrapping arithmetic to
// avoid overflow checks.

require module sys/std/f64
require module sys/std/u32

const ITERATIONS: u32 = 4
const SIZE: u32 = 750

fun mandelbrot(size: u32): u32
  var sum: u32 = 0
  var byte_acc: u32 = 0
  var bit_num: u32 = 0
  let fsize = f64.from_u32(size)
  var y: u32 = 0
  loop while y .< size
    let ci = (2.0 * f64.from_u32(y) / fsize) - 1.0
    var x: u32 = 0
    loop while x .< size
      var zrzr = 0.0
      var zi = 0.0
      var zizi = 0.0
      let cr = (2.0 * f64.from_u32(x) / fsize) - 1.5
      var z: u32 = 0
      var not_done = true
      var escape: u32 = 0
      loop while not_done and z .< 50
        let zr = zrzr - zizi + cr
        set zi = 2.0 * zr * zi + ci
        set zrzr = zr * zr
        set zizi = zi * zi
        if zrzr + zizi .> 4.0
          set not_done = false
          set escape = 1
        end if
        set z = u32.add_wrapping(z, 1)
      end loop
      set byte_acc = u32.add_wrapping(u32.shift_left_wrapping(byte_acc, 1), escape)
      set bit_num = u32.add_wrapping(bit_num, 1)
      if bit_num == 8
        set sum = u32.bitxor(sum, byte_acc)
        set byte_acc = 0
        set bit_num = 0
      else if x == u32.sub_wrapping(size, 1)
        set byte_acc = u32.shift_left_wrapping(byte_acc, u32.sub_wrapping(8, bit_num))
        set sum = u32.bitxor(sum, byte_acc)
        set byte_acc = 0
        set bit_num = 0
      end if
      set x = u32.add_wrapping(x, 1)
    end loop
    set y = u32.add_wrapping(y, 1)
  end loop
  ret sum
end fun

var total: u32 = 0
var n: u32 = 0
loop while n .< ITERATIONS
  set total = u32.add_wrapping(total, mandelbrot(SIZE))
  set n = u32.add_wrapping(n, 1)
end loop
debuglog(total)
