// Prime counting benchmark - count primes up to 10,000

fun is_prime(n: u32): !bool
  if n .< 2
    ret ok @false
  end if
  if n == 2
    ret ok @true
  end if
  if icall rem_u32(n, 2) == 0
    ret ok @false
  end if
  var d: u32 = 3
  loop while d *! d <= n
    if icall rem_u32(n, d) == 0
      ret ok @false
    end if
    set d = d +! 2
  end loop
  ret ok @true
end fun

fun count_primes(limit: u32): !u32
  var count: u32 = 0
  var n: u32 = 2
  loop while n <= limit
    let prime = is_prime(n)!
    if prime
      set count = count +! 1
    end if
    set n = n +! 1
  end loop
  ret ok count
end fun

let result = count_primes(10000)
if result |value|
  debuglog(value)
else |err|
  debuglog(@false)
end if
