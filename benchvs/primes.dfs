// Prime counting benchmark - count primes up to 4,000,000 by trial division.
// Uses sys/std's wrapping arithmetic to avoid overflow checks.

require module sys/std/u32

fun is_prime(n: u32): bool
  if n .< 2
    ret false
  end if
  if n == 2
    ret true
  end if
  if u32.rem_checked(n, 2) |r|
    if r == 0
      ret false
    end if
  end if
  var d: u32 = 3
  loop while u32.mul_wrapping(d, d) <= n
    if u32.rem_checked(n, d) |r|
      if r == 0
        ret false
      end if
    end if
    set d = u32.add_wrapping(d, 2)
  end loop
  ret true
end fun

fun count_primes(limit: u32): u32
  var count: u32 = 0
  var n: u32 = 2
  loop while n <= limit
    if is_prime(n)
      set count = u32.add_wrapping(count, 1)
    end if
    set n = u32.add_wrapping(n, 1)
  end loop
  ret count
end fun

let result = count_primes(4000000)
debuglog(result)
