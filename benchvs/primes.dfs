// Prime counting benchmark - count primes up to 4,000,000 by trial division.
// Uses wrapping arithmetic intrinsics to avoid overflow check overhead.

fun is_prime(n: u32): bool
  if n .< 2
    ret false
  end if
  if n == 2
    ret true
  end if
  if icall rem_u32(n, : u32 / 2) == 0
    ret false
  end if
  var d: u32 = 3
  loop while icall mul_wrapping_u32(d, d) <= n
    if icall rem_u32(n, d) == 0
      ret false
    end if
    set d = icall add_wrapping_u32(d, : u32 / 2)
  end loop
  ret true
end fun

fun count_primes(limit: u32): u32
  var count: u32 = 0
  var n: u32 = 2
  loop while n <= limit
    if is_prime(n)
      set count = icall add_wrapping_u32(count, : u32 / 1)
    end if
    set n = icall add_wrapping_u32(n, : u32 / 1)
  end loop
  ret count
end fun

let result = count_primes(4000000)
debuglog(result)
