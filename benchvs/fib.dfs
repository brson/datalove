// Fibonacci benchmark - compute fib(32) by naive recursion.
// Uses checked u32 arithmetic, so each call returns a result.

fun fib(n: u32): !u32
  if n .< 2
    ret ok n
  end if
  ret ok (fib(n -! 1)! +! fib(n -! 2)!)
end fun

let result = fib(32)
if result |value|
  debuglog(value)
else |err|
  debuglog(false)
end if
