// Storage benchmark - build a tree of arrays seven levels deep, four children
// to a node, whose leaves are arrays of 1 to 10 empty slots, and count the
// nodes, many times over. From Are We Fast Yet
// (github.com/smarr/are-we-fast-yet), an allocation benchmark whose tree has
// 5461 nodes each time.
//
// The tree is AWFY's array of arrays, `rec T [?T]`. A node is pushed into as
// the list it unfolds to and returned as the tree, with no copy: a recursive
// type and its unfolding meet at the head.
//
// Prints the sum of the counts.

require module sys/std/list
require module sys/std/index
require module sys/std/u32

const ITERATIONS: u32 = 8000

type Tree: rec T [?T]

// AWFY's Random: a 16-bit linear congruential generator.
fun next_random(mut seed: u32): u32
  set seed = u32.bitand(u32.add_wrapping(u32.mul_wrapping(seed, 1309), 13849), 65535)
  ret seed
end fun

// `x % 10`; a remainder by a constant cannot fail, though `rem_checked` does
// not know that.
fun rem10(x: u32): u32
  if u32.rem_checked(x, 10) |r|
    ret r
  end if
  ret 0
end fun

fun build(depth: u32, mut seed: u32, mut count: u32): !Tree
  set count = u32.add_wrapping(count, 1)
  var node: Tree = []
  if depth == 1
    let slots = u32.add_wrapping(rem10(next_random(mut seed)), 1)
    var i: u32 = 0
    loop while i .< slots
      call list.push(mut node, none)
      set i = u32.add_wrapping(i, 1)
    end loop
    ret ok node
  end if
  var i: u32 = 0
  loop while i .< 4
    call list.push(mut node, some build(u32.sub_wrapping(depth, 1), mut seed, mut count)!)
    set i = u32.add_wrapping(i, 1)
  end loop
  ret ok node
end fun

fun benchmark(): !u32
  var seed: u32 = 74755
  var count: u32 = 0
  let tree = build(7, mut seed, mut count)!
  ret ok count
end fun

fun run(): !u32
  var total: u32 = 0
  var n: u32 = 0
  loop while n .< ITERATIONS
    set total = u32.add_wrapping(total, benchmark()!)
    set n = u32.add_wrapping(n, 1)
  end loop
  ret ok total
end fun

let result = run()
if result |value|
  debuglog(value)
else |err|
  debuglog(false)
end if
