// Sum benchmark - sum integers from 1 to 1,000,000

fun sum_to(limit: u32): !int
  var total: int = 0
  var i: u32 = 1
  loop while i <= limit
    set total = total + (i + 0)
    set i = i +! 1
  end loop
  ret ok total
end fun

let result = sum_to(1000000)
if result |value|
  debuglog(value)
else |err|
  debuglog(false)
end if
