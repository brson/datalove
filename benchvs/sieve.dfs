// Sieve benchmark - count the primes up to 5000 with a sieve of Eratosthenes,
// many times over. From Are We Fast Yet (github.com/smarr/are-we-fast-yet),
// whose Sieve counts 669 each time.
//
// Prints the sum of the counts. Uses sys/std's wrapping arithmetic to avoid
// overflow checks.

require module sys/std/list
require module sys/std/index
require module sys/std/u32

const ITERATIONS: u32 = 10000
const SIZE: index = 5000

fun sieve(mut flags: [bool], size: index): !u32
  var prime_count: u32 = 0
  var i: index = 2
  loop while i <= size
    if flags[index.sub_wrapping(i, 1)]!
      set prime_count = u32.add_wrapping(prime_count, 1)
      var k = index.add_wrapping(i, i)
      loop while k <= size
        set flags[index.sub_wrapping(k, 1)]! = false
        set k = index.add_wrapping(k, i)
      end loop
    end if
    set i = index.add_wrapping(i, 1)
  end loop
  ret ok prime_count
end fun

fun benchmark(): !u32
  var flags = list.repeated(ref true, SIZE)
  ret sieve(mut flags, SIZE)
end fun

fun run(): !u32
  var total: u32 = 0
  var n: u32 = 0
  loop while n .< ITERATIONS
    set total = u32.add_wrapping(total, benchmark()!)
    set n = u32.add_wrapping(n, 1)
  end loop
  ret ok total
end fun

let result = run()
if result |value|
  debuglog(value)
else |err|
  debuglog(false)
end if
