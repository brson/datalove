// Learn Datalove in Y Minutes
//
// Datalove is a typed scripting language with a three-layer tower:
// - Datalit (.dlt) - Pure data literal language
// - Datafun (.dfs script, .dfm module) - Pure functional layer
// - Full Datalove (.dls, .dlm) - Procedures and objects [not yet implemented]
//
// This script covers the Datafun layer.


// =========================================================================
// 1. PRIMITIVE TYPES AND LITERALS
// =========================================================================

// Boolean.
let b1: bool = @true
let b2: bool = @false

// Unsigned integers: u8, u16, u32, u64.
let small: u8 = 255
let medium: u32 = 42

// Signed integers: i8, i16, i32, i64.
let signed: i32 = -100

// Arbitrary precision integer (bigint).
let big: int = 999999999999999999999

// 32-bit float.
let pi: f32 = 3.14159

// Strings.
let greeting: string = "hello, datalove"

// Heap annotations: @ = local heap, # = global heap. Usually omitted.
let explicit_local: @u32 = @42
let explicit_global: #u32 = #42
let inferred: u32 = 42        // heap inferred

// Type hints use `: type / expr` syntax.
let hinted = : u32 / 99

// Hex literals work for integers and f32 (bit pattern).
let hex_int: u32 = 0xFF             // 255
let hex_float = : f32 / 0x40490FDB  // pi as bit pattern (needs type hint)


// =========================================================================
// 2. VARIABLES: LET, VAR, SET
// =========================================================================

// `let` creates an immutable binding.
let immutable: u32 = 10

// `var` creates a mutable slot.
var counter: u32 = 0

// `set` mutates a var.
set counter = 1


// =========================================================================
// 3. COLLECTION TYPES
// =========================================================================

// Lists use [@T] type and [a, b, c] syntax.
let numbers: [u32] = [1, 2, 3, 4, 5]
let empty_list: [u32] = []

// Maps use @map<K, V> type and @map { k1 = v1, k2 = v2 } syntax.
let scores: @map<string, u32> = @map { "alice" = 100, "bob" = 85 }
let empty_map: @map<u32, u32> = @map {}

// Sets use @set<T> type and @set { v1, v2, v3 } syntax.
let unique: @set<u32> = @set { 1, 2, 3 }
let empty_set: @set<u32> = @set {}


// =========================================================================
// 4. AGGREGATE TYPES
// =========================================================================

// Tuples.
let pair: (u32, bool) = (42, @true)
let triple: (u32, u32, u32) = (1, 2, 3)
let unit: () = ()

// Anonymous structs.
let point: { x: u32, y: u32 } = { x = 10, y = 20 }

// Anonymous enums.
let color: @enum { Red, Green, Blue } = @enum Red
let maybe: @enum { None, Some(u32) } = @enum Some(42)


// =========================================================================
// 5. OPTION AND RESULT TYPES
// =========================================================================

// Option type: ?T holds a value or @none.
let found: ?u32 = some 42
let missing: ?u32 = @none

// Result type: !T holds a value or @error.
// ok wraps value, er wraps error. @error constructs the error value.
let success: !u32 = ok 42
let failure: !u32 = er @error "something went wrong"


// =========================================================================
// 6. THE DATA TYPE
// =========================================================================

// @data can hold any value (type-erased).
let anything: @data = @data 42
let also_data: @data = @data "hello"


// =========================================================================
// 7. FUNCTIONS
// =========================================================================

// Basic function definition.
// Note: bare + widens to int, so we return int here.
fun add(a: u32, b: u32): int
  ret a + b
end fun

// Use checked ops (+!) to stay in the fixed integer type.
fun add_u32(a: u32, b: u32): !u32
  ret ok (a +! b)
end fun

// Void function (no return type, no ret required).
fun do_nothing()
end fun

// Early return in void function.
fun maybe_early(n: u32)
  if n .< 10
    ret
  end if
end fun

// Functions returning options.
fun safe_divide(a: u32, b: u32): ?u32
  if b == 0
    ret @none
  else
    ret some (a /? b)
  end if
end fun

// Functions returning results.
fun checked_add(a: u32, b: u32): !u32
  ret ok (a +! b)
end fun


// =========================================================================
// 8. PARAMETER MODES
// =========================================================================

// All parameters passed by reference. The mode controls allowed operations:

// `in` (default): Read and consume; ownership transfers to callee.
fun consume_value(value: u32): u32
  ret value
end fun

// `ref`: Read only; caller retains ownership.
fun read_only(ref value: u32): !u32
  ret ok (value +! 1)
end fun

// `mut`: Read and write via set; caller retains ownership.
fun increment(mut value: u32): !u32
  set value = value +! 1
  ret ok value
end fun

// `out`: Write only; callee must initialize before return.
fun init_value(out value: u32)
  set value = 42
end fun


// =========================================================================
// 9. OPERATORS
// =========================================================================

// Arithmetic: + - * (bare ops widen fixed ints to int).
let sum: int = 1 + 2     // Result is int
let product: int = 3 * 4 // Result is int

// Checked arithmetic (!): stays in fixed-width type, errors on overflow.
fun checked_example(a: u32, b: u32): !u32
  let result = a +! b  // Early-returns @error on overflow
  ret ok result
end fun

// Optional arithmetic (?): stays in fixed-width type, @none on overflow.
fun optional_example(a: u32, b: u32): ?u32
  let result = a +? b  // Early-returns @none on overflow
  ret some result
end fun

// Division requires checked variants (div by zero possible).
// int:  /! returns !int, /? returns ?int
// fixed: /! returns !T, /? returns ?T

// Comparison: .< .> <= >= == !=
// Note: < and > written as .< and .> (dot prefix).
let less = 1 .< 2
let greater = 5 .> 3
let less_eq = 1 <= 1
let greater_eq = 5 >= 4
let equal = 2 == 2
let not_equal = 1 != 2

// Logical: and or xor not
let both = @true and @false     // @false
let either = @true or @false    // @true
let exclusive = @true xor @true // @false
let negated = not @true         // @false


// =========================================================================
// 10. CONTROL FLOW
// =========================================================================

// If/else.
fun classify(n: u32): string
  if n == 0
    ret "zero"
  else
    if n .< 10
      ret "small"
    else
      ret "large"
    end if
  end if
end fun

// If with binding: destructure option/result.
fun unwrap_or_default(opt: ?u32): u32
  if opt |value|
    ret value
  else
    ret 0
  end if
end fun

// Basic loop with break.
fun count_to(limit: u32): !u32
  var n: u32 = 0
  loop
    set n = n +! 1
    if n >= limit
      break
    end if
  end loop
  ret ok n
end fun

// Loop while.
fun sum_to(limit: u32): !u32
  var total: u32 = 0
  var i: u32 = 1
  loop while i <= limit
    set total = total +! i
    set i = i +! 1
  end loop
  ret ok total
end fun

// Continue skips to next iteration.
fun count_odds(limit: u32): !u32
  var count: u32 = 0
  var i: u32 = 0
  loop while i .< limit
    set i = i +! 1
    if icall rem_u32(i, 2) == 0
      continue
    end if
    set count = count +! 1
  end loop
  ret ok count
end fun


// =========================================================================
// 11. TRY OPERATORS
// =========================================================================

// Postfix ? early-returns @none on none.
fun chain_options(a: ?u32, b: ?u32): ?u32
  let x = a?  // If a is @none, function returns @none
  let y = b?
  ret some (x +? y)
end fun

// Postfix ! early-returns @error on error.
fun chain_results(a: !u32, b: !u32): !u32
  let x = a!  // If a is @error, function returns that error
  let y = b!
  ret ok (x +! y)
end fun


// =========================================================================
// 12. MODULE SYSTEM
// =========================================================================

// Import modules from sys/std library.
require module sys/std/u32

// Import specific functions.
import u32.max_value
import u32.add_saturating

// Use imported functions.
fun use_stdlib(): u32
  let max = max_value()
  let result = add_saturating(max, 1)  // Saturates at max
  ret result
end fun


// =========================================================================
// 13. INTRINSIC CALLS
// =========================================================================

// Low-level operations via icall.
fun bitwise_example(a: u32, b: u32): u32
  let anded = icall bitand_u32(a, b)
  let ored = icall bitor_u32(a, b)
  let shifted = icall shl_u32(a, 2)
  ret shifted
end fun


// =========================================================================
// 14. TYPE ALIASES
// =========================================================================

// Type aliases provide names for structural types.
type Age: u32
type Point: { x: f32, y: f32 }
type MaybeInt: ?int
type IntResult: !int

// Use aliases in function signatures.
fun make_point(x: f32, y: f32): Point
  ret { x = x, y = y }
end fun

fun get_age(): Age
  ret 25
end fun

// Aliases can reference other aliases (if defined earlier).
type PointList: [Point]

// Restrictions:
// - Must be defined before use (no forward references).
// - Cannot shadow primitive types (bool, u32, int, string, etc.).
// - Purely syntactic: no runtime difference from the structural type.


// =========================================================================
// 15. TYPE SYSTEM NOTES
// =========================================================================

// Numeric widening: smaller types widen to larger.
// u8 -> u16 -> u32 -> u64 -> int
// i8 -> i16 -> i32 -> i64 -> int

// Copy types (can be freely duplicated):
//   bool, u8-u64, i8-i64, f32

// Linear types (move semantics):
//   int, string, list, map, set, table, data, error

// Binary operators borrow operands (don't consume).
fun can_reuse(x: int): int
  let a = x + x    // x cloned for operation
  let b = x + x    // x still valid
  ret x            // x can be returned
end fun


// =========================================================================
// 16. PUTTING IT ALL TOGETHER
// =========================================================================

// Example: Fibonacci with checked arithmetic.
fun fib(n: u32): !u32
  if n .< 2
    ret ok n
  end if
  var a: u32 = 0
  var b: u32 = 1
  var i: u32 = 2
  loop while i <= n
    let next = a +! b
    set a = b
    set b = next
    set i = i +! 1
  end loop
  ret ok b
end fun


// =========================================================================
// SCRIPT OUTPUT
// =========================================================================

// Script final expression is the output.
let output = fib(10)
