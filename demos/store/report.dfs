// The store's report: generate the data with `uv run gen.py`, then run this
// with `datalove script report.dfs`.

require module sys/std/list
require module local/store/report

let lines = report.lines()!
var i: index = 0
loop while i .< list.len(ref lines)
    debuglog lines[i]!
    set i = i +! 1
end loop
