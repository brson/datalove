; # Datalove Script example

require module std
; include a dl expression file
require data lookup_tables

; type hints?
require module std : module { }
require data lookup_tables : { x: #u32, y: #bool }

let foo = : #u32 / 8

fun increment(
  accum: u64, amount: u8,
) !u64
  accum +! amount
end fun

proc print(msg: @string)
  std.io.print("hello {msg}")
end proc

print("whats up")


; ## Non plain-data types



; ## About the heap

; every type includes a possibly-implicit heap type,
; either local, global, none (`@ % #`)
;
; data types that contain allocations:
;
; list, string, map, set, data, error, option, result

let local: @set<@data> = @set { 1, "2", 3.0 }
let global: %set<%data> = %set { 1, "2", 3.0 }

let none: #struct Foo { } = #struct Foo { }

; clone is a deep copy across heaps
let globalized = std.clone(local)
; with type anotations
let globalized: %set<%data> = std.clone(: @set<@data> / local)

; they can not be intermixed:
;
;     let bogus: @set<%data> = ...

; ### Heap idea - stack-oriented arenas

var results: @vec<u32> = @[]

arena
  ; now `@` is a new arena, `@^` is previous

  var buffer: @vec<u32> = @[1, 2, 3]
  ; ... do work here ...
  ; `clone` does a deep copy, possibly between heaps
  let results_clone: @^vec<u32> = clone buffer
  results = results_clone

end arena




; ## Math and logic

; bigints can use overflowing math
let i = (1 + 2) - 3 * 4 / 5
; sized ints can't - the ! here indicates early-error-return
let i: @u32 = (1 +! 2) -! 3 *! 4 /! 5
; or doubl sigils for checked (assert/abort) math
let i: @u32 = (1 ++ 2) -- 3 ** 4 // 5

; compound assignment
var i = 0
set i += 1;

; math types - worth having?
let i = 1 +% 1 ; wrapping (from zig)
let i = 1 +| 1 ; saturating (from zig)

; numeric types expand when using overflowing math
let a /* : @u16 */ = 1 + 2
let b /* : @u32 */ = a + a;
let c /* : @u64 */ = b + b;
let d /* : @u128 */ = c + c;
let e : @int = d + d;

; logic and comparison uses words

let a = 1 lt 2 and 2 gt 3 or not 4 lte
let a = a or a eq 10 or a ne 1



; ## Control flow

if a {
} else {
}

let x = if a {
} else {
}



; ## Introspection

let ty: @type = @type @vec<u32>


