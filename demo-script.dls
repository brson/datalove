; # Datalove Script example


; ## Imports

; The compiler wants to see all source code up front.
;
; `require` statements tell the compiler what else a module
; needs from the rest of the source code world.

; module linkage is explicit
require module std

; include a datalove expression file
require data lookup_tables

; require statements bring a name into scope.
; modules are first-class types.
; type hints?
require module std : module { }
require data lookup_tables : { x: #u32, y: #bool }


; ## Functions and procedures

; Functions operate on pure data
; and are comptime-compatible; only
; call other funs.
fun increment(
  accum: u64, amount: u8,
) !u64
  accum +! amount
end fun

; Procedures operate on types including
; native pointers, may do I/O, and may call
; funs and procs.
proc print_hello(msg: @string)
  std.io.print("hello {msg}")
end proc

; Argument modes, yup they're back.
;
fun demo(
    ; `in` (implicit), by-val
    a: u32,
    ; `out`, by-mut-ptr _to uninitialized local_.
    ; like mercury `uo`, "unique output".
    ; not clear yet if we need the uninitialized requirement.
    b: out u32,
    ; `ref`, by-ref, like mercury `ui` "unique input"?
    c: ref u32,
    ; `mut`, by-mut-ref, like mercury `di` "destructive input"?
    c: mut u32,
)
end fun


; ## Non plain-data types



; ## About the heap

; Every type includes a possibly-implicit heap type,
; either local (`@`), global (`#`), infer (no sigil)
;
; Data types that contain allocations:
; list, string, map, set, data, error, option, result.
;
; some types require heap sigils to limit keywords in the grammar:
; @map, @set, etc.

let local: @set<@data> = @set { 1, "2", 3.0 }
let global: #set<#data> = #set { 1, "2", 3.0 }

let none: #struct Foo { } = #struct Foo { }

; clone can deep copy across heaps
let globalized: #set<_> = std.clone(local)

; they can not be intermixed:
;
;     let bogus: @set<#data> = ...




; ## Math and logic

; bigints can use overflowing math
let i = (1 + 2) - 3 * 4 / 5
; sized ints can't - the ! here indicates early-error-return
let i: @u32 = (1 +! 2) -! 3 *! 4 /! 5
; or doubl sigils for checked (assert/panic) math
let i: @u32 = (1 ++ 2) -- 3 ** 4 // 5

; compound assignment
var i = 0
set i += 1;

; overflow ops - worth having?
let i = 1 +% 1 ; wrapping (from zig)
let i = 1 +| 1 ; saturating (from zig)

; numeric types expand when using overflowing math
let a /* : @u16 */ = 1 + 2
let b /* : @u32 */ = a + a;
let c /* : @u64 */ = b + b;
let d /* : @u128 */ = c + c;
let e : @int = d + d;

; logic uses words

let a = 1 and 3 or not 4 lte 5 and 4 xor 6 implies 7

; ^ note the `implies` operator

; comparison uses sigils
;
; note lt and gt have unfortunate spellings
let a = b .< d and c .> d
let a = b <= d and c >= d
let a = b == d and c != d

; ## Basic control flow

if a {
} else if {
} else {
}

let x = if a {
} else {
}

loop {
  break
  continue
}




; ## Match expressions

; ## Optional types


; ## Introspection

let ty: @type = @type @vec<u32>


; ## Dynamic-feel features

; lightweight anonymous enum decls
fun print(val: @u32 | @string)
  match val {
    @enum u32(i) => {}
    @enum string(s) => {}
  }
end fun

; the full spelling
fun print(val: @enum {
  U32(@u32),
  String(@string),
})
  match val {
    @enum U32(i) => {}
    @enum String(s) => {}
  }
end fun
