// A module's consts are evaluated as it is compiled. One that overflows the
// stack and one in a function that returns early are each an error at their
// initializer; a function naming the first, and a const naming it, say
// nothing more.
----------
module local/test/main
----------

fun down(n: u32): u32
  ret down(n)
end fun

const D: u32 = down(1)
const E: u32 = D

fun uses_d(): u32
  ret D
end fun

fun ratio(a: u32, b: u32): !u32
  ret ok (a /! b)
end fun

fun f(): !u32
  const R: u32 = ratio(1, 0)!
  ret ok R
end fun

