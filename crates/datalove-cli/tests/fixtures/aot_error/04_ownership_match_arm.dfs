// One arm of a `match` gives a binding away and another does not. The error
// names the arms and points at the move.
type Shape: enum { atom Circle, atom Square }

fun pick(shape: Shape, s: string): string
  match shape
  case atom Circle
    let taken = s
    debuglog taken
  case atom Square
    debuglog "square"
  end match
  ret "other"
end fun

let circle: Shape = atom Circle
let output = pick(circle, "a")
