// D006 names every way out that leaves an out parameter unwritten: here a
// `ret` before the `set`, and the end of the body, which a false `flag` runs
// to.
fun pick(flag: bool, out s: string)
  if flag
    ret
  end if
  if flag
    set s = "written"
  end if
end fun

var x: string
call pick(true, out x)
