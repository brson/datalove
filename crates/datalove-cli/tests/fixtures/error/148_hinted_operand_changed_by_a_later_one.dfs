// A type hint changes nothing about how its operand is read: a hinted
// variable is still read through a reference by the index, like an unhinted
// one, so its key may not change it (O017).

fun grow(mut xs: [int]): index
  set xs = [5, 6, 7]
  ret : index / 0
end fun

var xs: [int] = [1, 2]
debuglog (: [int] / xs)[grow(mut xs)]!
