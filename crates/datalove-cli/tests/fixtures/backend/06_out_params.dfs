// An out parameter's destination holds something before the call, and the
// callee does not destroy it: its tracking byte starts uninitialized, so its
// first store destroys nothing. The caller clears it, which the interpreter
// always did and the compiled backends did not. With a copy type nothing is
// lost either way, so this needs a move type to say anything.
//
// Forwarding one is here too. The interpreter used to panic on it, generic or
// not, because a parameter was not a shape it accepted as a destination.
//
// A destination that has never been written is the other half. There is
// nothing there to clear, and clearing it anyway freed cranelift's 0xFF poison
// and whatever the C stack had left; and the call has to record that it wrote
// the place, or the drop at the end of the scope skips what it put there. Both
// need a move type and a `var` with no initializer to say anything.

fun take_out<T>(out x: T, src: T)
  set x = src
end fun

fun forward_out<T>(out x: T, src: T)
  call take_out(out x, src)
end fun

var word: string = "before"
call take_out(out word, "after")
debuglog word

var forwarded: string = "before"
call forward_out(out forwarded, "after")
debuglog forwarded

// Into a field rather than a whole binding, which is the other place an out
// parameter is allowed to point.
var pair = ("a", "b")
call take_out(out pair.1, "z")
debuglog pair

var counter: u32 = 0
call forward_out(out counter, 42)
debuglog counter

// A destination that holds nothing yet, through a concrete function.
fun take_out_string(out x: string, src: string)
  set x = src
end fun

var fresh: string
call take_out_string(out fresh, "written")
debuglog fresh

// One never read, so the drop at the end of the unit is the only thing that
// frees what the call wrote, and it asks the tracking byte the call has to set.
var unread: string
call take_out_string(out unread, "dropped")

// Forwarded through a second out parameter, still starting from nothing.
fun forward_out_string(out x: string, src: string)
  call take_out_string(out x, src)
end fun

var fresh_forwarded: string
call forward_out_string(out fresh_forwarded, "relayed")
debuglog fresh_forwarded

// And through a generic, which is the harder half: a generic erases its
// arguments on the way in, and the destination is erased along with them so
// that the call destroys what was there. A destination holding nothing has
// nothing to erase, and reading it anyway read the frame's own poison.
var generic_fresh: string
call take_out(out generic_fresh, "erased")
debuglog generic_fresh

var generic_unread: string
call take_out(out generic_unread, "erased and dropped")

var generic_forwarded: string
call forward_out(out generic_forwarded, "erased and relayed")
debuglog generic_forwarded

// A copy type through the same path, where the erased shape is packed into
// the wrapper's own words rather than pointed at.
var generic_narrow: u32
call take_out(out generic_narrow, 7)
debuglog generic_narrow
