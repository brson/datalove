// A recursive enum built up from parts through the library, as a parser
// builds a tree: elements pushed onto a list, then wrapped.

require module sys/std/list
require module sys/std/map

type Json: rec J enum { atom Null, term Num f64, term Arr [J], term Obj %{string = J} }

fun numbers(n: u32): Json
  var items: [Json] = []
  var i: u32 = 0
  loop while i .< n
    call list.push(mut items, term Num 1.5)
    set i = icall add_wrapping_u32(i, 1)
  end loop
  ret term Arr items
end fun

fun count(j: Json): int
  match j
  case term Arr items
    var total: int = 1
    for item in ref items
      set total = total + count(item@)
    end for
    ret total
  case term Obj fields
    var total: int = 1
    for key, value in ref fields
      set total = total + count(value@)
    end for
    ret total
  case default
    ret 1
  end match
end fun

var fields: %{string = Json} = %{}
set fields["a"] = numbers(3)
set fields["b"] = atom Null
let doc: Json = term Obj fields
debuglog doc
debuglog count(doc@)
