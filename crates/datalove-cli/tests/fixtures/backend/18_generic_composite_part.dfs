// Reading and writing a part of a borrowed generic value whose type is a
// composite holding a type parameter.
//
// The part is a dynamic value: `{a: T, b: u32}` has the size, alignment and
// field offsets of what `T` is bound to, all read from the descriptor. A read
// clones the part out of something borrowed, leaving it where it is, and a
// write replaces it at the descriptor's width.
//
// These were once refused outright in the compiled backends and gave silent
// garbage across a call boundary.

fun take<T>(ref x: T): ?T
  ret some (x@)
end fun

// Read a whole sub-aggregate that itself holds the type parameter.
fun get_q<T>(ref p: {q: {a: T, b: u32}, c: u32}): {a: T, b: u32}
  ret p.q@
end fun

// Write one.
fun set_q<T>(mut p: {q: {a: T, b: u32}, c: u32}, v: {a: T, b: u32})
  set p.q = v
end fun

// The same read reached across a call boundary instead: `take` is handed the
// descriptor of what is really there, and its result lands in the caller's
// own dynamic value.
fun via_call<T>(ref p: {q: {a: T, b: u32}, c: u32}): ?{a: T, b: u32}
  ret take(ref p.q)
end fun

// And reached through a borrowed list element rather than a field.
fun via_element<T>(ref xs: [{a: T, b: u32}], i: index): ?{a: T, b: u32}
  ret take(ref xs[i]?)
end fun

// A tuple rather than a struct, and one with the generic position last.
fun get_pair<T>(ref p: {q: (u32, T), c: u32}): (u32, T)
  ret p.q@
end fun

// An option of a composite, so the walk goes through a discriminant.
fun get_opt<T>(ref p: {q: ?{a: T, b: u32}, c: u32}): ?{a: T, b: u32}
  ret p.q@
end fun

let s: {q: {a: u8, b: u32}, c: u32} = {q = {a = 1, b = 7}, c = 5}
let got = get_q(ref s)
debuglog got
debuglog via_call(ref s)

var m: {q: {a: u8, b: u32}, c: u32} = {q = {a = 1, b = 7}, c = 5}
call set_q(mut m, {a = 2, b = 9})
debuglog m

let xs: [{a: u8, b: u32}] = [{a = 1, b = 7}, {a = 2, b = 9}]
debuglog via_element(ref xs, 1)

// A string in the generic position, so the read has something to clone
// rather than bytes to copy.
let owned: {q: {a: string, b: u32}, c: u32} = {q = {a = "alpha", b = 7}, c = 5}
debuglog get_q(ref owned)
debuglog via_call(ref owned)

let pair: {q: (u32, u8), c: u32} = {q = (7, 1), c = 5}
debuglog get_pair(ref pair)

let opt: {q: ?{a: u8, b: u32}, c: u32} = {q = some {a = 1, b = 7}, c = 5}
debuglog get_opt(ref opt)

let empty: {q: ?{a: u8, b: u32}, c: u32} = {q = none, c = 5}
debuglog get_opt(ref empty)
