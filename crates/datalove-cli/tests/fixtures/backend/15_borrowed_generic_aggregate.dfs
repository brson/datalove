// Reading and writing a part of an aggregate borrowed inside a generic.
//
// The callee's static type for the parameter is `{a: T, b: u32}`, whose layout
// depends on what `T` is bound to: every field after `a` sits at an offset only
// the descriptor knows. So the offset comes from the descriptor the call site
// supplied, and a projection narrows that descriptor alongside the pointer so a
// chain and a read through the end of one each know what is really there.
//
// Every case here was once wrong, and wrong differently in each backend: the
// reads returned garbage that varied run to run, and the write through `mut`
// put the value past the end of what the caller owns, which corrupted the heap
// under the jit and smashed the stack under the C backend.

fun second<T>(ref p: {a: T, b: u32}): u32
  ret p.b
end fun

fun tuple_second<T>(ref p: (T, u32)): u32
  ret p.1
end fun

// The generic field itself, copied out at the width its descriptor says: what
// is really there is a `u8`, a `u16` or a string.
fun generic_field<T>(ref p: {a: T, b: u32}): T
  ret p.a@
end fun

// A chain. The intermediate is never copied out: both steps are borrows and
// only the last field is read.
fun nested<T>(ref p: {q: {a: T, b: u32}, c: u32}): u32
  ret p.q.b
end fun

// Handing a projection on to something that borrows it. The descriptor travels
// with it, so the callee is told what it really has.
fun through(ref n: u32): u32
  ret n@
end fun

fun onward<T>(ref p: {a: T, b: u32}): u32
  ret through(ref p.b)
end fun

// Writing. The severe half: a wrong offset here is a write past the value.
fun bump<T>(mut p: {a: T, b: u32})
  set p.b = 99
end fun

// A field before the generic one is at the same offset whatever `T` is, and a
// `[T]` field is the same width whatever its element. Both are here to stay
// right.
fun generic_last<T>(ref p: {b: u32, a: T}): u32
  ret p.b
end fun

fun container_field<T>(ref p: {a: [T], b: u32}): u32
  ret p.b
end fun

let s: {a: u8, b: u32} = {a = 1, b = 7}
debuglog second(ref s)
debuglog generic_field(ref s)
debuglog onward(ref s)

let wide: {a: u16, b: u32} = {a = 300, b = 7}
debuglog generic_field(ref wide)

let t: (u8, u32) = (1, 7)
debuglog tuple_second(ref t)

let deep: {q: {a: u8, b: u32}, c: u32} = {q = {a = 1, b = 7}, c = 5}
debuglog nested(ref deep)

var m: {a: u8, b: u32} = {a = 1, b = 7}
call bump(mut m)
debuglog m.b

let last: {b: u32, a: u8} = {b = 7, a = 1}
debuglog generic_last(ref last)

let held: {a: [u8], b: u32} = {a = [1, 2], b = 7}
debuglog container_field(ref held)

// A string element makes the generic field one that owns memory, so reading
// it out is a clone rather than a copy of its bytes.
let owned: {a: string, b: u32} = {a = "alpha", b = 7}
debuglog second(ref owned)
debuglog generic_field(ref owned)
