// Indexing a container a generic function owns.
//
// An owned container of a type parameter is the one thing erasure does not
// walk: `erased_param_type` wraps `[T]` whole into a `data`, because converting
// it to `[data]` would mean rebuilding the elements at a different stride. So
// inside the callee the value is a wrapper, and `ListGet` was emitted straight
// at it. Both AOT backends refused outright ("ListGet on non-list type: Data"),
// the jit turned that into a panic, and the interpreter read the anypack's
// bytes as a list header and segfaulted.
//
// `DataBorrow` opens the wrapper: the pointer and the descriptor come out
// together, and the reference it makes carries the descriptor on, which is what
// every index into a borrowed container already reads. So nothing here needed a
// new way of indexing, only a way of getting at the container.
//
// Knowing there *is* a container to open is the awkward half. `from_datalit`
// collapses a container of a type parameter to `data` everywhere -- parameter,
// local and call result alike -- so the IR type says nothing about being a
// list, and a place like `xs[0]` has no expression node for its root to ask the
// typechecker about. The shape is recorded where the binding is made instead;
// see `LowerBody::wrapped_shapes`.

fun take<T>(ref x: T): ?T
  ret some (x@)
end fun

// An owned list, indexed directly.
fun first<T>(xs: [T]): ?T
  ret some (xs[0]?@)
end fun

fun at<T>(xs: [T], i: index): ?T
  ret some (xs[i]?@)
end fun

// Moved into a local first, which is a wrapper too.
fun via_local<T>(xs: [T]): ?T
  var local: [T] = xs
  ret some (local[0]?@)
end fun

// A borrow taken out of an owned container, so the element's descriptor is
// narrowed from the one the wrapper carried.
fun borrow_first<T>(xs: [T]): ?T
  ret take(ref xs[0]?)
end fun

fun map_at<K, V>(m: %{K = V}, k: K): ?V with { K is ord, }
  ret some (m[k]?@)
end fun

fun tensor_at<T>(t: [|T, 1|], i: index): ?T
  ret some (t[i]?@)
end fun

// Out of bounds still says so rather than reading past the end.
fun beyond<T>(xs: [T]): ?T
  ret some (xs[: index / 9]?@)
end fun

// The parameter is owned, so each call is handed a clone of its own.
let words: [string] = ["alpha", "beta", "gamma"]
debuglog first(words@)
debuglog at(words@, 2)
debuglog via_local(words@)
debuglog borrow_first(words@)
debuglog beyond(words@)

// A one byte element, where a `data`'s stride would be sixteen times too far.
let ns: [u8] = [1, 2, 3]
debuglog first(ns@)
debuglog at(ns@, 1)

let m: %{string = string} = %{"a" = "alpha", "b" = "beta"}
debuglog map_at(m@, "b")
debuglog map_at(m@, "z")

let t: [|u32, 1|] = [| 10 20 30 |]
debuglog tensor_at(t@, 1)

// A concrete caller, which was always fine: nothing is wrapped there, so the
// index is the same code it always was.
fun concrete_first(xs: [string]): ?string
  ret some (xs[0]?@)
end fun

debuglog concrete_first(["delta", "epsilon"])
