// Indexing a container a generic function owns.
//
// An owned container of a type parameter is a dynamic value like any other
// `T`-dependent one: the container itself is a fixed-size header, and the
// element stride comes from the descriptor the call site supplied. Indexing it
// is the same as indexing a borrowed one, and the element read out carries the
// element's descriptor on.
//
// This once went wrong in every backend: both AOT backends refused it, the jit
// turned that into a panic, and the interpreter read the wrong bytes as a list
// header and segfaulted.

fun take<T>(ref x: T): ?T
  ret some (x@)
end fun

// An owned list, indexed directly.
fun first<T>(xs: [T]): ?T
  ret some (xs[0]?@)
end fun

fun at<T>(xs: [T], i: index): ?T
  ret some (xs[i]?@)
end fun

// Moved into a local first, which is dynamic too.
fun via_local<T>(xs: [T]): ?T
  var local: [T] = xs
  ret some (local[0]?@)
end fun

// A borrow taken out of an owned container, so the element's descriptor is
// narrowed from the container's.
fun borrow_first<T>(xs: [T]): ?T
  ret take(ref xs[0]?)
end fun

fun map_at<K, V>(m: %{K = V}, k: K): ?V with { K is ord, }
  ret some (m[k]?@)
end fun

fun tensor_at<T>(t: [|T, 1|], i: index): ?T
  ret some (t[i]?@)
end fun

// Out of bounds still says so rather than reading past the end.
fun beyond<T>(xs: [T]): ?T
  ret some (xs[: index / 9]?@)
end fun

// The parameter is owned, so each call is handed a clone of its own.
let words: [string] = ["alpha", "beta", "gamma"]
debuglog first(words@)
debuglog at(words@, 2)
debuglog via_local(words@)
debuglog borrow_first(words@)
debuglog beyond(words@)

// A one byte element, where any stride but the descriptor's is too far.
let ns: [u8] = [1, 2, 3]
debuglog first(ns@)
debuglog at(ns@, 1)

let m: %{string = string} = %{"a" = "alpha", "b" = "beta"}
debuglog map_at(m@, "b")
debuglog map_at(m@, "z")

let t: [|u32, 1|] = [| 10 20 30 |]
debuglog tensor_at(t@, 1)

// A concrete caller, which was always fine: nothing is dynamic there, so the
// index is the same code it always was.
fun concrete_first(xs: [string]): ?string
  ret some (xs[0]?@)
end fun

debuglog concrete_first(["delta", "epsilon"])
