// Index into list of lists, read inner list.
fun get_inner(a: [[u32]], i: index): ?[u32]
    ret some (a[i]?@)
end fun

debuglog get_inner([[1, 2], [3, 4, 5], [6]], (: index / 0))
debuglog get_inner([[1, 2], [3, 4, 5], [6]], (: index / 1))
debuglog get_inner([[1, 2], [3, 4, 5], [6]], (: index / 5))
