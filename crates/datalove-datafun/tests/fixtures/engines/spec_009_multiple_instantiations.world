----------
module local/test/multi
----------

// Function called with multiple different const values.
fun scale(const factor: int, x: int): int
    ret x * factor
end fun

----------
scriptunit-fragment
----------

require module local/test/multi
import multi.scale

const TWO: int = 2
const THREE: int = 3
const FIVE: int = 5
const TWO_AGAIN: int = 2  // Same value as TWO, to test discriminant reuse

// Three different instantiations of scale
let a = scale(TWO, 10)        // discriminant 0: 10 * 2 = 20
let b = scale(THREE, 10)      // discriminant 1: 10 * 3 = 30
let c = scale(FIVE, 10)       // discriminant 2: 10 * 5 = 50
let d = scale(TWO_AGAIN, 5)   // should share discriminant 0: 5 * 2 = 10

debuglog a
debuglog b
debuglog c
debuglog d

----------
scriptunit-expr
----------

a + b + c + d
