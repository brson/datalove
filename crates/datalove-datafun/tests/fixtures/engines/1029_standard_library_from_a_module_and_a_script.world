----------
module local/gen/m
----------

// A worldfile may require the standard library, which the engines compile
// only as far as its sections require it, and whose natives they register.

require module sys/std/u8

fun f(a: u8, b: u8): ?u8
  ret u8.add_checked(a, b)
end fun
