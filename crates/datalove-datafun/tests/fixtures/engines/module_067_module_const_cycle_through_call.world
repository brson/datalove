----------
module local/test/main
----------

// A const whose evaluation reaches a function waiting on a module const only
// through another function: `cheapest` names no const and is lowered first,
// but it calls `price_at`, which names `ORDERS` and so waits for it. `ORDERS`
// is above `CHEAPEST`, so this is no cycle: `price_at` is lowered once
// `ORDERS` has its value, before `CHEAPEST` is evaluated. It was once refused
// as a cycle, and before that panicked in the interpreter looking for
// `price_at`.

const ORDERS: [{price: f64}] = [{price = 2.0}]

fun price_at(i: index): ?f64
    ret some (ORDERS[i]?.price)
end fun

fun cheapest(): f64
    if price_at(: index / 0) |p|
        ret p
    end if
    ret 0.0
end fun

const CHEAPEST: f64 = cheapest()

fun main(): f64
  ret CHEAPEST
end fun

