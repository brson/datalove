// Set field of list element using ! error mode.
fun set_elem_x(a: [{x: u32, y: u32}], i: index, v: u32): ![{x: u32, y: u32}]
    var b = a
    set b[i]!.x = v
    ret ok b
end fun

debuglog set_elem_x([{x = 1, y = 2}, {x = 3, y = 4}], (: index / 0), 99)
debuglog set_elem_x([{x = 1, y = 2}, {x = 3, y = 4}], (: index / 5), 99)
