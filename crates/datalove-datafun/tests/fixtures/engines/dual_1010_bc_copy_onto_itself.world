scriptunit-fragment
----------

// A value copied out of a variable and straight back: once the first copy
// writes where the second would have, the second copies a place onto itself,
// which is no copy at all.
fun h(a: u32, b: u32, c: u32): !u32
  var p: { x: u32, y: u32, z: u32 } = { x = a, y = b, z = c }
  let q = p
  set p = q
  ret ok p.y
end fun

debuglog h(1, 2, 3)
