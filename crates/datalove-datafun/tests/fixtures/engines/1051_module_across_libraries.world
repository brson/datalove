----------
module vendor/util/base
----------

fun add_one(x: int): int
    ret x + :int/1
end fun

----------
module local/app/math
----------

// A local module requiring one in another library.
require module vendor/util/base
import base.add_one

fun add_two(x: int): int
    ret add_one(add_one(x))
end fun

