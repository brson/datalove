----------
module local/test/main
----------

// Test ref param with comparison operations.
// Comparisons work on any type via ref params.
fun is_equal(ref a: int, ref b: int): bool
    ret a == b
end fun

----------
scriptunit-fragment
----------

require module local/test/main
import main.is_equal

let x: int = :int/10
let y: int = :int/20
let z: int = :int/10

let eq1 = is_equal(ref x, ref z)
let eq2 = is_equal(ref x, ref y)
let eq3 = is_equal(ref x, ref x)
let output = (eq1, eq2, eq3)

----------
scriptunit-expr
----------

output
