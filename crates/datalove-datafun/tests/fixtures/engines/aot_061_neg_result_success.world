// Test -! (negation) operator with no overflow - should return Ok(result).
fun checked_neg(a: i32): !i32
    ret ok (-! a)
end fun

fun unwrap_or_default(r: !i32, default: i32): i32
    if r |val|
        ret val
    else |e|
        ret default
    end if
end fun

// neg(42) = -42, no overflow.
debuglog unwrap_or_default(checked_neg(42), 999)
