----------
module local/test/main
----------

// Reading a const back out of the value the compiler worked out.
//
// A const is evaluated by running it, and what comes out has to be read back
// into something the compiler can write down again. That read stopped short in
// two places.
//
// A `data` and an `error` carry their own descriptor and were not handled at
// all: neither could be a const, whatever it held.
//
// And an `error`'s payload is whatever it was built from, so reading one means
// reconstructing a type from the descriptor it carries. That reconstruction
// handled the scalars and a string and gave up on the rest, under a note that
// a complex type would want recursion. A descriptor carries the whole of a
// type, so it does -- and until it did, a const of a result whose error held a
// tuple could not be evaluated at all: "cannot reconstruct IrType from
// TyTag::Tuple".
//
// Here rather than in `std_tests` because that runs every backend, and the C
// one cannot yet write a `data`, an `error` or a result as a constant. This is
// about the evaluator, which is what the interpreter exercises.

// A `data`, which is a value under a descriptor it carries itself. Each of the
// three ways one is packed: on the heap, inline with a descriptor, and inline
// with only a tag.
const A_NUMBER: data = data : u32 / 7
const A_NARROW: data = data : u8 / 3
const A_STRING: data = data : string / "held"
const A_LIST: data = data : [u32] / [: u32 / 1, : u32 / 2]

// An `error`, the same shape under a different name.
const AN_ERROR: error = error : u32 / 3
const AN_ERROR_STRING: error = error : string / "went wrong"

// A result whose error side carries something structured, which is what the
// reconstruction is for.
const ERR_TUPLE: !index = er error : (u32, u8, i32) / (: u32 / 34, : u8 / 92, : i32 / 110)
const ERR_LIST: !u32 = er error : [u32] / [: u32 / 1, : u32 / 2]
const ERR_STRUCT: !u32 = er error : {a: u32, b: string} / {a = : u32 / 5, b = : string / "in it"}
const ERR_OPTION: !u32 = er error : ?u32 / some : u32 / 8

// And the ok side, which was always read back.
const OK_SIDE: !u32 = ok : u32 / 5

// Nested, so the read goes more than one level.
const WRAPPED: ?data = some : data / data : u32 / 9

fun main(): (data, data, data, data, error, error, !index, !u32, !u32, !u32, !u32, ?data)
  ret (A_NUMBER@, A_NARROW@, A_STRING@, A_LIST@, AN_ERROR@, AN_ERROR_STRING@,
       ERR_TUPLE@, ERR_LIST@, ERR_STRUCT@, ERR_OPTION@, OK_SIDE@, WRAPPED@)
end fun

----------
scriptunit-fragment
----------

require module local/test/main
import main.main

debuglog main()
