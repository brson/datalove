// The same with an earlier unit's binding, which the unit leaving early
// keeps for the session: dropped here, it held nothing for the session's
// end to drop, and the unit's IR, read for what it reads, broke an
// assertion that such a drop is followed by the write.

let n: index = f(out s, (: index / 4) -! (: index / 46))
