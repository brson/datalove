// Error test: D014. One way out of the loop gives `b` away and another does
// not, so whether it is still held afterwards depends on which ran.
//
// Not D007. The move happens on the path that breaks, so it cannot happen
// twice; what cannot be settled is the state after the loop. The `while` is
// what makes the exits disagree -- the condition can fail on the first read,
// leaving `b` untouched.

var a: int = (: int / 5)
var b: int = (: int / 5)

loop while a == b
  if a == b
    set a = b
    break
  end if
end loop
