----------
module local/test/main
----------

// A function that names a module const and calls a generic that builds
// something.
//
// A collection built inside a generic is made against a descriptor the call
// site hands over, and which calls have to hand one over is worked out by
// closing the shapes over the call graph. That was done once, over everything
// lowered at the time -- and a function naming a module-level const is not
// lowered at that time. A const is evaluated against what is already lowered,
// so the functions that name one are held back and lowered afterwards, in a
// second round the closing never saw.
//
// So a function of that kind calling a generic that builds a list, a set or a
// map was compiled without the descriptor the call had to pass. The callee
// looked for a shape its frame had never been given, and the interpreter came
// down on "a shape built with is one this function declared".
//
// A generic that builds nothing was fine, needing no descriptor, which is what
// made this look like a problem with consts rather than with the closing.

const LIMIT: u32 = : u32 / 3

fun setify<T>(x: T): #{T} with { T is ord, }
  ret #{x}
end fun

fun listify<T>(x: T, y: T): [T]
  ret [x, y]
end fun

fun mapify<K, V>(k: K, v: V): %{K = V} with { K is ord, }
  ret %{k = v}
end fun

fun identity<T>(x: T): T
  ret x
end fun

// Each of these names the const, so each is lowered in the second round.
fun a_set(): #{u16}
  let bound: u32 = LIMIT
  ret setify(: u16 / 5)
end fun

fun a_list(): [u16]
  let bound: u32 = LIMIT
  ret listify(: u16 / 7, : u16 / 8)
end fun

fun a_map(): %{u16 = string}
  let bound: u32 = LIMIT
  ret mapify(: u16 / 1, "held")
end fun

// A generic building nothing, which needs no descriptor and always worked.
fun nothing_built(): u16
  let bound: u32 = LIMIT
  ret identity(: u16 / 9)
end fun

fun main(): (#{u16}, [u16], %{u16 = string}, u16)
  ret (a_set(), a_list(), a_map(), nothing_built())
end fun

