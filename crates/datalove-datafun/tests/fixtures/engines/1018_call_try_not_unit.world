----------
scriptunit-fragment
----------

// What `!` or `?` unwraps to must be unit, as a plain call's result must.
fun parse(x: u32): !u32
    ret ok x
end fun

fun lookup(x: u32): ?u32
    ret some x
end fun

fun run(): !()
    call parse(1)!
    ret ok ()
end fun

fun find(): ?()
    call lookup(1)?
    ret some ()
end fun
