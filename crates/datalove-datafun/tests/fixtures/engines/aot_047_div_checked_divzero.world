// Test /? operator with division by zero - should return None.
fun unwrap_or_default(opt: ?u32, default: u32): u32
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_div(a: u32, b: u32): ?u32
    ret some (a /? b)
end fun

// 42 / 0 is division by zero, returns None -> default 999.
debuglog unwrap_or_default(checked_div(42, 0), 999)
