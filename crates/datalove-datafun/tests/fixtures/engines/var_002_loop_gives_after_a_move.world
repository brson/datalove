----------
scriptunit-fragment
----------

// A var moved before a loop and given a value inside it holds nothing on the
// loop's first pass and something after. It is dropped by its tracking byte
// wherever the function leaves: after the loop, though no read is allowed
// there, and at a return inside the body, though that return was analyzed
// before the loop showed the var could hold anything. The same holds for an
// inner loop that gives it one, a `continue` past the rest of the body, and an
// error unwrapped with `!` on the way out.

fun after_the_loop(n: u32): u32
  var s = "first"
  let gone = s
  var i: u32 = 0
  loop while i .< n
    set s = "again"
    set i = icall add_wrapping_u32(i, 1)
  end loop
  ret i
end fun

fun returning_from_the_body(n: u32): u32
  var s = "first"
  let gone = s
  var i: u32 = 0
  loop while i .< 10
    if i == n
      ret i
    end if
    set s = "again"
    set i = icall add_wrapping_u32(i, 1)
  end loop
  ret 10
end fun

fun nested(n: u32): u32
  var s = "first"
  let gone = s
  var i: u32 = 0
  loop while i .< n
    var j: u32 = 0
    loop while j .< 2
      set s = "inner"
      set j = icall add_wrapping_u32(j, 1)
    end loop
    set i = icall add_wrapping_u32(i, 1)
  end loop
  ret i
end fun

fun continuing(n: u32): u32
  var s = "first"
  let gone = s
  var i: u32 = 0
  loop while i .< n
    set i = icall add_wrapping_u32(i, 1)
    set s = "again"
    if i == 1
      continue
    end if
  end loop
  ret i
end fun

fun check(i: u32): !u32
  if i == 2
    ret er error "two"
  end if
  ret ok i
end fun

fun trying(n: u32): !u32
  var s = "first"
  let gone = s
  var i: u32 = 0
  loop while i .< n
    set s = "again"
    let k = check(i)!
    set i = icall add_wrapping_u32(k, 1)
  end loop
  ret ok i
end fun


debuglog (after_the_loop(0), after_the_loop(3), returning_from_the_body(0), returning_from_the_body(2), returning_from_the_body(20))
debuglog (nested(0), nested(2), continuing(5), continuing(0))
debuglog (trying(1), trying(5))
