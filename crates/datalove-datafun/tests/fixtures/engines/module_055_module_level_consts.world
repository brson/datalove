----------
module local/test/main
----------

// Module-level consts. They are evaluated between two lowering strata: the
// functions that name none of them are lowered first, the consts are evaluated
// against those, and the functions that do name one are lowered after. That is
// what lets FROM_CALL call a function while USES_TOP can read TOP.

const TOP: u32 = : u32 / 7
const CHAINED: u32 = TOP
const MSG: string = "hello"
const BIG: int = 99999999999999999999
const LST: [int] = [1, 2, 3]

fun helper(): u32
  ret : u32 / 3
end fun

const FROM_CALL: u32 = helper()

fun uses_top(): u32
  ret TOP
end fun

fun uses_chained(): u32
  ret CHAINED
end fun

fun uses_from_call(): u32
  ret FROM_CALL
end fun

// The linear ones are the reason this route was chosen: a module const reaches
// lowering through the same path as an evaluated function-level const, so each
// reference emits a fresh Const and is dropped as an expression temporary. A
// leak here fails the test rather than changing the output.
fun uses_string(): string
  ret MSG@
end fun

fun uses_bigint(): int
  ret BIG@
end fun

fun uses_list(): [int]
  ret LST@
end fun

// A function-level const may name a module-level one.
fun local_names_module(): u32
  const L: u32 = TOP
  ret L
end fun

fun main(): (u32, u32, u32, u32, int, [int])
  ret (uses_top(),
       uses_chained(),
       uses_from_call(),
       local_names_module(),
       uses_bigint(),
       uses_list())
end fun

----------
scriptunit-fragment
----------

require module local/test/main
import main.main

debuglog main()
