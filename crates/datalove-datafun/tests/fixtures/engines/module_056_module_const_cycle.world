----------
module local/test/main
----------

// A const whose evaluation calls a function that reads the const itself. The
// function cannot lower until the const is evaluated, and the const cannot be
// evaluated until the function is lowered.
//
// A const may depend only on what is declared above it, including through the
// functions it calls, so the typechecker refuses this at the const (F089),
// naming the chain.

const A: u32 = f()

fun f(): u32
  ret A
end fun

fun main(): u32
  ret : u32 / 1
end fun

----------
scriptunit-fragment
----------

require module local/test/main
import main.main

debuglog main()
