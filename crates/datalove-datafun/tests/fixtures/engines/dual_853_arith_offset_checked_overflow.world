----------
scriptunit-fragment
----------

fun unwrap_offset(opt: ?offset, default: offset): offset
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_add(a: offset, b: offset): ?offset
    ret some (a +? b)
end fun

fun checked_sub(a: offset, b: offset): ?offset
    ret some (a -? b)
end fun

fun checked_div(a: offset, b: offset): ?offset
    ret some (a /? b)
end fun

let max: offset = (: offset / 2147483647)
let min: offset = (: offset / -2147483648)
let one: offset = (: offset / 1)
let zero: offset = (: offset / 0)

// Add overflow returns none.
debuglog unwrap_offset(checked_add(max, one), (: offset / 999))

// Sub underflow returns none.
debuglog unwrap_offset(checked_sub(min, one), (: offset / 999))

// Div by zero returns none.
debuglog unwrap_offset(checked_div(one, zero), (: offset / 999))
