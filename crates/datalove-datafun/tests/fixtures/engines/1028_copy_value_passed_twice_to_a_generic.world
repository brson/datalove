----------
module local/gen/m
----------
fun pair<K, V>(k: K, v: V): %{K = V} where { K is ord, }
  ret %{k = v}
end fun

// `a` and `b` are copies of `t`, and constant propagation makes the call
// `pair(v0, v0)`: the same operand for two parameters. The JIT passed both
// by one pointer, so `pair` handed the map insert one place as its key and
// its value, each the insert's to own, which the runtime refuses. Each
// argument after the first naming an operand is now passed a copy. Found
// by worldgen_engine_tests.

fun f(): %{bool = bool}
  let t: bool = true
  let a: bool = t
  let b: bool = t
  ret pair(a, b)
end fun
