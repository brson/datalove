// A const map whose key takes no room. Const evaluation reads the map the
// runtime built, by the runtime's node layout, so the values are where the
// runtime put them: right after the keys' offset, as the keys take none.

const E: %{{} = bool} = %{: {} / {} = true}
const F: %{{} = ?bool} = %{: {} / {} = : ?bool / some true}
const G: %{{} = !bool} = %{: {} / {} = : !bool / ok : bool / true}
debuglog E
debuglog F
debuglog G
