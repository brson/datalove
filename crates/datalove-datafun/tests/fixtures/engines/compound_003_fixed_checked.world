// Compound assignment on every fixed-width integer, with the checked operators.
fun ops_u8(a: u8, b: u8): !(u8, u8, u8, u8)
    var sum = a
    set sum +!= b
    var diff = a
    set diff -!= b
    var prod = b
    set prod *!= b
    var quot = a
    set quot /!= b
    ret ok (sum, diff, prod, quot)
end fun

fun ops_u16(a: u16, b: u16): !(u16, u16, u16, u16)
    var sum = a
    set sum +!= b
    var diff = a
    set diff -!= b
    var prod = b
    set prod *!= b
    var quot = a
    set quot /!= b
    ret ok (sum, diff, prod, quot)
end fun

