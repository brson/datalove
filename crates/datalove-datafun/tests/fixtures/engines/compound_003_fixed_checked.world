// Each operator fails when its result doesn't fit, or on a zero divisor.
fun add_u8(a: u8, b: u8): !u8
    var x = a
    set x +!= b
    ret ok x
end fun

fun sub_u16(a: u16, b: u16): !u16
    var x = a
    set x -!= b
    ret ok x
end fun

fun mul_i32(a: i32, b: i32): !i32
    var x = a
    set x *!= b
    ret ok x
end fun

fun div_i64(a: i64, b: i64): !i64
    var x = a
    set x /!= b
    ret ok x
end fun

debuglog add_u8(255, 1)
debuglog sub_u16(0, 1)
debuglog mul_i32(2147483647, 2)
debuglog div_i64(5, 0)
debuglog div_i64(-9223372036854775808, -1)
