fun id<T>(x: T): T
  ret x
end fun

// `v.n` is read and unused, and the `const` makes the function go through
// const inlining, whose dead code elimination takes the read away. It
// counted a field read as consuming the struct, so it left `drop v` in its
// place, and `debuglog v` showed the string freed. Reading a copy field
// consumes nothing. Found by worldgen_engine_tests.

fun f()
  let a: { s: string, n: u32 } = {s = "value", n = : u32 / 182}
  let v: { s: string, n: u32 } = id(a)
  if true
    let n: u32 = v.n
  end if
  const C: u32 = 80
  debuglog v
end fun
