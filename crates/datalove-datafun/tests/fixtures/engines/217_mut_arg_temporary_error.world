// Test passing a call result to a mut parameter.
// Should error - the callee's write lands in a temporary and is discarded.
fun bump(mut x: u32): bool
    set x = 999
    ret true
end fun

fun mk(): u32
    ret 5
end fun

fun outer(): bool
    ret bump(mut mk())
end fun

