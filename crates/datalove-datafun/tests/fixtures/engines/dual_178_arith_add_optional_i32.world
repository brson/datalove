// Optional add (+?) with signed i32 - success case with negative.
fun add_opt(a: i32, b: i32): ?i32
    ret some (a +? b)
end fun

fun unwrap(opt: ?i32, default: i32): i32
    if opt |val|
        ret val
    end if
    ret default
end fun

// -10 + 15 = 5
debuglog unwrap(add_opt(-10, 15), 999)
