----------
module local/test/main
----------

// Test mut param write with linear type (int).
// set_to_int100() sets the param to 100 as int.
fun set_to_int100(mut x: int): bool
    set x = :int/100
    ret true
end fun

// Test wrapper.
fun test(): bool
    var n: int = :int/5
    let _ok: bool = set_to_int100(mut n)
    // Check that n is now 100
    ret n == :int/100
end fun

----------
scriptunit-fragment
----------

require module local/test/main
import main.test

----------
scriptunit-expr
----------

test()

