// OOB index with chained field ref: a[i]?.field passed to ref param.
// Exercises the OOB path which must drop the list.
fun read_ref(ref x: u32): ?u32
    ret some x
end fun

fun test(): ?u32
    var a: [(u32, u32)] = [(10, 20), (30, 40)]
    ret read_ref(ref a[(: index / 5)]?.0)
end fun

debuglog test()
