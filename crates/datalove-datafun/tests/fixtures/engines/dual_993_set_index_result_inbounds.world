// Set list element with ! — in-bounds mutation returns ok.
fun set_elem(a: [u32], i: index, v: u32): ![u32]
    var b = a
    set b[i]! = v
    ret ok b
end fun

debuglog set_elem([10, 20, 30], (: index / 0), 99)
debuglog set_elem([10, 20, 30], (: index / 2), 77)
