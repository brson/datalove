// A `const` makes the function's IR go through const inlining's dead code
// pass, which once removed an instruction whose result nothing read, and with
// it the only thing that consumed the generic call's result.
fun dup<T>(x: T): (T, T)
  ret (x@, x)
end fun

fun f(): i32
  let a: index = : index / 149
  let v: (index, index) = dup(a)
  const C: u32 = 93
  ret : i32 / 56
end fun

