----------
scriptunit-fragment
----------

// Multiple functions within a script unit calling each other.
// Using int type to avoid fixed-width integer widening issues.
fun add_one(x: int): int
    ret x + :int/1
end fun

fun add_two(x: int): int
    ret add_one(add_one(x))
end fun

fun add_four(x: int): int
    ret add_two(add_two(x))
end fun

----------
scriptunit-expr
----------

add_four(:int/3)
