require module local/test/offset_math
import offset_math.add
import offset_math.sub
import offset_math.mul
import offset_math.negate
import offset_math.max_of
import offset_math.min_of

let a: offset = (: offset / 100)
let b: offset = (: offset / -50)

debuglog add(a, b)
debuglog sub(a, b)
debuglog mul(a, b)
debuglog negate(a)
debuglog negate(b)
debuglog max_of(a, b)
debuglog min_of(a, b)
