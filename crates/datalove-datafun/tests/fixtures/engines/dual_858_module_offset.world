----------
module local/test/offset_math
----------

fun add(a: offset, b: offset): !offset
    ret ok (a +! b)
end fun

fun sub(a: offset, b: offset): !offset
    ret ok (a -! b)
end fun

fun mul(a: offset, b: offset): !offset
    ret ok (a *! b)
end fun

fun negate(n: offset): !offset
    ret ok (-! n)
end fun

fun max_of(a: offset, b: offset): offset
    if a >= b
        ret a
    else
        ret b
    end if
end fun

fun min_of(a: offset, b: offset): offset
    if a <= b
        ret a
    else
        ret b
    end if
end fun

