----------
module local/test/main
----------

// What generics do not do yet.

fun pick_first<T>(a: T, b: T): T
  ret a
end fun

// One type parameter means one type. The first argument in a position written
// as T fixes it, and a later one has to agree, so this is a mismatch rather
// than a reinterpretation of the bytes.
fun mismatch(): u32
  ret pick_first(: u32 / 1, "not a u32")
end fun

// Which type a parameter is fixed at depends on argument order. Here the
// `u32` comes first and fixes T, and the unsuffixed literal after it checks
// against that. Written the other way round the literal, standing for `int` on
// its own, would fix T at `int`, and the `u32` after it would be a mismatch:
// nothing widens into a type parameter any more than anywhere else.
fun order_chooses_the_type(): u32
  ret pick_first(: u32 / 1, 99)
end fun

// Nothing is converted at a call: a value passes as it stands, and the callee
// reads its layout from a descriptor built from the ones the call site handed
// over. So a type parameter may sit at any depth in a signature -- in a list,
// a map, a tuple, a container inside a tuple, a term -- and nothing below is
// refused for its signature.
fun in_list<T>(x: [T]): [T]
  ret x
end fun

fun in_map<K, V>(m: %{K = V}): %{K = V} where { K is ord, }
  ret m
end fun

fun in_tuple<T>(x: (T, u32)): (T, u32)
  ret x
end fun

fun container_in_tuple<T>(x: ([T], u32)): u32
  ret x.1
end fun

fun in_term<T>(x: term Wrapped T): bool
  ret true
end fun

fun main(): u32
  ret : u32 / 1
end fun

// Indexing reads the stride from the list's descriptor rather than from the
// static element type, so this works too.
fun first<T>(ref xs: [T]): ?T
  ret some (xs[: index / 0]?@)
end fun

// Building a collection of a type parameter.
//
// A `[T]` written here has no value to read a descriptor off, so it is built
// from the descriptor of `T` the call site handed over: the call site is the
// only place that knows what the parameter was bound to.
//
// A type parameter appearing solely in the return type is bound by what the
// call site expects, so these are callable as well as compilable.
fun build_a_list<T>(): [T]
  var out: [T] = []
  ret out
end fun

fun build_a_map<K, V>(): %{K = V} where { K is ord, }
  var out: %{K = V} = %{}
  ret out
end fun

fun build_a_set<T>(): #{T} where { T is ord, }
  var out: #{T} = #{}
  ret out
end fun

// What is left is that nothing can be done to a `T` but move it, drop it,
// clone it, print it and hand it back, which is what bounds are for.

----------
scriptunit-fragment
