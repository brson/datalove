// Index into list of strings.
fun get_str(a: [string], i: index): ?string
    ret some (a[i]?@)
end fun

debuglog get_str(["hello", "world", "foo"], (: index / 0))
debuglog get_str(["hello", "world", "foo"], (: index / 1))
debuglog get_str(["hello", "world", "foo"], (: index / 5))
