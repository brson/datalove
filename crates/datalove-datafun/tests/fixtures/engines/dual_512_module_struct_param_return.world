----------
module local/test/structops
----------

// Module function taking and returning struct.
fun double_coords(p: {x: u32, y: u32}): !{x: u32, y: u32}
    ret ok {x = p.x +! p.x, y = p.y +! p.y}
end fun

----------
scriptunit-fragment
----------

require module local/test/structops
import structops.double_coords

let original: {x: u32, y: u32} = {x = 5, y = 10}
debuglog double_coords(original)
