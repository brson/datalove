// Test passing Ref-mode param to Mut-mode param.
// Should error - can't get mutable reference from immutable reference.
fun inner(mut x: u32): bool
    set x = 42
    ret true
end fun

fun outer(ref y: u32): bool
    ret inner(mut y)
end fun

