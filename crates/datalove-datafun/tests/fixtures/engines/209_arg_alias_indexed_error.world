// Test two indexed arguments rooted at the same binding.
// Should error - whether a[0] and a[1] overlap is not decided statically, so
// sharing a root is rejected conservatively.
fun mf(mut a: u32, ref b: u32): u32
    set a = 9
    ret b
end fun

fun outer(mut a: [u32]): ?u32
    ret some mf(mut a[0]?, ref a[1]?)
end fun

