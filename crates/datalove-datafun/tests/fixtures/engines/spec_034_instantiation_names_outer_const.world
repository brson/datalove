// engines: -noconst
// A comptime argument has to be a const the compiler evaluated.

----------
module local/test/outer
----------

// A comptime function's const that names both its const parameter and a
// module const. The const waits for the copy, since it has a value per
// instantiation, and the copy's consts are evaluated with the parameter's
// value and the module's consts in scope. A script that makes the copy has to
// supply the module's consts too: it once supplied only the parameter, and the
// const failed with "binding not available yet".

const K: int = 2

fun plus_k(const n: int): int
    const M: int = n + K
    ret M@
end fun

----------
scriptunit-fragment
----------

require module local/test/outer

// The same in a script function, naming a script const.
const J: int = 10

fun plus_j(const n: int): int
    const M: int = n + J
    ret M@
end fun

const T: int = 3
let result = (outer.plus_k(T), plus_j(T))
debuglog result

----------
scriptunit-expr
----------

result
