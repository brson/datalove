// Test passing a let binding to a mut parameter.
// Should error - parameters are passed by reference, so this would mutate a
// binding declared immutable.
fun bump(mut x: u32): bool
    set x = 999
    ret true
end fun

fun outer(): u32
    let v: u32 = 42
    let _ok = bump(mut v)
    ret v
end fun

