ModulesAnalysis(
    typecheck: TypecheckResult(
        status: "Success",
    ),
    lowering: LoweringResult(
        status: "Success",
        ir: """
            fn test_sub(p0, p1):
            block0:
                v0, v1 = sub.checked p0, p1
                branch v1, block1, block2
            block1:
                v2 = const "arithmetic overflow"
                v3 = error_from v2
                v4 = err v3
                exit v4
            block2:
                v5 = ok v0
                exit v5
            
            fn main():
            block0:
                v0 = const 10u32
                v1 = const 3u32
                v2 = call @0 m0.u0(v0, v1)
                exit v2
        """,
