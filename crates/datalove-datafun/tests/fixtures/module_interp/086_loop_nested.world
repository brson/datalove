----------
module local/test/main
----------

fun nested_loops(): !u32
    var total: u32 = @0
    var outer: u32 = @0
    loop
        set outer = outer +! @1
        var inner: u32 = @0
        loop
            set inner = inner +! @1
            set total = total +! @1
            if inner >= @2
                break
            end if
        end loop
        if outer >= @3
            break
        end if
    end loop
    ret total
end fun

fun main(): !u32
    ret nested_loops()
end fun
