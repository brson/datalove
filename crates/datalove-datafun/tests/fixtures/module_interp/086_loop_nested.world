----------
module local/test/main
----------

fun nested_loops(): !u32
    let total: u32 = @0
    let outer: u32 = @0
    loop
        let outer = outer +! @1
        let inner: u32 = @0
        loop
            let inner = inner +! @1
            let total = total +! @1
            if inner >= @2
                break
            end if
        end loop
        if outer >= @3
            break
        end if
    end loop
    ret total
end fun

fun main(): !u32
    ret nested_loops()
end fun
