----------
module sys/test/cmp
----------

fun is_less(a: u32, b: u32): bool
    ret a .< b
end fun

fun is_equal(a: u32, b: u32): bool
    ret a == b
end fun

----------
module local/test/main
----------

require module sys/test/cmp
import cmp.is_less
import cmp.is_equal

fun main(): bool
    ret is_less(@5, @10)
end fun
