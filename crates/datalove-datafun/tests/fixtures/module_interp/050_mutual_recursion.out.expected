ModulesAnalysis(
    typecheck: TypecheckResult(
        status: "Success",
    ),
    lowering: LoweringResult(
        status: "Success",
        ir: """
            fn is_even(p0):
            block0:
                v0 = const 0u32
                v1 = eq p0, v0
                branch v1, block1, block2
            block1:
                v2 = const true
                v3 = ok v2
                exit v3
            block2:
                v4 = const 1u32
                v5, v6 = sub.checked p0, v4
                branch v6, block3, block4
            block3:
                v7 = const "arithmetic overflow"
                v8 = error_from v7
                v9 = err v8
                exit v9
            block4:
                v10 = call @0 m0.u1(v5)
                exit v10
            
            fn is_odd(p0):
            block0:
                v0 = const 0u32
                v1 = eq p0, v0
                branch v1, block1, block2
            block1:
                v2 = const false
                v3 = ok v2
                exit v3
            block2:
                v4 = const 1u32
                v5, v6 = sub.checked p0, v4
                branch v6, block3, block4
            block3:
                v7 = const "arithmetic overflow"
                v8 = error_from v7
                v9 = err v8
                exit v9
            block4:
                v10 = call @0 m0.u0(v5)
                exit v10
            
            fn main():
            block0:
                v0 = const 6u32
                v1 = call @0 m0.u0(v0)
                exit v1
        """,
    ),
    output: "ok true",
)