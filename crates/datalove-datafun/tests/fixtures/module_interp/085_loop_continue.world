----------
module local/test/main
----------

fun skip_iteration(): !u32
    var sum: u32 = @0
    var i: u32 = @0
    loop
        set i = i +! @1
        if i .> @5
            break
        end if
        if i == @3
            continue
        end if
        set sum = sum +! i
    end loop
    ret ok sum
end fun

fun main(): !u32
    ret skip_iteration()
end fun
