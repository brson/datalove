----------
module local/test/main
----------

fun test_lt(a: @i8, b: @i8): @bool
    ret a .< b
end fun

fun test_eq(a: @i8, b: @i8): @bool
    ret a == b
end fun

fun main(): @(@bool, @bool)
    let lt_result = test_lt(@5, @10)
    let eq_result = test_eq(@5, @5)
    ret @(lt_result, eq_result)
end fun
