----------
module local/test/main
----------

// What generics do not do yet.

fun pick_first<T>(a: T, b: T): T
  ret a
end fun

// One type parameter means one type. The first argument in a position written
// as T fixes it, and a later one has to agree, so this is a mismatch rather
// than a reinterpretation of the bytes.
fun mismatch(): u32
  ret pick_first(: u32 / 1, "not a u32")
end fun

// Which type a parameter is fixed at depends on argument order. An unsuffixed
// integer literal stands for `int` on its own, so it fixes T at `int` here and
// the `u32` after it is accepted by widening into that. Written the other way
// round T would be `u32` and the literal would check against it. Both are
// fine; they just do not name the same T.
fun order_chooses_the_type(): int
  ret pick_first(99, : u32 / 1)
end fun

// Erasure converts a value into the shape the callee was compiled for. An
// option holds its payload inline, so converting one means converting the
// payload and writing it at the other side's offset, and a parameter under an
// option is reachable that way. A collection packs its elements by size, so
// `[T]` and `[data]` disagree about where every element after the first
// begins; converting between them would mean rebuilding the collection element
// by element, which costs a walk of the whole thing at every call. Until that
// is worth paying for, a parameter under a collection is refused rather than
// reinterpreted, because reinterpreting it hands the callee a length and a
// stride that do not match what it was given.
fun in_list<T>(x: [T]): [T]
  ret x
end fun

fun in_map<K, V>(m: %{K = V}): %{K = V}
  ret m
end fun

fun in_tuple<T>(x: (T, u32)): (T, u32)
  ret x
end fun

fun main(): u32
  ret : u32 / 1
end fun

// Indexing works out where an element sits from the type of the collection, and
// a generic function's type for one says `data` where the type parameter was
// written, so the stride would be a `data`'s and the read would land between
// elements. The descriptor saying what the elements really are reaches the
// native list functions but not the index operator, so this is refused rather
// than read wrong. `sys/std/list` is the way to reach an element.
fun first<T>(ref xs: [T]): ?T
  ret some (xs[: index / 0]?@)
end fun
