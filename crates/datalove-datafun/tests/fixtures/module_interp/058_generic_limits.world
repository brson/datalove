----------
module local/test/main
----------

// What generics do not do yet.

fun pick_first<T>(a: T, b: T): T
  ret a
end fun

// One type parameter means one type. The first argument in a position written
// as T fixes it, and a later one has to agree, so this is a mismatch rather
// than a reinterpretation of the bytes.
fun mismatch(): u32
  ret pick_first(: u32 / 1, "not a u32")
end fun

// Which type a parameter is fixed at depends on argument order. An unsuffixed
// integer literal stands for `int` on its own, so it fixes T at `int` here and
// the `u32` after it is accepted by widening into that. Written the other way
// round T would be `u32` and the literal would check against it. Both are
// fine; they just do not name the same T.
fun order_chooses_the_type(): int
  ret pick_first(99, : u32 / 1)
end fun

// Erasure converts a value into the shape the callee was compiled for. An
// option holds its payload inline, so converting one means converting the
// payload and writing it at the other side's offset, and a parameter under an
// option is reachable that way.
//
// A collection is reachable by not converting it at all: it is wrapped whole,
// which copies a pointer and two indices and leaves the elements where they
// are, and the wrapper carries the descriptor that says what they are. So
// `in_list` and `in_map` below are accepted, and their bodies hand the value
// back the way they were given it.
//
// A tuple does need converting -- `(u32, u32)` is eight bytes where
// `(data, data)` is thirty-two -- but by a walk over as many fields as the
// type has rather than over anything the value holds, so it is converted
// rather than refused.
//
// A container inside a tuple is converted the way a container anywhere is, by
// wrapping it: the tuple's walk reaches the field and the field's conversion is
// the wrapping one, and the two compose without either knowing about the other.
//
// A term is its payload under a name, and an enum is a payload chosen by a
// discriminant, so both convert the way an option does. Every position a type
// parameter can occupy is now one erasure reaches, which is why nothing below
// is refused for its signature and the only thing left is the index operator.
fun in_list<T>(x: [T]): [T]
  ret x
end fun

fun in_map<K, V>(m: %{K = V}): %{K = V}
  ret m
end fun

fun in_tuple<T>(x: (T, u32)): (T, u32)
  ret x
end fun

fun container_in_tuple<T>(x: ([T], u32)): u32
  ret x.1
end fun

fun in_term<T>(x: term Wrapped T): bool
  ret true
end fun

fun main(): u32
  ret : u32 / 1
end fun

// Indexing reads the stride from the list's descriptor rather than from the
// static element type, so this works too. What is left in this file is not a
// limit of erasure at all: it is that nothing can be done to a `T` but move
// it, drop it, clone it and hand it back, which is what bounds are for.
fun first<T>(ref xs: [T]): ?T
  ret some (xs[: index / 0]?@)
end fun

// The one thing erasure genuinely cannot reach: a collection built here rather
// than passed in.
//
// A `[T]` that arrives is fine, because it arrives wrapped and the wrapper
// carries the descriptor saying what its elements are. A `[T]` written here
// has no such descriptor and nowhere to get one: the function knows a `T` only
// as something its caller described, and an empty list was described by
// nobody. So `reversed`, `concat` and anything else that returns a new
// collection stay out of reach until a type parameter can be asked what it is
// at runtime.
//
// This is refused rather than lowered. Before it was refused the lowering
// reached a `[T]` with no element type behind it and panicked.
fun build_a_list<T>(): [T]
  var out: [T] = []
  ret out
end fun

fun build_a_map<K, V>(): %{K = V}
  var out: %{K = V} = %{}
  ret out
end fun

fun build_a_set<T>(): #{T}
  var out: #{T} = #{}
  ret out
end fun
