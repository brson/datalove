----------
module local/test/main
----------

fun sum_to_three(): !u32
    let sum: u32 = @0
    let i: u32 = @0
    loop
        let i = i +! @1
        let sum = sum +! i
        if i >= @3
            break
        end if
    end loop
    ret ok sum
end fun

fun main(): !u32
    ret sum_to_three()
end fun
