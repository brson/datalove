----------
module local/test/boolconst
----------

// Comptime function with bool type - uses single param to avoid drop order flakiness
fun conditional_double(const do_double: bool, x: int): int
    if do_double
        ret x + x
    else
        ret x
    end if
end fun

----------
scriptunit-fragment
----------

require module local/test/boolconst
import boolconst.conditional_double

const YES: bool = true
const NO: bool = false
let result1 = conditional_double(YES, 10)
let result2 = conditional_double(NO, 10)
debuglog result1
debuglog result2

----------
scriptunit-expr
----------

(result1, result2)
