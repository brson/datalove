----------
module local/test/provider
----------

// Module providing a comptime function.
fun scale(const factor: int, x: int): int
    ret factor * x
end fun

----------
module local/test/consumer
----------

require module local/test/provider
import provider.scale

// This module calls the comptime function from another module.
fun triple(x: int): int
    const THREE: int = 3
    ret scale(THREE, x)
end fun

