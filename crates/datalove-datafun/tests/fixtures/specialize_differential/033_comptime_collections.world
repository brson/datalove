----------
module local/test/collconst
----------

// Const parameters of linear types: collections, a struct holding one, and an
// enum with a collection payload. Each distinct value gets its own copy.

type Shape: enum {
    atom Empty,
    term Points [int],
}

fun list_head(const xs: [int]): !int
    ret ok (xs[(: index / 0)]!@)
end fun

fun map_get(const m: %{string = int}): !int
    ret ok (m["a"]!@)
end fun

fun set_back(const s: #{int}): #{int}
    ret s@
end fun

fun name_of(const p: {name: string, tags: [string]}): string
    ret p.name@
end fun

fun shape_count(const s: Shape): int
    match s@
    case atom Empty
        ret :int/0
    case term Points xs
        ret :int/1
    end match
end fun

