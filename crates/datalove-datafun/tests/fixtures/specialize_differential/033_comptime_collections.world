require module local/test/collconst

const XS: [int] = [:int/7, :int/8]
const YS: [int] = [:int/9]
const M: %{string = int} = %{ "a" = :int/1 }
const S: #{int} = #{ :int/2, :int/3 }
const P: {name: string, tags: [string]} = {name = "ada", tags = ["x"]}
const E: enum { atom Empty, term Points [int] } = term Points [:int/1]

let result = (
    collconst.list_head(XS),
    collconst.list_head(YS),
    collconst.list_head(XS),
    collconst.map_get(M),
    collconst.set_back(S),
    collconst.name_of(P),
    collconst.shape_count(E),
)
debuglog result

