----------
module local/test/literals
----------

// A const argument written as a literal, which used to be refused. The plan
// is built from the IR, where a literal is a `Const` operand exactly like a
// const binding is, so the specialization side needs nothing for this.

fun scale(const factor: int, x: int): int
    ret factor * x
end fun

fun repeat_str(const n: int, s: string): string
    ret s
end fun

fun triple(x: int): int
    ret scale(3, x)
end fun

fun quintuple(x: int): int
    ret scale(5, x)
end fun

// The same instantiation as `triple`, so both reach one copy.
fun thrice_again(x: int): int
    ret scale(3, x)
end fun

// A fixed-width const parameter, where a literal that needed widening would
// lower to something other than a `Const` and quietly not specialize.
fun multiply_i32(const factor: i32, x: i32): !i32
    ret ok (factor *! x)
end fun

fun triple_i32(x: i32): !i32
    ret multiply_i32(3, x)
end fun

----------
scriptunit-fragment
----------

require module local/test/literals
import literals.scale
import literals.repeat_str
import literals.triple
import literals.quintuple
import literals.thrice_again
import literals.multiply_i32
import literals.triple_i32

let a = triple(10)
let b = quintuple(10)
let c = thrice_again(10)
let d = scale(7, 10)
let e = repeat_str(2, "hi")
let f = triple_i32(: i32 / 5)
let g = multiply_i32(4, : i32 / 5)
debuglog a
debuglog b
debuglog c
debuglog d
debuglog e
debuglog f
debuglog g

