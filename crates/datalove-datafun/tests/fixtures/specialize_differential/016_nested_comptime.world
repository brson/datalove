----------
module local/test/nested
----------

// Comptime function A
fun add_n(const n: int, x: int): int
    ret n + x
end fun

// Comptime function B that calls comptime function A
fun double_add(const n: int, x: int): int
    const N: int = n
    let first = add_n(N, x)
    ret add_n(N, first)
end fun

