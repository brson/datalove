----------
module local/test/main
----------

fun add(a: int, b: int): int
    ret a + b
end fun

fun double(x: int): int
    ret add(x@, x)
end fun

fun quad(x: int): int
    let d1 = double(x@)
    let d2 = double(x)
    ret d1 + d2
end fun

----------
inline-directives
----------
inline double add
inline quad double
