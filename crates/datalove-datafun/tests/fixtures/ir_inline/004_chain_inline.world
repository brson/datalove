----------
module local/test/main
----------

fun add(a: i64, b: i64): int
    ret a + b
end fun

fun double(x: i64): int
    ret add(x, x)
end fun

fun quad(x: i64): int
    let d1 = double(x)
    let d2 = double(x)
    ret d1 + d2
end fun

----------
inline-directives
----------
inline double add
inline quad double
