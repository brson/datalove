----------
module local/test/main
----------

fun classify(x: int): int
    if x@ .< 0
        ret 0 - 1
    else if x@ .> 0
        ret 1
    else
        ret 0
    end if
end fun

fun use_classify(x: int): int
    ret classify(x)
end fun

----------
inline-directives
----------
inline use_classify classify
