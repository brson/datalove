----------
module local/test/main
----------

// Two early returns and a third at the end, which is the shape this fixture is
// named for. It was spelled as an `else if` chain while the ownership pass
// refused an else-less `ret` with an owned value live.
fun classify(x: int): int
    if x@ .< 0
        ret 0 - 1
    end if
    if x@ .> 0
        ret 1
    end if
    ret 0
end fun

fun use_classify(x: int): int
    ret classify(x)
end fun

----------
inline-directives
----------
inline use_classify classify
