----------
module local/test/main
----------

// Test inlining a function with a mut param.
// This should fail or be skipped - mut params write back to caller's location
// which is not properly handled by inlining.
fun set_to_100(mut x: u32): bool
    set x = 100
    ret true
end fun

fun caller(): u32
    var v: u32 = 42
    let _ok = set_to_100(mut v)
    ret v
end fun

----------
inline-directives
----------
inline caller set_to_100
