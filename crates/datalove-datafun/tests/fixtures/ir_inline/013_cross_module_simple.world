----------
module local/test/base
----------

// Base module with a helper function.
fun add(a: i64, b: i64): int
    ret a + b
end fun

----------
module local/test/main
----------

require module local/test/base
import base.add

// Main module calls base module function.
fun double(x: i64): int
    ret add(x, x)
end fun

