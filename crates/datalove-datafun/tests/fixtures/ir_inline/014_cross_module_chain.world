----------
module local/test/base
----------

// Base function.
fun add_one(x: int): int
    ret x + :int/1
end fun

----------
module local/test/middle
----------

require module local/test/base
import base.add_one

// Calls base function.
fun add_two(x: int): int
    ret add_one(add_one(x))
end fun

----------
module local/test/main
----------

require module local/test/middle
import middle.add_two

// Calls middle function.
fun add_four(x: int): int
    ret add_two(add_two(x))
end fun

----------
inline-directives
----------
// Inline add_two into add_four, then add_one into add_two.
inline-cross main::add_four middle::add_two
inline-cross middle::add_two base::add_one
