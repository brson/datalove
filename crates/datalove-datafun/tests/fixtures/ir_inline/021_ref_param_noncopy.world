----------
module local/test/main
----------

// Test inlining a function with a ref param (non-copy type).
// This exposes the bug: the inliner uses Move instead of Clone,
// which would consume the caller's value incorrectly.
fun read_int(ref x: int): int
    ret x + :int/0
end fun

fun caller(): int
    let v: int = 42
    let r = read_int(ref v)
    ret r
end fun

----------
inline-directives
----------
inline caller read_int
