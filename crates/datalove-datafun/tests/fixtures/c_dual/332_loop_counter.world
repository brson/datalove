----------
scriptunit-fragment
----------

var x: u32 = 0
var done: bool = false
loop
    if done
        break
    end if
    if x == 0
        set x = 10
    end if
    if x == 10
        set x = 20
    end if
    if x == 20
        set x = 30
        set done = true
    end if
end loop
debuglog x
