// A set holds each element once and a map holds each key once, however the
// literal was written.
//
// Both were built by sorting what the literal named and handing the run to a
// bulk builder, which takes the run as given. Two equal elements written out
// both went in, and the set came back holding a duplicate -- which is not a
// set. Inserting one at a time is what knows an element is already there, and
// what lets go of the one it did not take.
//
// The empty-aggregate cases are here too, for a descriptor with nothing to
// point at: it leaves the pointer null rather than inventing an address, and
// reading a run of no elements through it has to answer without looking.

let repeated_keys: %{bool = u32} = %{false = : u32 / 118, false = : u32 / 75,
                                     true = : u32 / 41}
let repeated_numbers: %{u32 = u32} = %{: u32 / 1 = : u32 / 10, : u32 / 1 = : u32 / 20}
// A key whose duplicate has to be let go of rather than merely skipped.
let repeated_strings: %{string = u32} = %{"a" = : u32 / 1, "a" = : u32 / 2}

let repeated_elements: #{u32} = #{: u32 / 1, : u32 / 1, : u32 / 2}
let repeated_words: #{string} = #{"a", "a", "b"}

// Written out of order, to show the sort still happens.
let unsorted: #{u32} = #{: u32 / 9, : u32 / 2, : u32 / 5}
let unsorted_map: %{u32 = string} = %{: u32 / 9 = "nine", : u32 / 2 = "two"}

let nothing_in_them: (#{u32}, %{u32 = u32}) = (#{}, %{})

// An aggregate with no members, whose descriptor has no array to point at.
let empty_struct: {} = {}
let empty_tuple: () = ()
let empty_in_a_list: [{}] = [{}, {}]
let empty_in_an_option: ?{} = some {}

let output = (repeated_keys, repeated_numbers, repeated_strings,
              repeated_elements, repeated_words, unsorted, unsorted_map,
              nothing_in_them, empty_struct, empty_tuple, empty_in_a_list,
              empty_in_an_option)
