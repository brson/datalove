require module sys/std/i32

import i32.min_value
import i32.max_value
import i32.bits
import i32.signum
import i32.is_positive
import i32.is_negative
import i32.abs
import i32.abs_checked
import i32.abs_saturating
import i32.bitnot
import i32.bitand
import i32.bitor
import i32.bitxor
import i32.count_ones
import i32.count_zeros
import i32.leading_zeros
import i32.trailing_zeros
import i32.leading_ones
import i32.trailing_ones
import i32.cast_unsigned
import i32.neg_checked
import i32.add_checked
import i32.sub_checked
import i32.mul_checked
import i32.div_checked
import i32.rem_checked
import i32.add_saturating
import i32.sub_saturating
import i32.mul_saturating
import i32.neg_wrapping
import i32.add_wrapping
import i32.sub_wrapping
import i32.mul_wrapping
import i32.shift_left
import i32.shift_right
import i32.shift_left_wrapping
import i32.shift_right_wrapping
import i32.rotate_left
import i32.rotate_right
import i32.swap_bytes
import i32.reverse_bits
import i32.is_zero
import i32.min
import i32.max
import i32.clamp
import i32.abs_diff
import i32.midpoint

// Constants.
let min_v = min_value()
let max_v = max_value()
let bits_v = bits()

// Sign functions.
let sig_pos = signum(42)
let sig_neg = signum(: i32 / -42)
let sig_zero = signum(0)
let pos_check = is_positive(42)
let neg_check = is_negative(: i32 / -42)
let zero_pos = is_positive(0)
let zero_neg = is_negative(0)

// Abs.
let abs_pos = abs(42)
let abs_neg = abs(: i32 / -42)
let abs_min = abs(min_value())
let abs_chk_pos = abs_checked(42)
let abs_chk_neg = abs_checked(: i32 / -42)
let abs_chk_min = abs_checked(min_value())
let abs_sat_min = abs_saturating(min_value())

// Bitwise.
let not_val = bitnot(0)
let and_val = bitand(255, 15)
let or_val = bitor(240, 15)
let xor_val = bitxor(255, 15)

// Bit counting.
let ones = count_ones(255)
let zeros = count_zeros(255)
let lz = leading_zeros(1)
let tz = trailing_zeros(256)
let lo = leading_ones(: i32 / -1)
let to = trailing_ones(: i32 / -2)

// Type conversion.
let cast_pos = cast_unsigned(42)
let cast_neg = cast_unsigned(: i32 / -1)

// Checked arithmetic.
let neg_chk = neg_checked(42)
let neg_chk_min = neg_checked(min_value())
let add_chk = add_checked(100, 200)
let add_chk_ovf = add_checked(max_value(), 1)
let sub_chk = sub_checked(100, 50)
let sub_chk_unf = sub_checked(min_value(), 1)
let mul_chk = mul_checked(100, 100)
let mul_chk_ovf = mul_checked(max_value(), 2)
let div_chk = div_checked(100, 10)
let div_chk_zero = div_checked(100, 0)
let rem_chk = rem_checked(17, 5)
let rem_chk_zero = rem_checked(17, 0)
let rem_chk_neg = rem_checked(: i32 / -17, 5)

// Saturating arithmetic.
let add_sat = add_saturating(max_value(), 100)
let add_sat_neg = add_saturating(min_value(), : i32 / -100)
let sub_sat = sub_saturating(min_value(), 100)
let sub_sat_pos = sub_saturating(max_value(), : i32 / -100)
let mul_sat = mul_saturating(max_value(), 2)
let mul_sat_neg = mul_saturating(max_value(), : i32 / -2)

// Wrapping arithmetic.
let neg_wrap = neg_wrapping(min_value())
let add_wrap = add_wrapping(max_value(), 1)
let sub_wrap = sub_wrapping(min_value(), 1)
let mul_wrap = mul_wrapping(max_value(), 2)

// Shifts.
let shl = shift_left(1, 4)
let shr_pos = shift_right(16, 2)
let shr_neg = shift_right(: i32 / -16, 2)
let shl_ovf = shift_left(1, 32)
let shr_ovf = shift_right(1, 32)
let shl_wrap = shift_left_wrapping(1, 36)
let shr_wrap = shift_right_wrapping(: i32 / -16, 36)

// Rotations.
let rotl = rotate_left(1, 4)
let rotr = rotate_right(16, 4)

// Byte manipulation.
let swapped = swap_bytes(256)
let reversed = reverse_bits(1)

// Comparisons.
let is_z = is_zero(0)
let min_v2 = min(10, : i32 / -10)
let max_v2 = max(10, : i32 / -10)
let clamped = clamp(: i32 / -50, : i32 / -10, 10)
let adiff = abs_diff(10, : i32 / -10)
let mid = midpoint(10, 20)
let mid_neg = midpoint(: i32 / -10, : i32 / -20)

let output = (
  min_v, max_v, bits_v,
  sig_pos, sig_neg, sig_zero,
  pos_check, neg_check, zero_pos, zero_neg,
  abs_pos, abs_neg, abs_min,
  abs_chk_pos, abs_chk_neg, abs_chk_min, abs_sat_min,
  not_val, and_val, or_val, xor_val,
  ones, zeros, lz, tz, lo, to,
  cast_pos, cast_neg,
  neg_chk, neg_chk_min,
  add_chk, add_chk_ovf,
  sub_chk, sub_chk_unf,
  mul_chk, mul_chk_ovf,
  div_chk, div_chk_zero,
  rem_chk, rem_chk_zero, rem_chk_neg,
  add_sat, add_sat_neg, sub_sat, sub_sat_pos, mul_sat, mul_sat_neg,
  neg_wrap, add_wrap, sub_wrap, mul_wrap,
  shl, shr_pos, shr_neg, shl_ovf, shr_ovf, shl_wrap, shr_wrap,
  rotl, rotr,
  swapped, reversed,
  is_z, min_v2, max_v2, clamped, adiff, mid, mid_neg
)
