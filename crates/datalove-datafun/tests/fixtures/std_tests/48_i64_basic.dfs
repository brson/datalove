require module sys/std/i64

import i64.min_value
import i64.max_value
import i64.bits
import i64.signum
import i64.is_positive
import i64.is_negative
import i64.abs
import i64.abs_checked
import i64.abs_saturating
import i64.bitnot
import i64.bitand
import i64.bitor
import i64.bitxor
import i64.count_ones
import i64.count_zeros
import i64.leading_zeros
import i64.trailing_zeros
import i64.leading_ones
import i64.trailing_ones
import i64.cast_unsigned
import i64.neg_checked
import i64.add_checked
import i64.sub_checked
import i64.mul_checked
import i64.div_checked
import i64.rem_checked
import i64.add_saturating
import i64.sub_saturating
import i64.mul_saturating
import i64.neg_wrapping
import i64.add_wrapping
import i64.sub_wrapping
import i64.mul_wrapping
import i64.shift_left
import i64.shift_right
import i64.shift_left_wrapping
import i64.shift_right_wrapping
import i64.rotate_left
import i64.rotate_right
import i64.swap_bytes
import i64.reverse_bits
import i64.is_zero
import i64.min
import i64.max
import i64.clamp
import i64.abs_diff
import i64.midpoint

// Constants.
let min_v = min_value()
let max_v = max_value()
let bits_v = bits()

// Sign functions.
let sig_pos = signum(42)
let sig_neg = signum(: i64 / -42)
let sig_zero = signum(0)
let pos_check = is_positive(42)
let neg_check = is_negative(: i64 / -42)
let zero_pos = is_positive(0)
let zero_neg = is_negative(0)

// Abs.
let abs_pos = abs(42)
let abs_neg = abs(: i64 / -42)
let abs_min = abs(min_value())
let abs_chk_pos = abs_checked(42)
let abs_chk_neg = abs_checked(: i64 / -42)
let abs_chk_min = abs_checked(min_value())
let abs_sat_min = abs_saturating(min_value())

// Bitwise.
let not_val = bitnot(0)
let and_val = bitand(255, 15)
let or_val = bitor(240, 15)
let xor_val = bitxor(255, 15)

// Bit counting.
let ones = count_ones(255)
let zeros = count_zeros(255)
let lz = leading_zeros(1)
let tz = trailing_zeros(256)
let lo = leading_ones(: i64 / -1)
let to = trailing_ones(: i64 / -2)

// Type conversion.
let cast_pos = cast_unsigned(42)
let cast_neg = cast_unsigned(: i64 / -1)

// Checked arithmetic.
let neg_chk = neg_checked(42)
let neg_chk_min = neg_checked(min_value())
let add_chk = add_checked(1000000000000, 2000000000000)
let add_chk_ovf = add_checked(max_value(), 1)
let sub_chk = sub_checked(1000000000000, 500000000000)
let sub_chk_unf = sub_checked(min_value(), 1)
let mul_chk = mul_checked(1000000, 1000000)
let mul_chk_ovf = mul_checked(max_value(), 2)
let div_chk = div_checked(1000000000000, 1000)
let div_chk_zero = div_checked(1000, 0)
let rem_chk = rem_checked(17, 5)
let rem_chk_zero = rem_checked(17, 0)
let rem_chk_neg = rem_checked(: i64 / -17, 5)

// Saturating arithmetic.
let add_sat = add_saturating(max_value(), 10000)
let add_sat_neg = add_saturating(min_value(), : i64 / -10000)
let sub_sat = sub_saturating(min_value(), 10000)
let sub_sat_pos = sub_saturating(max_value(), : i64 / -10000)
let mul_sat = mul_saturating(max_value(), 2)
let mul_sat_neg = mul_saturating(max_value(), : i64 / -2)

// Wrapping arithmetic.
let neg_wrap = neg_wrapping(min_value())
let add_wrap = add_wrapping(max_value(), 1)
let sub_wrap = sub_wrapping(min_value(), 1)
let mul_wrap = mul_wrapping(max_value(), 2)

// Shifts.
let shl = shift_left(1, 32)
let shr_pos = shift_right(4294967296, 16)
let shr_neg = shift_right(: i64 / -4294967296, 16)
let shl_ovf = shift_left(1, 64)
let shr_ovf = shift_right(1, 64)
let shl_wrap = shift_left_wrapping(1, 68)
let shr_wrap = shift_right_wrapping(: i64 / -4294967296, 68)

// Rotations.
let rotl = rotate_left(1, 32)
let rotr = rotate_right(4294967296, 32)

// Byte manipulation.
let swapped = swap_bytes(256)
let reversed = reverse_bits(1)

// Comparisons.
let is_z = is_zero(0)
let min_v2 = min(1000, : i64 / -1000)
let max_v2 = max(1000, : i64 / -1000)
let clamped = clamp(: i64 / -5000, : i64 / -1000, 1000)
let adiff = abs_diff(1000, : i64 / -1000)
let mid = midpoint(1000, 2000)
let mid_neg = midpoint(: i64 / -1000, : i64 / -2000)

let output = (
  min_v, max_v, bits_v,
  sig_pos, sig_neg, sig_zero,
  pos_check, neg_check, zero_pos, zero_neg,
  abs_pos, abs_neg, abs_min,
  abs_chk_pos, abs_chk_neg, abs_chk_min, abs_sat_min,
  not_val, and_val, or_val, xor_val,
  ones, zeros, lz, tz, lo, to,
  cast_pos, cast_neg,
  neg_chk, neg_chk_min,
  add_chk, add_chk_ovf,
  sub_chk, sub_chk_unf,
  mul_chk, mul_chk_ovf,
  div_chk, div_chk_zero,
  rem_chk, rem_chk_zero, rem_chk_neg,
  add_sat, add_sat_neg, sub_sat, sub_sat_pos, mul_sat, mul_sat_neg,
  neg_wrap, add_wrap, sub_wrap, mul_wrap,
  shl, shr_pos, shr_neg, shl_ovf, shr_ovf, shl_wrap, shr_wrap,
  rotl, rotr,
  swapped, reversed,
  is_z, min_v2, max_v2, clamped, adiff, mid, mid_neg
)
