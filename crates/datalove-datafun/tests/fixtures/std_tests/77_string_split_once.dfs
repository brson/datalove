require module sys/std/string

import string.split_once
import string.rsplit_once

let a = split_once(ref "hello=world", ref "=")
let b = split_once(ref "no delimiter here", ref "=")
let c = split_once(ref "a::b::c", ref "::")
let d = rsplit_once(ref "a::b::c", ref "::")
let e = rsplit_once(ref "no delimiter", ref "::")

let output = (a, b, c, d, e)
