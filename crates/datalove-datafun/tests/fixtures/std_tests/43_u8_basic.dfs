require module sys/std/u8

import u8.min_value
import u8.max_value
import u8.bits
import u8.bitnot
import u8.bitand
import u8.bitor
import u8.bitxor
import u8.count_ones
import u8.count_zeros
import u8.leading_zeros
import u8.trailing_zeros
import u8.leading_ones
import u8.trailing_ones
import u8.is_power_of_two
import u8.ilog2
import u8.reverse_bits
import u8.cast_signed
import u8.add_checked
import u8.sub_checked
import u8.mul_checked
import u8.div_checked
import u8.rem_checked
import u8.add_saturating
import u8.sub_saturating
import u8.mul_saturating
import u8.add_wrapping
import u8.sub_wrapping
import u8.mul_wrapping
import u8.shift_left
import u8.shift_right
import u8.shift_left_wrapping
import u8.shift_right_wrapping
import u8.rotate_left
import u8.rotate_right
import u8.is_zero
import u8.min
import u8.max
import u8.clamp
import u8.abs_diff
import u8.midpoint

// Constants.
let min_v = min_value()
let max_v = max_value()
let bits_v = bits()

// Bitwise.
let not_val = bitnot(0)
let and_val = bitand(255, 15)
let or_val = bitor(240, 15)
let xor_val = bitxor(255, 15)

// Bit counting.
let ones = count_ones(255)
let zeros = count_zeros(255)
let lz = leading_zeros(1)
let tz = trailing_zeros(128)
let lo = leading_ones(255)
let to = trailing_ones(254)

// Power of two.
let is_pow2 = is_power_of_two(16)
let not_pow2 = is_power_of_two(15)
let log2_16 = ilog2(16)
let log2_0 = ilog2(0)

// Bit manipulation.
let reversed = reverse_bits(1)

// Type conversion.
let cast_v = cast_signed(128)

// Checked arithmetic.
let add_chk = add_checked(100, 50)
let add_chk_ovf = add_checked(200, 100)
let sub_chk = sub_checked(100, 50)
let sub_chk_unf = sub_checked(50, 100)
let mul_chk = mul_checked(10, 20)
let mul_chk_ovf = mul_checked(100, 10)
let div_chk = div_checked(100, 10)
let div_chk_zero = div_checked(100, 0)
let rem_chk = rem_checked(17, 5)
let rem_chk_zero = rem_checked(17, 0)

// Saturating arithmetic.
let add_sat = add_saturating(200, 100)
let sub_sat = sub_saturating(50, 100)
let mul_sat = mul_saturating(100, 10)

// Wrapping arithmetic.
let add_wrap = add_wrapping(200, 100)
let sub_wrap = sub_wrapping(50, 100)
let mul_wrap = mul_wrapping(100, 10)

// Shifts.
let shl = shift_left(1, 4)
let shr = shift_right(128, 4)
let shl_ovf = shift_left(1, 8)
let shr_ovf = shift_right(1, 8)
let shl_wrap = shift_left_wrapping(1, 10)
let shr_wrap = shift_right_wrapping(128, 10)

// Rotations.
let rotl = rotate_left(1, 4)
let rotr = rotate_right(16, 4)

// Comparisons.
let is_z = is_zero(0)
let min_v2 = min(10, 20)
let max_v2 = max(10, 20)
let clamped = clamp(50, 10, 30)
let adiff = abs_diff(10, 30)
let mid = midpoint(10, 20)

let output = (
  min_v, max_v, bits_v,
  not_val, and_val, or_val, xor_val,
  ones, zeros, lz, tz, lo, to,
  is_pow2, not_pow2, log2_16, log2_0,
  reversed,
  cast_v,
  add_chk, add_chk_ovf,
  sub_chk, sub_chk_unf,
  mul_chk, mul_chk_ovf,
  div_chk, div_chk_zero,
  rem_chk, rem_chk_zero,
  add_sat, sub_sat, mul_sat,
  add_wrap, sub_wrap, mul_wrap,
  shl, shr, shl_ovf, shr_ovf, shl_wrap, shr_wrap,
  rotl, rotr,
  is_z, min_v2, max_v2, clamped, adiff, mid
)
