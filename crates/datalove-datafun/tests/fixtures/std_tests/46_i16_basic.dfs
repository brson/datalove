require module sys/std/i16

import i16.min_value
import i16.max_value
import i16.bits
import i16.signum
import i16.is_positive
import i16.is_negative
import i16.abs
import i16.abs_checked
import i16.abs_saturating
import i16.bitnot
import i16.bitand
import i16.bitor
import i16.bitxor
import i16.count_ones
import i16.count_zeros
import i16.leading_zeros
import i16.trailing_zeros
import i16.leading_ones
import i16.trailing_ones
import i16.cast_unsigned
import i16.neg_checked
import i16.add_checked
import i16.sub_checked
import i16.mul_checked
import i16.div_checked
import i16.rem_checked
import i16.add_saturating
import i16.sub_saturating
import i16.mul_saturating
import i16.neg_wrapping
import i16.add_wrapping
import i16.sub_wrapping
import i16.mul_wrapping
import i16.shift_left
import i16.shift_right
import i16.shift_left_wrapping
import i16.shift_right_wrapping
import i16.rotate_left
import i16.rotate_right
import i16.swap_bytes
import i16.reverse_bits
import i16.is_zero
import i16.min
import i16.max
import i16.clamp
import i16.abs_diff
import i16.midpoint

// Constants.
let min_v = min_value()
let max_v = max_value()
let bits_v = bits()

// Sign functions.
let sig_pos = signum(42)
let sig_neg = signum(: i16 / -42)
let sig_zero = signum(0)
let pos_check = is_positive(42)
let neg_check = is_negative(: i16 / -42)
let zero_pos = is_positive(0)
let zero_neg = is_negative(0)

// Abs.
let abs_pos = abs(42)
let abs_neg = abs(: i16 / -42)
let abs_min = abs(min_value())
let abs_chk_pos = abs_checked(42)
let abs_chk_neg = abs_checked(: i16 / -42)
let abs_chk_min = abs_checked(min_value())
let abs_sat_min = abs_saturating(min_value())

// Bitwise.
let not_val = bitnot(0)
let and_val = bitand(255, 15)
let or_val = bitor(240, 15)
let xor_val = bitxor(255, 15)

// Bit counting.
let ones = count_ones(255)
let zeros = count_zeros(255)
let lz = leading_zeros(1)
let tz = trailing_zeros(256)
let lo = leading_ones(: i16 / -1)
let to = trailing_ones(: i16 / -2)

// Type conversion.
let cast_pos = cast_unsigned(42)
let cast_neg = cast_unsigned(: i16 / -1)

// Checked arithmetic.
let neg_chk = neg_checked(42)
let neg_chk_min = neg_checked(min_value())
let add_chk = add_checked(10000, 20000)
let add_chk_ovf = add_checked(max_value(), 1)
let sub_chk = sub_checked(10000, 5000)
let sub_chk_unf = sub_checked(min_value(), 1)
let mul_chk = mul_checked(100, 100)
let mul_chk_ovf = mul_checked(max_value(), 2)
let div_chk = div_checked(1000, 10)
let div_chk_zero = div_checked(1000, 0)
let rem_chk = rem_checked(17, 5)
let rem_chk_zero = rem_checked(17, 0)
let rem_chk_neg = rem_checked(: i16 / -17, 5)

// Saturating arithmetic.
let add_sat = add_saturating(max_value(), 10000)
let add_sat_neg = add_saturating(min_value(), : i16 / -10000)
let sub_sat = sub_saturating(min_value(), 10000)
let sub_sat_pos = sub_saturating(max_value(), : i16 / -10000)
let mul_sat = mul_saturating(max_value(), 2)
let mul_sat_neg = mul_saturating(max_value(), : i16 / -2)

// Wrapping arithmetic.
let neg_wrap = neg_wrapping(min_value())
let add_wrap = add_wrapping(max_value(), 1)
let sub_wrap = sub_wrapping(min_value(), 1)
let mul_wrap = mul_wrapping(max_value(), 2)

// Shifts.
let shl = shift_left(1, 8)
let shr_pos = shift_right(256, 4)
let shr_neg = shift_right(: i16 / -256, 4)
let shl_ovf = shift_left(1, 16)
let shr_ovf = shift_right(1, 16)
let shl_wrap = shift_left_wrapping(1, 20)
let shr_wrap = shift_right_wrapping(: i16 / -256, 20)

// Rotations.
let rotl = rotate_left(1, 8)
let rotr = rotate_right(256, 8)

// Byte manipulation.
let swapped = swap_bytes(256)
let reversed = reverse_bits(1)

// Comparisons.
let is_z = is_zero(0)
let min_v2 = min(100, : i16 / -100)
let max_v2 = max(100, : i16 / -100)
let clamped = clamp(: i16 / -500, : i16 / -100, 100)
let adiff = abs_diff(100, : i16 / -100)
let mid = midpoint(100, 200)
let mid_neg = midpoint(: i16 / -100, : i16 / -200)

let output = (
  min_v, max_v, bits_v,
  sig_pos, sig_neg, sig_zero,
  pos_check, neg_check, zero_pos, zero_neg,
  abs_pos, abs_neg, abs_min,
  abs_chk_pos, abs_chk_neg, abs_chk_min, abs_sat_min,
  not_val, and_val, or_val, xor_val,
  ones, zeros, lz, tz, lo, to,
  cast_pos, cast_neg,
  neg_chk, neg_chk_min,
  add_chk, add_chk_ovf,
  sub_chk, sub_chk_unf,
  mul_chk, mul_chk_ovf,
  div_chk, div_chk_zero,
  rem_chk, rem_chk_zero, rem_chk_neg,
  add_sat, add_sat_neg, sub_sat, sub_sat_pos, mul_sat, mul_sat_neg,
  neg_wrap, add_wrap, sub_wrap, mul_wrap,
  shl, shr_pos, shr_neg, shl_ovf, shr_ovf, shl_wrap, shr_wrap,
  rotl, rotr,
  swapped, reversed,
  is_z, min_v2, max_v2, clamped, adiff, mid, mid_neg
)
