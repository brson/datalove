require module sys/std/string

import string.contains
import string.starts_with
import string.ends_with

let s = "hello world"

let output = (contains(ref s, ref "world"), contains(ref s, ref "xyz"), starts_with(ref s, ref "hello"), starts_with(ref s, ref "world"), ends_with(ref s, ref "world"), ends_with(ref s, ref "hello"))
