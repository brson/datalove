require module sys/std/list

import list.len
import list.is_empty
import list.get
import list.push
import list.pop

// One compiled function each, serving both element types. The list is not
// converted on the way in: it is borrowed, and the descriptor saying what it
// holds comes from here, where the type is known.
let nums: [u32] = [10, 20, 30]
let strs: [string] = ["alpha", "beta"]
let empty: [u32] = []

let lens = (len(ref nums), len(ref strs), len(ref empty))
let empties = (is_empty(ref nums), is_empty(ref empty))

// An element crossing the generic boundary is carried as a data and moved back
// out at the call site, which is the place that knows the type.
let reads = (get(ref nums, (: index / 1)), get(ref strs, (: index / 0)))
let past_end = get(ref nums, (: index / 9))

var growing: [u32] = [1]
call push(mut growing, 2)
let grown = len(ref growing)

var words: [string] = ["first"]
call push(mut words, "second")
let taken = pop(mut words)
let left = len(ref words)

let output = (lens, empties, reads, past_end, grown, taken, left)
