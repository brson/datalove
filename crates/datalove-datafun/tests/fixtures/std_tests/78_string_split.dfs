require module sys/std/string

import string.split
import string.lines
import string.split_whitespace
import string.concat
import string.from_char

let a = split(ref "hello world foo", ref " ")
let b = split(ref "a::b::c", ref "::")
let c = split(ref "no-delim", ref ",")

// Build a string with actual newlines via from_char(10).
let nl = from_char(10)
let multiline = concat(ref concat(ref concat(ref concat(ref "line1", ref nl), ref "line2"), ref nl), ref "line3")
let d = lines(ref multiline)
let e = lines(ref "single")

let f = split_whitespace(ref "  hello   world  ")
let g = split_whitespace(ref "")
let h = split(ref "", ref ",")

let output = (a, b, c, d, e, f, g, h)
