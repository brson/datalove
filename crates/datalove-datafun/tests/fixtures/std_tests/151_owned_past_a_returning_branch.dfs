// A branch that returns does not have to agree with the one that falls through
// about what it moved.
//
// Ownership merged an `if` by comparing the two branches' states and refusing a
// binding moved in one and not the other, which a branch that returns is bound
// to be: returning drops everything live, so every owned binding came out of
// the then branch moved and out of the fall-through live. That made a guard
// clause -- the first shape here -- an error for any owned value in scope, and
// refused a recursive function over `int` outright, which is the last one.
//
// A `ret` is the only exit this holds for. `break` and `continue` rejoin the
// program and what they moved is still given away where they land, so they are
// not merged around; see `botdocs/issues.md`.
//
// Every one of these hands back the owned parameter on the path that keeps it,
// so a drop gone wrong shows up as a wrong answer rather than only as a leak.

// A guard clause, with an owned parameter live at the `ret`.
fun guard(s: string, n: u32): string
  if n == 0
    ret "guarded"
  end if
  ret s
end fun

// The returning branch gives the parameter away. The path that falls through
// still has it, and each path drops it exactly once.
fun moves_then_returns(s: string, n: u32): string
  if n == 0
    let taken = s
    ret taken
  end if
  ret s
end fun

// Only the else returns, so the then branch is the one that merges.
fun else_returns(s: string, n: u32): string
  var tag = "fell through"
  if n == 0
    set tag = "then"
  else
    ret "else returned"
  end if
  ret s
end fun

// An inner `if` that returns both ways makes the outer branch return too.
fun nested(s: string, n: u32): string
  if n == 0
    if n == 0
      ret "inner one"
    else
      ret "inner two"
    end if
  end if
  ret s
end fun

// A match arm that returns is left out of the merge the same way.
type Side: enum { atom Left, atom Right }
fun match_arm(s: string, side: Side): string
  var tag = "none"
  match side
  case atom Left
    ret "left returned"
  case atom Right
    set tag = "right"
  end match
  ret s
end fun

// Recursion over a type that is not copy. `n` is dropped before the `ret 1` and
// again on the way out of the multiply, once on each path.
fun factorial(n: int): int
  if n <= 1
    ret 1
  end if
  ret n * factorial(n - 1)
end fun

let output = (guard("kept a", 0), guard("kept b", 3),
              moves_then_returns("kept c", 0), moves_then_returns("kept d", 4),
              else_returns("kept e", 0), else_returns("kept f", 1),
              nested("kept g", 5), match_arm("kept h", atom Right),
              match_arm("kept i", atom Left), factorial(5), factorial(20))
