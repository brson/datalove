require module sys/std/option

import option.xor_option
import option.unwrap_or_zero

let some_a1: @?u32 = @10
let some_a2: @?u32 = @10
let some_b1: @?u32 = @20
let some_b2: @?u32 = @20
let none_val1: @?u32 = @none
let none_val2: @?u32 = @none
let none_val3: @?u32 = @none
let none_val4: @?u32 = @none

// Test all combinations and unwrap for comparison.
let output = (
  unwrap_or_zero(xor_option(some_a1, some_b1)),
  unwrap_or_zero(xor_option(some_a2, none_val1)),
  unwrap_or_zero(xor_option(none_val2, some_b2)),
  unwrap_or_zero(xor_option(none_val3, none_val4))
)
