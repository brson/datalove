require module sys/std/string

import string.strip_prefix
import string.strip_suffix

let s = "hello world"

fun has_string(opt: ?string): bool
  if opt |v|
    ret true
  end if
  ret false
end fun

let p1 = has_string(strip_prefix(ref s, ref "hello "))
let p2 = has_string(strip_prefix(ref s, ref "xyz"))
let s1 = has_string(strip_suffix(ref s, ref " world"))
let s2 = has_string(strip_suffix(ref s, ref "xyz"))

let output = (p1, p2, s1, s2)
