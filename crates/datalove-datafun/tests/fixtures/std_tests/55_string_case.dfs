require module sys/std/string

import string.to_ascii_lowercase
import string.to_ascii_uppercase

let a = "Hello World"
let b = "ABC 123"
let c = ""

let output = (to_ascii_lowercase(ref a), to_ascii_uppercase(ref a), to_ascii_lowercase(ref b), to_ascii_uppercase(ref b), to_ascii_lowercase(ref c), to_ascii_uppercase(ref c))
