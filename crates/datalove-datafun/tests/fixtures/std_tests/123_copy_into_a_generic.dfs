require module sys/std/list
require module sys/std/set

import list.push
import list.len
import set.insert

// Handing a copy value to a generic does not use it up.
//
// Whether an argument to a generic is given up is its descriptor's to say, and
// an `index`'s says it is copied. Taking it for a move marks the source gone,
// so the next read of it finds nothing: `push(mut l, i)` followed by anything
// that reads `i` again fails, which any counting loop does. The interpreter
// once did exactly that, where the lowering reads the counter back with
// `load.copy`.
//
// It wanted a function to show: the same code at script level was fine.

fun count_up(n: index): index
  var built: [index] = []
  var i: index = : index / 0
  loop while i .< n
    call push(mut built, i)
    set i = icall add_wrapping_index(i, : index / 1)
  end loop
  ret len(ref built)
end fun

// One push and one read after it, with no loop at all, which is the whole bug.
fun push_then_read(): index
  var built: [index] = []
  var i: index = : index / 5
  call push(mut built, i)
  ret i
end fun

// A set takes its element the same way.
fun count_up_set(n: index): index
  var built: #{index} = #{}
  var i: index = : index / 0
  loop while i .< n
    let added = insert(mut built, i)
    set i = icall add_wrapping_index(i, : index / 1)
  end loop
  ret i
end fun

// A copy that is not a scalar: a tuple of two of them.
fun push_a_tuple(): (u32, u32)
  var built: [(u32, u32)] = []
  let pair: (u32, u32) = (: u32 / 1, : u32 / 2)
  call push(mut built, pair)
  ret pair
end fun

let counted = count_up(: index / 4)
let read_back = push_then_read()
let counted_set = count_up_set(: index / 3)
let tuple_back = push_a_tuple()

let output = (counted, read_back, counted_set, tuple_back)
