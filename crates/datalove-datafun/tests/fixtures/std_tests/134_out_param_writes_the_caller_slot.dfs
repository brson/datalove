// An `out` parameter initializes the slot the caller passed.
//
// That is the whole of what `out` is for: the caller has storage with nothing
// in it yet, and the callee promises to write it before returning. The
// ownership pass tracked the write only when the argument was itself another
// `out` parameter being forwarded, which is the rare case. The usual argument
// is an uninitialized `var`, and for one of those the call was not counted as
// the write, so reading the slot afterwards was D005 -- leaving `out` working
// only where a value was already there and it was not needed.

fun fill(out n: u32)
  set n = 42
end fun

fun fill_string(out s: string)
  set s = "written"
end fun

// Forwarding one `out` into another, which is the case that always worked.
fun forward(out n: u32)
  call fill(out n)
end fun

fun in_a_function(): u32
  var slot: u32
  call fill(out slot)
  ret slot
end fun

fun forwarded(): u32
  var slot: u32
  call forward(out slot)
  ret slot
end fun

// A slot of a linear type, where the destination holds nothing to drop until
// the call writes it. Clearing the destination before the call is what the
// compiled backends do for whatever was there before, and for a slot that was
// never written there is nothing: cranelift freed its own 0xFF poison and the
// C backend freed whatever the stack had left.
fun heap_slot(): string
  var text: string
  call fill_string(out text)
  ret text
end fun

// The same, with nothing read afterwards, so the only thing that frees what
// the call wrote is the drop at the end of the scope. That drop asks the
// tracking byte, and the call has to have set it.
fun heap_slot_unread(): u32
  var text: string
  call fill_string(out text)
  ret 1
end fun

// At script level as well as inside a function.
var top_level: u32
call fill(out top_level)

let output = (in_a_function(), forwarded(), heap_slot(), heap_slot_unread(), top_level)
