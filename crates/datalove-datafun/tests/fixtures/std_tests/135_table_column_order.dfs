// A table holds its columns in the order they were written.
//
// The IR sorted them by name for a canonical layout, and nothing else did:
// datalit compares two table types column by column, the typechecker makes a
// literal's header match its type in order, and the cells are lowered left to
// right. So a table whose columns were not already alphabetical had every cell
// written at another column's offset, and a `string` under a `u32` read back
// as the low half of its own pointer.
//
// The cells are also moved into the table rather than cloned. Cloning left the
// row tuple holding a second copy that nothing would free, which the leak
// check at the end of the run reports.

// Written out of alphabetical order, which is the case that read back wrong.
let out_of_order: {| name: string, age: u32 |} = {| name, age; "Alice", 30; "Bob", 25 |}

// The same columns the other way round, which happened to work before.
let in_order: {| age: u32, name: string |} = {| age, name; 30, "Alice"; 25, "Bob" |}

// One heap column on its own, which is the shape that leaked without also
// reading back wrong.
let heap_only: {| name: string |} = {| name; "Alice"; "Bob" |}

// Fixed-width throughout, which neither bug reached.
let narrow: {| y: u32, x: u32 |} = {| y, x; 1, 2; 3, 4 |}

// More than two columns, so the offsets have somewhere to go wrong, and a heap
// column that is not a string.
let mixed: {| tag: string, n: u8, items: [u32], flag: bool |} = {| tag, n, items, flag; "first", 1, [: u32 / 10, : u32 / 20], true; "second", 2, [: u32 / 30], false |}

// Empty, where there is a header and no row to lay out.
let empty: {| name: string, age: u32 |} = {| name, age |}

let output = (out_of_order, in_order, heap_only, narrow, mixed, empty)
