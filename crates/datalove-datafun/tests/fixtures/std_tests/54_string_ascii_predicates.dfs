require module sys/std/string

import string.is_ascii_alphabetic
import string.is_ascii_digit
import string.is_ascii_alphanumeric
import string.is_ascii_whitespace

let output = (is_ascii_alphabetic("hello"), is_ascii_alphabetic("hello1"), is_ascii_alphabetic(""), is_ascii_digit("123"), is_ascii_digit("12a"), is_ascii_digit(""), is_ascii_alphanumeric("abc123"), is_ascii_alphanumeric("abc!"), is_ascii_whitespace("  "), is_ascii_whitespace(" a "))
