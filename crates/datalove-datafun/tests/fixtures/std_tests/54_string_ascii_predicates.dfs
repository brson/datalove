require module sys/std/string

import string.is_ascii_alphabetic
import string.is_ascii_digit
import string.is_ascii_alphanumeric
import string.is_ascii_whitespace

let output = (is_ascii_alphabetic(ref "hello"), is_ascii_alphabetic(ref "hello1"), is_ascii_alphabetic(ref ""), is_ascii_digit(ref "123"), is_ascii_digit(ref "12a"), is_ascii_digit(ref ""), is_ascii_alphanumeric(ref "abc123"), is_ascii_alphanumeric(ref "abc!"), is_ascii_whitespace(ref "  "), is_ascii_whitespace(ref " a "))
