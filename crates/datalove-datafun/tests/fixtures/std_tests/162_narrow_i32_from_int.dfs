require module sys/std/i32

import i32.from_int
import i32.from_int_wrapping

// Narrowing from int to i32. The plain form is none past either end of the
// range; the wrapping form keeps the low bits, as two's complement, so one past
// one end comes round to the other, and a value wider than 64 bits keeps its
// low bits too.

let max: int = 2147483647
let over: int = 2147483648
let min: int = -2147483648
let under: int = -2147483649
let huge: int = 1180591620717411303429
let neg_huge: int = -1180591620717411303429

let checked = (from_int(ref max), from_int(ref over), from_int(ref min), from_int(ref under), from_int(ref huge), from_int(ref neg_huge))
let wrapping = (from_int_wrapping(ref over), from_int_wrapping(ref under), from_int_wrapping(ref huge), from_int_wrapping(ref neg_huge))

let output = (checked, wrapping)
