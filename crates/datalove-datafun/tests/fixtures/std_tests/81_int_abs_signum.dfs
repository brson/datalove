require module sys/std/int

import int.abs
import int.abs_diff

let a = abs(42)
let b = abs(-42)
let c = abs(0)

// abs is total for int; there is no MIN to overflow on.
let d = abs(-99999999999999999999999999)

let e = abs_diff(10, 3)
let f = abs_diff(3, 10)
let g = abs_diff(5, 5)
let h = abs_diff(-10, 10)
let i = abs_diff(10, -10)

let output = (a, b, c, d, e, f, g, h, i)
