require module sys/std/set
require module sys/std/list

import set.len
import set.to_list
import set.union_with
import set.intersection_with
import set.difference_with
import set.is_subset_of

// A set walked, and the operations written over walking one.
//
// A `for` visits the elements in their own order, which is what a tree keeps
// them in, one leaf after another.

let names = #{"c", "a", "b"}
let numbers = #{3, 1, 2}

var walked: [string] = []
for name in ref names
  call list.push(mut walked, name@)
end for
let listed = to_list(ref names)
let listed_numbers = to_list(ref numbers)

let left = #{"x", "y", "z"}
let right = #{"y", "z", "w"}
let both = #{"y", "z"}

let joined = union_with(ref left, ref right)
let shared = intersection_with(ref left, ref right)
let only_left = difference_with(ref left, ref right)
let subset = (is_subset_of(ref both, ref left), is_subset_of(ref left, ref both))

// A set of an empty set is still an answer.
let empty: #{string} = #{}
let empty_listed = to_list(ref empty)
let empty_joined = union_with(ref empty, ref left)

let joined_len = len(ref joined)

let output = (walked, listed, listed_numbers,
              joined, shared, only_left, subset,
              empty_listed, empty_joined, joined_len)
