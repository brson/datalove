require module sys/std/list

import list.set
import list.insert
import list.remove
import list.reserve
import list.len
import list.first
import list.last

// Elements crossing the generic boundary in both directions, for a scalar and
// for a type that owns memory.
var nums: [u32] = [10, 20, 30]
let set_ok = set(mut nums, (: index / 1), (: u32 / 99))
let set_oob = set(mut nums, (: index / 9), (: u32 / 0))

var words: [string] = ["a", "c"]
let ins_ok = insert(mut words, (: index / 1), "b")
let ins_end = insert(mut words, (: index / 3), "d")
let ins_oob = insert(mut words, (: index / 99), "nope")

// Removing gives the element up, so what comes back owns what it holds.
let taken = remove(mut words, (: index / 0))
let taken_oob = remove(mut words, (: index / 50))

reserve(mut nums, (: index / 16))

let output = ((set_ok, set_oob), first(ref nums), last(ref nums),
              (ins_ok, ins_end, ins_oob),
              taken, taken_oob, len(ref words), first(ref words), last(ref words))
