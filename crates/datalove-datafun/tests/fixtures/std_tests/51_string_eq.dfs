require module sys/std/string

import string.eq
import string.cmp
import string.eq_ignore_ascii_case

let a = "hello"
let b = "hello"
let c = "world"
let d = "Hello"

let output = (eq(ref a, ref b), eq(ref a, ref c), cmp(ref a, ref c), cmp(ref c, ref a), cmp(ref a, ref b), eq_ignore_ascii_case(ref a, ref d))
