require module sys/std/list

import list.push
import list.len
import list.get

// A generic function handing its own type parameter to another generic
// function, written in a script rather than a module.
//
// The descriptor the inner call hands over is one the outer call received, so
// each level has to forward its own rather than work one out from the
// callee's signature, where a type parameter says nothing. A lost descriptor
// is silent: a wrong number for a `u32` and a fault for a `string`. Once they
// were also never passed to a script-local generic, and the jit's stub
// dropped them on the way to its dispatch.

fun push_through<T>(mut self: [T], elem: T)
  call push(mut self, elem)
end fun

// Two levels, so the second call forwards a parameter that reached it through
// the first rather than one the caller supplied directly.
fun push_through_twice<T>(mut self: [T], elem: T)
  call push_through(mut self, elem)
end fun

var numbers: [u32] = [1, 2, 3]
call push_through(mut numbers, 4)
call push_through_twice(mut numbers, 5)

let counted = len(ref numbers)
let last = get(ref numbers, 4)

// A move type, where a lost level faults rather than reading wrong.
var words: [string] = ["a"]
call push_through(mut words, "b")
call push_through_twice(mut words, "c")

// A borrowed collection forwarded on without anything being pushed, which is
// the descriptor travelling a second hop on its own.
fun count_through<T>(ref self: [T]): index
  ret len(ref self)
end fun

let counted_through = count_through(ref words)

let output = (numbers, counted, last, words, counted_through)
