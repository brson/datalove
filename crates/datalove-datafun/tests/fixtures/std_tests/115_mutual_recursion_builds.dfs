require module sys/std/list

import list.push
import list.len

// Generics calling each other where only one of them builds.
//
// Each takes one descriptor per type parameter, whatever its body builds, and
// passes its own on. Descriptors were once worked out per function by closing
// what each body built over its calls, which a cycle had to settle.
//
// `make_b` builds nothing and hands its type parameter to `make_a`, which
// does, and `make_a` calls back into `make_b`.

fun make_a<T>(x: T, n: u32): [T]
  if n == (: u32 / 0)
    var out: [T] = []
    call push(mut out, x)
    ret out
  else
    ret make_b(x, icall sub_wrapping_u32(n, : u32 / 1))
  end if
end fun

fun make_b<T>(x: T, n: u32): [T]
  ret make_a(x, n)
end fun

// A chain three deep, where only the far end builds.
fun outer<T>(x: T): [T]
  ret middle(x)
end fun

fun middle<T>(x: T): [T]
  ret inner(x)
end fun

fun inner<T>(x: T): [T]
  var out: [T] = []
  call push(mut out, x)
  ret out
end fun

let straight = make_a("z", : u32 / 0)
let bounced = make_a("z", : u32 / 5)
let numbers = make_a(: u32 / 9, : u32 / 4)
let chained = outer("through")
let chained_len = len(ref chained)

let output = (straight, bounced, numbers, chained, chained_len)
