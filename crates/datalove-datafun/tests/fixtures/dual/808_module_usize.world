----------
module local/test/usize_math
----------

fun add(a: usize, b: usize): usize
    ret a +! b
end fun

fun sub(a: usize, b: usize): usize
    ret a -! b
end fun

fun mul(a: usize, b: usize): usize
    ret a *! b
end fun

fun max_of(a: usize, b: usize): usize
    if a .>= b
        ret a
    else
        ret b
    end if
end fun

fun min_of(a: usize, b: usize): usize
    if a .<= b
        ret a
    else
        ret b
    end if
end fun

