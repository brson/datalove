scriptunit-fragment
----------

require module local/test/usize_math
import usize_math.add
import usize_math.sub
import usize_math.mul
import usize_math.max_of
import usize_math.min_of

let a: usize = (: usize / 100)
let b: usize = (: usize / 50)

debuglog add(a, b)
debuglog sub(a, b)
debuglog mul(a, b)
debuglog max_of(a, b)
debuglog min_of(a, b)
