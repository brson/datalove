----------
scriptunit-fragment
----------

let a: usize = (: usize / 0xFF00FF00)
let b: usize = (: usize / 0x0F0F0F0F)
let zero: usize = (: usize / 0)
let max: usize = (: usize / 0xFFFFFFFF)

// Bitwise NOT.
debuglog icall bitnot_usize(zero)
debuglog icall bitnot_usize(max)

// Bitwise AND.
debuglog icall bitand_usize(a, b)
debuglog icall bitand_usize(max, zero)

// Bitwise OR.
debuglog icall bitor_usize(a, b)
debuglog icall bitor_usize(zero, zero)

// Bitwise XOR.
debuglog icall bitxor_usize(a, b)
debuglog icall bitxor_usize(a, a)
