----------
scriptunit-fragment
----------

let pos: isize = (: isize / 42)
let neg: isize = (: isize / -42)
let zero: isize = (: isize / 0)
let max: isize = (: isize / 2147483647)
let min: isize = (: isize / -2147483648)

// Negate positive.
debuglog icall neg_wrapping_isize(pos)

// Negate negative.
debuglog icall neg_wrapping_isize(neg)

// Negate zero.
debuglog icall neg_wrapping_isize(zero)

// Negate max (becomes min + 1).
debuglog icall neg_wrapping_isize(max)

// Negate min (wraps to min due to two's complement).
debuglog icall neg_wrapping_isize(min)
