require module local/test/utils
import utils.add_one
import utils.add_two

fun process(x: u32, flag: bool): !u32
    if flag
        ret add_two(x)
    end if
    ret add_one(x)
end fun

debuglog process(4, true)
debuglog process(5, false)
debuglog process(10, true)
