// List index with ? — in-bounds returns the element.
fun get_elem(a: [u32], i: index): ?u32
    ret some (a[i]?)
end fun

debuglog get_elem([10, 20, 30], (: index / 0))
debuglog get_elem([10, 20, 30], (: index / 1))
debuglog get_elem([10, 20, 30], (: index / 2))
