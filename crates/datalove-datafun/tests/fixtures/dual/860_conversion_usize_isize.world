// usize to isize.
let u_zero: usize = (: usize / 0)
let u_one: usize = (: usize / 1)
let u_max: usize = (: usize / 4294967295)
let u_half: usize = (: usize / 2147483647)

debuglog icall usize_to_isize(u_zero)
debuglog icall usize_to_isize(u_one)
debuglog icall usize_to_isize(u_half)
debuglog icall usize_to_isize(u_max)

// isize to usize.
let i_zero: isize = (: isize / 0)
let i_one: isize = (: isize / 1)
let i_neg: isize = (: isize / -1)
let i_max: isize = (: isize / 2147483647)
let i_min: isize = (: isize / -2147483648)

debuglog icall isize_to_usize(i_zero)
debuglog icall isize_to_usize(i_one)
debuglog icall isize_to_usize(i_neg)
debuglog icall isize_to_usize(i_max)
debuglog icall isize_to_usize(i_min)
