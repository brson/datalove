----------
scriptunit-fragment
----------

fun unwrap_isize(opt: ?isize, default: isize): isize
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_add(a: isize, b: isize): ?isize
    ret some (a +? b)
end fun

fun checked_sub(a: isize, b: isize): ?isize
    ret some (a -? b)
end fun

fun checked_div(a: isize, b: isize): ?isize
    ret some (a /? b)
end fun

let max: isize = (: isize / 2147483647)
let min: isize = (: isize / -2147483648)
let one: isize = (: isize / 1)
let zero: isize = (: isize / 0)

// Add overflow returns none.
debuglog unwrap_isize(checked_add(max, one), (: isize / 999))

// Sub underflow returns none.
debuglog unwrap_isize(checked_sub(min, one), (: isize / 999))

// Div by zero returns none.
debuglog unwrap_isize(checked_div(one, zero), (: isize / 999))
