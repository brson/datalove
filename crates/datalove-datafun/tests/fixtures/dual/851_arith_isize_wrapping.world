----------
scriptunit-fragment
----------

let a: isize = (: isize / 10)
let b: isize = (: isize / 5)
let c: isize = (: isize / -3)

// Basic wrapping arithmetic.
debuglog (a +! b)
debuglog (a -! b)
debuglog (a *! c)

// With negative numbers.
debuglog (c +! c)
debuglog (c -! a)
debuglog (c *! c)

// Wrapping overflow.
let max: isize = (: isize / 2147483647)
let one: isize = (: isize / 1)
debuglog (max +! one)

// Wrapping underflow.
let min: isize = (: isize / -2147483648)
debuglog (min -! one)
