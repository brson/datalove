// Set tuple field of a list element: set a[i]?.0 and set a[i]?.1.
fun set_elem_first(a: [(u32, u32)], i: index, v: u32): ?[(u32, u32)]
    var b = a
    set b[i]?.0 = v
    ret some b
end fun

fun set_elem_second(a: [(u32, u32)], i: index, v: u32): ?[(u32, u32)]
    var b = a
    set b[i]?.1 = v
    ret some b
end fun

debuglog set_elem_first([(1, 2), (3, 4)], (: index / 0), 99)
debuglog set_elem_second([(1, 2), (3, 4)], (: index / 1), 77)
