----------
scriptunit-fragment
----------

// Each name takes ownership of its element, and drops it on its own.
let (a, b) = ("x", ["y", "z"])
debuglog a
debuglog b

// A one-element tuple needs its trailing comma.
let (c,) = ("c",)
debuglog c

// The unit pattern binds nothing.
let () = ()

// A hint applies to the whole value.
let (n, m): (u32, i64) = (1, 2)
debuglog (n, m)

// Taking apart a binding consumes it.
let pair = (some "p", ok [1, 2])
let (o, r) = pair
debuglog (o, r)

// A const is borrowed wherever it is named, so taking one apart takes a clone,
// and it can be taken apart twice.
const PAIR: (int, int) = (: int / 10, : int / 20)
let (p1, p2) = PAIR@
let (p3, p4) = PAIR@
debuglog (p1, p2, p3, p4)
