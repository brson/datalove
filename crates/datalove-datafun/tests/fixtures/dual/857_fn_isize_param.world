----------
scriptunit-fragment
----------

fun add_isize(a: isize, b: isize): isize
    let a_u = icall isize_to_usize(a)
    let b_u = icall isize_to_usize(b)
    ret icall usize_to_isize(icall add_wrapping_usize(a_u, b_u))
end fun

fun abs_isize(n: isize): isize
    let zero: isize = (: isize / 0)
    if n .< zero
        ret icall neg_wrapping_isize(n)
    else
        ret n
    end if
end fun

fun signum_isize(n: isize): isize
    let zero: isize = (: isize / 0)
    let one: isize = (: isize / 1)
    let neg_one: isize = (: isize / -1)
    if n .> zero
        ret one
    else
        if n .< zero
            ret neg_one
        else
            ret zero
        end if
    end if
end fun

debuglog add_isize((: isize / 100), (: isize / -50))
debuglog abs_isize((: isize / -42))
debuglog abs_isize((: isize / 42))
debuglog signum_isize((: isize / 10))
debuglog signum_isize((: isize / -10))
debuglog signum_isize((: isize / 0))
