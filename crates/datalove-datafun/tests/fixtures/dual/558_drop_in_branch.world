// Test that values are dropped in if-else branches.
fun test_branch(cond: bool): u32
    let s: string = "test string"
    if cond
        let _sink = s
        ret @1
    else
        let _sink2 = s
        ret @0
    end if
end fun

debuglog test_branch(true)
debuglog test_branch(false)
