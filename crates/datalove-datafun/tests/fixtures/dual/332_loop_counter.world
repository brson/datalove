----------
scriptunit-fragment
----------

var x: u32 = 0
var done: bool = false
loop
    if done
        break
    end if
    if x ≡ :u32/0
        set x = :u32/10
    end if
    if x ≡ :u32/10
        set x = :u32/20
    end if
    if x ≡ :u32/20
        set x = :u32/30
        set done = true
    end if
end loop
debuglog x
