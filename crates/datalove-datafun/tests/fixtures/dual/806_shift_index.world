----------
scriptunit-fragment
----------

let a: index = (: index / 1)
let b: index = (: index / 0x80000000)
let mid: index = (: index / 0x00FF0000)

// Shift left.
debuglog icall shl_index(a, 0)
debuglog icall shl_index(a, 4)
debuglog icall shl_index(a, 31)

// Shift right (logical).
debuglog icall shr_index(b, 0)
debuglog icall shr_index(b, 4)
debuglog icall shr_index(b, 31)

// Combined shifts.
debuglog icall shr_index(icall shl_index(mid, 8), 8)
