scriptunit-fragment
----------

require module local/test/isize_math
import isize_math.add
import isize_math.sub
import isize_math.mul
import isize_math.negate
import isize_math.max_of
import isize_math.min_of

let a: isize = (: isize / 100)
let b: isize = (: isize / -50)

debuglog add(a, b)
debuglog sub(a, b)
debuglog mul(a, b)
debuglog negate(a)
debuglog negate(b)
debuglog max_of(a, b)
debuglog min_of(a, b)
