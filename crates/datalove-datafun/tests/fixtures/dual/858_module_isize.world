----------
module local/test/isize_math
----------

fun add(a: isize, b: isize): isize
    ret a +! b
end fun

fun sub(a: isize, b: isize): isize
    ret a -! b
end fun

fun mul(a: isize, b: isize): isize
    ret a *! b
end fun

fun negate(n: isize): isize
    ret icall neg_wrapping_isize(n)
end fun

fun max_of(a: isize, b: isize): isize
    if a .>= b
        ret a
    else
        ret b
    end if
end fun

fun min_of(a: isize, b: isize): isize
    if a .<= b
        ret a
    else
        ret b
    end if
end fun

