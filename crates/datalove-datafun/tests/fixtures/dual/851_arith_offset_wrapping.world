----------
scriptunit-fragment
----------

let a: offset = (: offset / 10)
let b: offset = (: offset / 5)
let c: offset = (: offset / -3)

// Basic wrapping arithmetic.
debuglog (a +! b)
debuglog (a -! b)
debuglog (a *! c)

// With negative numbers.
debuglog (c +! c)
debuglog (c -! a)
debuglog (c *! c)

// Wrapping overflow.
let max: offset = (: offset / 2147483647)
let one: offset = (: offset / 1)
debuglog (max +! one)

// Wrapping underflow.
let min: offset = (: offset / -2147483648)
debuglog (min -! one)
