// Pass 2D tensor sub-tensor view to ref param; OOB returns none.
fun read_row(ref row: [|u32, 1|]): [|u32, 1|]
    ret row@
end fun

fun test(): ?[|u32, 1|]
    let t: [|u32, 2|] = [| 10 20 30, 40 50 60 |]
    ret some read_row(t[(: index / 5)]?)
end fun

debuglog test()
