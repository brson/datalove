----------
scriptunit-fragment
----------

fun add_usize(a: usize, b: usize): usize
    ret icall add_wrapping_usize(a, b)
end fun

fun double_usize(n: usize): usize
    ret icall add_wrapping_usize(n, n)
end fun

fun is_zero_usize(n: usize): bool
    ret n == (: usize / 0)
end fun

debuglog add_usize((: usize / 100), (: usize / 200))
debuglog double_usize((: usize / 50))
debuglog is_zero_usize((: usize / 0))
debuglog is_zero_usize((: usize / 1))
