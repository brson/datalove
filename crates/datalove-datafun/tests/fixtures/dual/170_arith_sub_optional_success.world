// Optional sub (-?) returning Option - success case.
fun sub_opt(a: u32, b: u32): ?u32
    ret some (a -? b)
end fun

fun unwrap(opt: ?u32, default: u32): u32
    if opt |val|
        ret val
    end if
    ret default
end fun

debuglog unwrap(sub_opt(100, 42), 999)
