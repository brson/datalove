----------
scriptunit-fragment
----------

let a: usize = (: usize / 1)
let b: usize = (: usize / 0x80000000)
let mid: usize = (: usize / 0x00FF0000)

// Shift left.
debuglog icall shl_usize(a, @0)
debuglog icall shl_usize(a, @4)
debuglog icall shl_usize(a, @31)

// Shift right (logical).
debuglog icall shr_usize(b, @0)
debuglog icall shr_usize(b, @4)
debuglog icall shr_usize(b, @31)

// Combined shifts.
debuglog icall shr_usize(icall shl_usize(mid, @8), @8)
