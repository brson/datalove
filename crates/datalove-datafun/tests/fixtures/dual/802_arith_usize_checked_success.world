----------
scriptunit-fragment
----------

fun unwrap_usize(opt: ?usize, default: usize): usize
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_add(a: usize, b: usize): ?usize
    ret some (a +? b)
end fun

fun checked_sub(a: usize, b: usize): ?usize
    ret some (a -? b)
end fun

fun checked_mul(a: usize, b: usize): ?usize
    ret some (a *? b)
end fun

fun checked_div(a: usize, b: usize): ?usize
    ret some (a /? b)
end fun

let a: usize = (: usize / 100)
let b: usize = (: usize / 50)

debuglog unwrap_usize(checked_add(a, b), (: usize / 999))
debuglog unwrap_usize(checked_sub(a, b), (: usize / 999))
debuglog unwrap_usize(checked_mul(a, b), (: usize / 999))
debuglog unwrap_usize(checked_div(a, b), (: usize / 999))
