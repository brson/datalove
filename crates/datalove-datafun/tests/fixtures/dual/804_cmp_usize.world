----------
scriptunit-fragment
----------

let a: usize = (: usize / 10)
let b: usize = (: usize / 20)
let c: usize = (: usize / 10)
let zero: usize = (: usize / 0)
let max: usize = (: usize / 4294967295)

// Equality.
debuglog (a == c)
debuglog (a == b)
debuglog (a != b)
debuglog (a != c)

// Less than.
debuglog (a .< b)
debuglog (b .< a)
debuglog (zero .< max)

// Less or equal.
debuglog (a <= b)
debuglog (a <= c)
debuglog (b <= a)

// Greater than.
debuglog (b .> a)
debuglog (a .> b)
debuglog (max .> zero)

// Greater or equal.
debuglog (b >= a)
debuglog (a >= c)
debuglog (a >= b)
