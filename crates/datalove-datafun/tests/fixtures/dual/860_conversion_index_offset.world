----------
scriptunit-fragment
----------

// index to offset.
let u_zero: index = (: index / 0)
let u_one: index = (: index / 1)
let u_max: index = (: index / 4294967295)
let u_half: index = (: index / 2147483647)

debuglog icall index_to_offset(u_zero)
debuglog icall index_to_offset(u_one)
debuglog icall index_to_offset(u_half)
debuglog icall index_to_offset(u_max)

// offset to index.
let i_zero: offset = (: offset / 0)
let i_one: offset = (: offset / 1)
let i_neg: offset = (: offset / -1)
let i_max: offset = (: offset / 2147483647)
let i_min: offset = (: offset / -2147483648)

debuglog icall offset_to_index(i_zero)
debuglog icall offset_to_index(i_one)
debuglog icall offset_to_index(i_neg)
debuglog icall offset_to_index(i_max)
debuglog icall offset_to_index(i_min)
