// Optional mul (*?) returning Option - success case.
fun mul_opt(a: u32, b: u32): ?u32
    ret some (a *? b)
end fun

fun unwrap(opt: ?u32, default: u32): u32
    if opt |val|
        ret val
    end if
    ret default
end fun

debuglog unwrap(mul_opt(7, 6), 999)
