// Test calling module function with struct field as mut arg (copy type).
require module local/test/mutops
import mutops.set_to_42

var s: {a: @u32, b: @u32} = {a = @100, b = @200}
let _ok = set_to_42(s.a)
debuglog s.a
debuglog s.b
