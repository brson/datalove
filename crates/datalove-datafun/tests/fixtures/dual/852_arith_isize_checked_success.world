----------
scriptunit-fragment
----------

fun unwrap_isize(opt: ?isize, default: isize): isize
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_add(a: isize, b: isize): ?isize
    ret some (a +? b)
end fun

fun checked_sub(a: isize, b: isize): ?isize
    ret some (a -? b)
end fun

fun checked_mul(a: isize, b: isize): ?isize
    ret some (a *? b)
end fun

fun checked_div(a: isize, b: isize): ?isize
    ret some (a /? b)
end fun

let a: isize = (: isize / 100)
let b: isize = (: isize / 50)
let c: isize = (: isize / -25)

debuglog unwrap_isize(checked_add(a, b), (: isize / 999))
debuglog unwrap_isize(checked_sub(a, b), (: isize / 999))
debuglog unwrap_isize(checked_mul(a, b), (: isize / 999))
debuglog unwrap_isize(checked_div(a, b), (: isize / 999))

// With negative numbers.
debuglog unwrap_isize(checked_add(a, c), (: isize / 999))
debuglog unwrap_isize(checked_mul(c, b), (: isize / 999))
