----------
module local/test/mutual
----------

fun is_even(n: int): bool
    if n == @0
        ret true
    end if
    ret is_odd(n - @1)
end fun

fun is_odd(n: int): bool
    if n == @0
        ret false
    end if
    ret is_even(n - @1)
end fun

