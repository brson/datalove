----------
module local/test/index_math
----------

fun add(a: index, b: index): !index
    ret ok (a +! b)
end fun

fun sub(a: index, b: index): !index
    ret ok (a -! b)
end fun

fun mul(a: index, b: index): !index
    ret ok (a *! b)
end fun

fun max_of(a: index, b: index): index
    if a ≥ b
        ret a
    else
        ret b
    end if
end fun

fun min_of(a: index, b: index): index
    if a ≤ b
        ret a
    else
        ret b
    end if
end fun

