----------
scriptunit-fragment
----------

let pos: isize = (: isize / 16)
let neg: isize = (: isize / -16)

// Shift left via usize cast.
let pos_u = icall isize_to_usize(pos)
debuglog icall usize_to_isize(icall shl_usize(pos_u, @0))
debuglog icall usize_to_isize(icall shl_usize(pos_u, @4))

// Arithmetic right shift (preserves sign).
debuglog icall sshr_isize(pos, @0)
debuglog icall sshr_isize(pos, @2)
debuglog icall sshr_isize(neg, @2)

// Negative number shifted right stays negative.
let big_neg: isize = (: isize / -256)
debuglog icall sshr_isize(big_neg, @4)
