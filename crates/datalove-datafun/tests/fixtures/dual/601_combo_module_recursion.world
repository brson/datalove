require module local/test/fib
import fib.fib

fun unwrap(opt: ?u32, default: u32): u32
    if opt |val|
        ret val
    end if
    ret default
end fun

debuglog unwrap(fib(@0), @999)
debuglog unwrap(fib(@1), @999)
debuglog unwrap(fib(@5), @999)
debuglog unwrap(fib(@10), @999)
