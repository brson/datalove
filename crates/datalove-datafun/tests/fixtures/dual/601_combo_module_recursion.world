----------
module local/test/fib
----------

// Fibonacci with option for bounds checking.
fun fib(n: u32): ?u32
    if n <= @1
        ret some n
    end if
    let a = fib(n -! @1)?
    let b = fib(n -! @2)?
    ret some (a +? b)
end fun

