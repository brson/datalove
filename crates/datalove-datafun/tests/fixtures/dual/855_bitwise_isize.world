----------
scriptunit-fragment
----------

let a: isize = (: isize / 255)
let b: isize = (: isize / 15)
let zero: isize = (: isize / 0)
let neg_one: isize = (: isize / -1)

// Bitwise NOT via cast to usize.
let a_u = icall isize_to_usize(a)
debuglog icall usize_to_isize(icall bitnot_usize(a_u))

// Bitwise AND via cast.
let b_u = icall isize_to_usize(b)
debuglog icall usize_to_isize(icall bitand_usize(a_u, b_u))

// Bitwise OR via cast.
debuglog icall usize_to_isize(icall bitor_usize(a_u, b_u))

// Bitwise XOR via cast.
debuglog icall usize_to_isize(icall bitxor_usize(a_u, b_u))

// XOR with self gives zero.
debuglog icall usize_to_isize(icall bitxor_usize(a_u, a_u))
