// Read field from indexed list element in value context: a[i]?.field.
fun get_x(a: [{x: u32, y: u32}], i: index): ?u32
    ret some (a[i]?.x)
end fun

fun get_y(a: [{x: u32, y: u32}], i: index): ?u32
    ret some (a[i]?.y)
end fun

debuglog get_x([{x = 10, y = 20}, {x = 30, y = 40}], (: index / 0))
debuglog get_y([{x = 10, y = 20}, {x = 30, y = 40}], (: index / 0))
debuglog get_x([{x = 10, y = 20}, {x = 30, y = 40}], (: index / 1))
debuglog get_x([{x = 10, y = 20}, {x = 30, y = 40}], (: index / 5))
