// Bring only - in function like test 229
// Uses carry binding instead of outer-scoped var to avoid move-in-loop error.
fun count_to(limit: int): int
    loop carry (i = :int/@1) while i .< limit else break (i)
        let next = i + :int/@1
        if next >= limit
            break(next)
        end if
        continue(next)
    end loop bring (final: int)
    ret final
end fun

----------
scriptunit-expr
----------

count_to(:int/@5)
