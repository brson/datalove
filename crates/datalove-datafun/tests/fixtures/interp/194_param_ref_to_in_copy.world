// Test passing Ref-mode param to In-mode param (Copy type).
// For Copy types, the callee makes a copy, so this should work.
fun inner(x: u32): bool
    ret x == 100
end fun

fun outer(ref y: u32): bool
    ret inner(y)
end fun

