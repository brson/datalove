// Test passing an in parameter to a mut parameter.
// Should error - an in parameter is not assignable in the callee's frame.
fun bump(mut x: u32): bool
    set x = 999
    ret true
end fun

fun outer(v: u32): bool
    ret bump(v)
end fun

