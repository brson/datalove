// Test nested loops - outer runs 3x, inner runs 2x each = 6 total increments.
fun nested_loops(): !u32
    let total: u32 = @0
    let outer: u32 = @0
    loop
        let outer = outer +! @1
        let inner: u32 = @0
        loop
            let inner = inner +! @1
            let total = total +! @1
            if inner >= @2
                break
            end if
        end loop
        if outer >= @3
            break
        end if
    end loop
    ret total
end fun

let output = nested_loops()
