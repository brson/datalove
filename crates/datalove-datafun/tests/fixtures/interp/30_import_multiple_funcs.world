----------
module sys/test/math
----------

fun add(x: int, y: int): int
    ret x + y
end fun

fun sub(x: int, y: int): int
    ret x - y
end fun

fun mul(x: int, y: int): int
    ret x * y
end fun

----------
script
----------

require module sys/test/math
import math.add
import math.sub
import math.mul

let a = add(@10 + @0, @5 + @0)
let b = sub(@20 + @0, @8 + @0)
let output = mul(a, b)
