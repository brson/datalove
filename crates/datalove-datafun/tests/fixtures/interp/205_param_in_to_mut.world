----------
module local/test/main
----------

// Test passing In-mode param to Mut-mode param.
// Should work - In owns the value, can grant mutable access.
fun inner(mut x: u32): bool
    set x = 42
    ret true
end fun

fun outer(y: u32): bool
    // y is owned (In mode), pass to mut
    var temp: u32 = y
    ret inner(temp)
end fun

