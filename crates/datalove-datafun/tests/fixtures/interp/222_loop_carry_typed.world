// Carry with explicit type annotation
fun countdown(start: int): int
    var total = :int/@0
    loop carry (n: int = start)
        set total = total + n
        if n == :int/@0
            break
        end if
        continue(n - :int/@1)
    end loop
    ret total
end fun

----------
scriptunit-expr
----------

countdown(:int/@4)
