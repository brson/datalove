// Test nested conditional move.
// x is moved in inner then-branch only.
fun test(cond1: bool, cond2: bool): u32
    let x = [@1, @2]
    if cond1
        if cond2
            let _sink = x
        end if
    end if
    ret @0
end fun

// Test all 4 combinations
let out1 = test(@false, @false)  // x not moved
let out2 = test(@false, @true)   // x not moved (cond1 false)
let out3 = test(@true, @false)   // x not moved (cond2 false)
let out4 = test(@true, @true)    // x moved
