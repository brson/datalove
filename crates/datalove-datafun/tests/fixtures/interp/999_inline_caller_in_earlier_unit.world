// Unit 1 only defines the functions. It never calls `outer` enough to warm
// anything, so nothing here triggers inlining.

fun inner(x: int): int
    ret x + 1
end fun

fun outer(x: int): int
    ret inner(x)
end fun

debuglog outer(0)

----------
scriptunit-fragment
----------

// Unit 2 drives the loop. The hot call site is `inner(x)` inside `outer`, and
// `outer` is reached from here by a `CodeRef::External`, so the caller to
// inline into lives in a unit that has already finished. Finding it means going
// through the registry rather than this unit's local scope.

var i: int = 0
var warm: int = 0
loop while i .< 80
    set warm = warm + outer(i@)
    set i = i + 1
end loop

let total = warm
debuglog total

----------
scriptunit-expr
----------

total

----------
scriptunit-fragment
----------

// The rest checks that compiled code from one unit calling compiled code from
// an earlier one, which then calls its own unit's function for the first time,
// reaches that function and not the one at the same id in the calling unit.
//
// Unit 3 defines `helper`, local id 0, and `relay`, which calls it for one
// argument only, so that it is never called often enough to be compiled or
// inlined and the first call to it from compiled `relay` goes through the
// trampoline.

fun helper(x: int): int
    ret x + 1
end fun

fun relay(x: int): int
    if x == 150
        ret helper(x)
    end if
    ret x
end fun

debuglog relay(0)

----------
scriptunit-fragment
----------

// Unit 4 defines `decoy` at local id 0 too, which `helper(x)` inside `relay`
// would reach if it were resolved against this unit. `drive` is called often
// enough to be compiled, and so is `relay` from it, so by the time `relay` sees
// 150 both are compiled and the call from one to the other is direct.
//
// The same call has to survive `relay` being inlined into `drive`, which the
// dispatchers do: moved into a unit 4 body, `relay`'s call to its unit's
// function 0 must still mean unit 3's.

fun decoy(x: int): int
    ret x + 7
end fun

fun drive(x: int): int
    ret relay(x)
end fun

var j: int = 0
var relayed: int = 0
loop while j .< 200
    set relayed = relayed + drive(j@)
    set j = j + 1
end loop

let relayed_total = relayed
debuglog relayed_total

----------
scriptunit-expr
----------

relayed_total
