// Regression test for UseAfterMove false positive bug.
// Each parameter is used exactly once in different branches.
// With linear types (lists), this exercises the move analysis.
// This should NOT trigger UseAfterMove errors.

fun choose_list(cond: bool, a: [u32], b: [u32]): [u32]
    if cond
        ret a
    else
        ret b
    end if
end fun

// Test true branch - should return a ([1, 2])
let output = choose_list(@true, [@1, @2], [@3, @4])
