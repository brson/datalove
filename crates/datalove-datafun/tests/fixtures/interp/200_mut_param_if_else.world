----------
module local/test/main
----------

// Test mut param in if/else branches.
// Can read mut param in condition and modify in branches.
fun conditional_set(mut x: u32, cond: bool): bool
    if cond
        set x = 42
    else
        set x = 99
    end if
    ret true
end fun

fun test_true(): u32
    var n: u32 = 0
    let _ok: bool = conditional_set(n, true)
    ret n
end fun

fun test_false(): u32
    var n: u32 = 0
    let _ok: bool = conditional_set(n, false)
    ret n
end fun

----------
scriptunit-fragment
----------

require module local/test/main
import main.test_true
import main.test_false

----------
scriptunit-expr
----------

(test_true(), test_false())

