module local/test/main
----------

// Test passing In-mode param to In-mode param (ownership chain).
// Each function takes ownership and passes it to the next.
fun inner(x: int): bool
    ret x ≡ :int/100
end fun

fun outer(y: int): bool
    ret inner(y)
end fun

