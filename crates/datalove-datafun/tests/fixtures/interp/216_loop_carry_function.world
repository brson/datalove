// Carry in function context
fun sum_to_n(n: int): int
    var total = :int/@0
    loop carry (i = :int/@1)
        set total = total + i
        if i == n
            break
        end if
        continue(i + :int/@1)
    end loop
    ret total
end fun

----------
scriptunit-expr
----------

sum_to_n(:int/@5)
