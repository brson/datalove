----------
module local/test/base
----------

// Using int type to avoid fixed-width integer widening issues.
fun add_one(x: int): int
    ret x + :int/1
end fun

----------
module local/test/mid
----------

require module local/test/base
import base.add_one

fun add_two(x: int): int
    ret add_one(add_one(x))
end fun

----------
module local/test/top
----------

require module local/test/mid
import mid.add_two

fun add_four(x: int): int
    ret add_two(add_two(x))
end fun

