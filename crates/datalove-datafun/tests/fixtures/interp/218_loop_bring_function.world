// Bring in function context - find value greater than threshold
fun find_threshold(start: int, threshold: int): int
    var x = start
    loop
        if x > threshold
            break(x)
        end if
        set x = x + :int/@1
    end loop bring (found)
    ret found
end fun

----------
scriptunit-expr
----------

find_threshold(:int/@5, :int/@10)
