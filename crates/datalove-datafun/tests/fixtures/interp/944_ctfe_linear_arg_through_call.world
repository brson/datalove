----------
scriptunit-fragment
----------

// A const folded from a call leaves behind the instructions that built its
// arguments. Those have no consumer and no drop, so a linear one leaks unless
// dead code elimination runs after const inlining in function bodies.
//
// The leak detector panics, so a regression here fails the test rather than
// changing the output.

fun takes(n: int): u32
    ret : u32 / 1
end fun

fun id(n: int): int
    ret n
end fun

fun consumes_bigint_arg(): u32
    const A: u32 = takes(5)
    ret A
end fun

fun bigint_in_and_out(): int
    const B: int = id(7)
    ret B
end fun

debuglog consumes_bigint_arg()
debuglog bigint_in_and_out()
