----------
scriptunit-fragment
----------

// `@` on a linear field. The projection borrows part of the aggregate rather
// than producing a value anyone owns, so it lowers to a `getfieldref` and the
// clone reads through it. Lowering it as a value instead moved the field out
// and recorded it as a temporary to drop, which freed a field the aggregate
// still held: `free() called on untracked pointer`, and on the way to that a
// `copy_nonoverlapping` whose ranges overlapped.

fun peek(ref x: int): u32
    ret : u32 / 7
end fun

let p: {a: int, b: u32} = {a = :int/10, b = :u32/2}

// Clone a linear field out.
let cloned: int = p.a@
debuglog cloned

// Read it again, to show the aggregate still holds it.
let again = p.a@
debuglog again

// A copy field needs no clone.
debuglog p.b

// Borrowing forms, which were already right.
debuglog p.a
debuglog peek(ref p.a)

// Nested.
let q: {inner: {a: int, b: u32}, c: u32} = {inner = {a = :int/5, b = :u32/1}, c = :u32/3}
let deep = q.inner.a@
debuglog deep
debuglog q.inner.a

// A tuple element is the same projection with a numeric selector, and behaves
// the same way in every position.
let t: (int, u32) = (: int / 10, : u32 / 2)
let t_cloned: int = t.0@
debuglog t_cloned
debuglog t.0@
debuglog t.1
debuglog t.0
debuglog peek(ref t.0)

let nested: ((int, u32), u32) = ((: int / 5, : u32 / 1), : u32 / 3)
debuglog nested.0.0@
debuglog nested.0.0

// Writing through a projection: `mut`, `out`, and assignment.
fun bump(mut x: int)
    set x = x + :int/1
end fun

fun fill(out x: int)
    set x = :int/99
end fun

var w: (int, u32) = (: int / 10, : u32 / 2)
bump(mut w.0)
debuglog w.0
fill(out w.0)
debuglog w.0
set w.0 = :int/50
debuglog w.0

var s: {a: int, b: u32} = {a = :int/10, b = :u32/2}
bump(mut s.a)
debuglog s.a
fill(out s.a)
debuglog s.a
set s.a = :int/50
debuglog s.a
