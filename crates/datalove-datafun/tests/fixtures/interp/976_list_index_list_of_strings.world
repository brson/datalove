// Index into list of lists of strings — doubly linear.
fun get_inner(a: [[string]], i: index): ?[string]
    ret some (a[i]?)
end fun

debuglog get_inner([["hello", "world"], ["foo"]], (: index / 0))
debuglog get_inner([["hello", "world"], ["foo"]], (: index / 1))
debuglog get_inner([["hello", "world"], ["foo"]], (: index / 5))
