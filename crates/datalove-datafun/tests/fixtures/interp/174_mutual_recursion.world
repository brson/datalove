// Mutual recursion: is_even calls is_odd and vice versa.
fun is_even(n: u32): !bool
    if n == 0
        ret ok true
    else
        ret is_odd(n -! 1)
    end if
end fun

fun is_odd(n: u32): !bool
    if n == 0
        ret ok false
    else
        ret is_even(n -! 1)
    end if
end fun

----------
scriptunit-expr
----------

is_even(6)
