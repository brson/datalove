// Test loop continue - skips i==3, sums 1+2+4+5 = 12.
fun skip_iteration(): !u32
    let sum: u32 = @0
    let i: u32 = @0
    loop
        let i = i +! @1
        if i .> @5
            break
        end if
        if i == @3
            continue
        end if
        let sum = sum +! i
    end loop
    ret sum
end fun

let output = skip_iteration()
