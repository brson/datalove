scriptunit-fragment
----------

// Set field of a list element: set a[i]?.field = v (index then field).
fun set_elem_field(a: [{x: u32, y: u32}], i: index, v: u32): ?[{x: u32, y: u32}]
    var b = a
    set b[i]?.x = v
    ret some b
end fun

debuglog set_elem_field([{x = 1, y = 2}, {x = 3, y = 4}], (: index / 0), 99)
debuglog set_elem_field([{x = 1, y = 2}, {x = 3, y = 4}], (: index / 1), 77)
debuglog set_elem_field([{x = 1, y = 2}, {x = 3, y = 4}], (: index / 5), 77)
