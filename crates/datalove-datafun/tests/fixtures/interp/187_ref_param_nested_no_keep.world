module local/test/main
----------

// Two functions: outer passes its ref param to inner's ref param.
// This version doesn't keep the int around after the call.
fun inner(ref x: int): bool
    ret true
end fun

fun outer(ref y: int): bool
    ret inner(y)
end fun

fun main(): bool
    let val: int = :int/100
    ret outer(val)
end fun

