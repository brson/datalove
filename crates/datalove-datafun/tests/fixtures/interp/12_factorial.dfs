fun sub(a: @u32, b: @u32): ?u32
  ret a -? b
end fun

fun mul(a: @u32, b: @u32): ?u32
  ret a *? b
end fun

fun factorial(n: @u32): ?u32
  if n .< @2
    ret @1
  else
    let n_minus_1 = sub(n, @1)?
    let fact = factorial(n_minus_1)?
    ret mul(n, fact)
  end if
end fun

let output = factorial(@5)
