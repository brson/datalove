// Pass a[i]? to ref param with string (linear type), clone and return.
fun read_str(ref x: string): ?string
    ret some x@
end fun

fun test(a: [string], i: index): ?string
    ret read_str(ref a[i]?)
end fun

debuglog test(["hello", "world"], (: index / 0))
