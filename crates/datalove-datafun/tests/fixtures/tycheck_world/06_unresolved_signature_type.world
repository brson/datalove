----------
module local/test/main
----------

// An unresolved type in a parameter position reports an error rather than
// panicking, and the body is not checked against a missing signature.
fun unknown_param(v: Bogus): u32
  ret v
end fun

// An unresolved return type is reported the same way.
fun unknown_return(n: u32): Nonesuch
  ret n
end fun

// Functions with resolvable signatures still typecheck around the bad ones.
fun good(n: u32): u32
  ret n
end fun
