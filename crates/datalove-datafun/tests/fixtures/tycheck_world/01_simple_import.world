----------
module sys/std/u32
----------

fun negate(x: @u32): @u32
  ret @0
end fun

fun add(x: @u32, y: @u32): @u32
  ret @0
end fun

----------
module sys/util/math
----------

require module sys/std/u32

import u32.negate
import u32.add

fun double_negate(n: @u32): @u32
  ret negate(n)
end fun

fun add_three(a: @u32, b: @u32, c: @u32): @u32
  let sum_ab: @u32 = add(a, b)
  ret add(sum_ab, c)
end fun
