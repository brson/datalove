----------
module local/test/comptime
----------

// Function with a comptime param
fun scale(const factor: int, x: int): int
    ret factor * x
end fun

// This function tries to pass a let binding to a const param - should error
fun bad_let_binding(x: int): int
    let three: int = 3
    ret scale(three, x)
end fun

// A literal is refused along with everything else that is not a name. The
// value a const parameter takes has to be one the compiler already holds, and
// a `const` binding is the one form that says so on its face.
fun bad_literal(x: int): int
    ret scale(5, x)
end fun

// An expression, likewise, whether or not its parts are known.
fun bad_expression(x: int): int
    ret scale(2 + 3, x)
end fun

// Naming a const is how it is written.
fun good_const(x: int): int
    const FIVE: int = 5
    ret scale(FIVE, x)
end fun

// This function tries to pass a function param to a const param - should error
fun bad_param(factor: int, x: int): int
    ret scale(factor, x)
end fun

// A const parameter of an ordinary type is fine in a generic function: the two
// vary it along different axes, so one copy per const instantiation serves
// every type instantiation.
fun good_generic<T>(const n: int, x: T): T
    ret x
end fun

// A const parameter whose own type is the type parameter is not. The value
// would be the only thing saying what `T` is, which is pinning it concretely,
// and specialization copies a body rather than lowering one again.
fun bad_generic<T>(const x: T): T
    ret x
end fun
