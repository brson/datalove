scriptunit-fragment
----------

fun count_to_n(n: int): int
    var i = :int/@0
    var total = :int/@0
    loop
        set i = i + :int/@1
        set total = total + i
        if i == n
            break
        end if
    end loop
    ret total
end fun

----------
scriptunit-expr
----------

count_to_n(:int/@4)
