// Test that move types are dropped before TryReturn.
// When +? overflows, the string `s` should be dropped before early return.
fun test_add_overflow(a: i8, b: i8): ?i8
    let s: string = "should be dropped"
    ret some (a +? b)
end fun

let output = test_add_overflow(@127, @1)
