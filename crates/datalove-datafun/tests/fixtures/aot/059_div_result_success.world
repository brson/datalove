// Test /! operator with no error - should return Ok(result).
fun checked_div(a: u32, b: u32): !u32
    ret ok (a /! b)
end fun

fun unwrap_or_default(r: !u32, default: u32): u32
    if r |val|
        ret val
    else |e|
        ret default
    end if
end fun

// 42 / 7 = 6, no error.
debuglog unwrap_or_default(checked_div(@42, @7), @999)
