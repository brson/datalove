// Test -? operator with no underflow - should return Some(result).
fun unwrap_or_default(opt: ?u32, default: u32): u32
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_sub(a: u32, b: u32): ?u32
    ret some (a -? b)
end fun

// 10 - 3 = 7, no underflow.
debuglog unwrap_or_default(checked_sub(@10, @3), @999)
