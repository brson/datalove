// Test /? operator with signed overflow - should return None.
// i32::MIN / -1 overflows because -(-2147483648) > i32::MAX.
fun unwrap_or_default(opt: ?i32, default: i32): i32
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_div(a: i32, b: i32): ?i32
    ret some (a /? b)
end fun

// -2147483648 / -1 overflows i32, returns None -> default 999.
debuglog unwrap_or_default(checked_div(-2147483648, -1), 999)
