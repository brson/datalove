// Test -? (negation) operator with overflow - should return None.
// i32::MIN = -2147483648, negating it overflows.
fun unwrap_or_default(opt: ?i32, default: i32): i32
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_neg(a: i32): ?i32
    ret some (-? a)
end fun

// Negating i32::MIN overflows, returns None -> default 999.
debuglog unwrap_or_default(checked_neg(@-2147483648), @999)
