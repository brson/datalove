// Carry in function context
fun sum_to_n(n: u32): u32
    var total: u32 = @0
    loop carry (i: u32 = @1)
        set total = total + i
        if i == n
            break
        end if
        continue(i + @1)
    end loop
    ret total
end fun

debuglog sum_to_n(@5)
