// Test -? operator with underflow - should return None.
fun unwrap_or_default(opt: ?u32, default: u32): u32
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_sub(a: u32, b: u32): ?u32
    ret some (a -? b)
end fun

// 3 - 10 underflows u32, returns None -> default 999.
debuglog unwrap_or_default(checked_sub(@3, @10), @999)
