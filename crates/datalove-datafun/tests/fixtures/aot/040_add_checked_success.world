// Test +? operator with no overflow - should return Some(result).
fun unwrap_or_default(opt: ?u32, default: u32): u32
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_add(a: u32, b: u32): ?u32
    ret some (a +? b)
end fun

// 5 + 3 = 8, no overflow.
debuglog unwrap_or_default(checked_add(5, 3), 999)
