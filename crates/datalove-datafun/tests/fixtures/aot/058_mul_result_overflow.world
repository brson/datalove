// Test *! operator with overflow - should return Err.
fun checked_mul(a: u32, b: u32): !u32
    ret ok (a *! b)
end fun

fun unwrap_or_default(r: !u32, default: u32): u32
    if r |val|
        ret val
    else |e|
        ret default
    end if
end fun

// 100000 * 100000 overflows u32, returns Err -> default 999.
debuglog unwrap_or_default(checked_mul(@100000, @100000), @999)
