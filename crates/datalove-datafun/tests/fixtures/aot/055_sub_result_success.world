// Test -! operator with no underflow - should return Ok(result).
fun checked_sub(a: u32, b: u32): !u32
    ret ok (a -! b)
end fun

fun unwrap_or_default(r: !u32, default: u32): u32
    if r |val|
        ret val
    else |e|
        ret default
    end if
end fun

// 10 - 3 = 7, no underflow.
debuglog unwrap_or_default(checked_sub(@10, @3), @999)
