// Test -! (negation) operator with overflow - should return Err.
// i32::MIN = -2147483648, negating it overflows.
fun checked_neg(a: i32): !i32
    ret ok (-! a)
end fun

fun unwrap_or_default(r: !i32, default: i32): i32
    if r |val|
        ret val
    else |e|
        ret default
    end if
end fun

// Negating i32::MIN overflows, returns Err -> default 999.
debuglog unwrap_or_default(checked_neg(-2147483648), 999)
