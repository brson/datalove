----------
module local/test/comptime
----------

// The call site is in a module function, so specialization runs and the AOT
// backend compiles the copy. 083 calls from the script unit, where the call
// keeps its original form, so it never covered this.

fun scale(const factor: int, x: int): int
    ret factor * x
end fun

fun triple(x: int): int
    const THREE: int = 3
    ret scale(THREE, x)
end fun

fun quintuple(x: int): int
    const FIVE: int = 5
    ret scale(FIVE, x)
end fun

----------
scriptunit-fragment
----------

require module local/test/comptime
import comptime.triple
import comptime.quintuple

let a = triple(7)
let b = quintuple(7)
debuglog a
debuglog b
