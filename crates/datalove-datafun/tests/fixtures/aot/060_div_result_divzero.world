// Test /! operator with division by zero - should return Err.
fun checked_div(a: u32, b: u32): !u32
    ret ok (a /! b)
end fun

fun unwrap_or_default(r: !u32, default: u32): u32
    if r |val|
        ret val
    else |e|
        ret default
    end if
end fun

// 42 / 0 is division by zero, returns Err -> default 999.
debuglog unwrap_or_default(checked_div(42, 0), 999)
