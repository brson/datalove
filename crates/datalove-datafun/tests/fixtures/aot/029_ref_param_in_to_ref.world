// Test passing In-mode param to Ref-mode param.
// Outer function takes ownership (In mode), then passes a reference to inner.
fun inner(ref x: int): int
    ret x + :int/10
end fun

fun outer(y: int): int
    // y is owned (In mode), pass reference to inner
    ret inner(y)
end fun

debuglog outer(42)
debuglog outer(100)
