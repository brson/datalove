// Test +? operator with overflow - should return None.
fun unwrap_or_default(opt: ?u32, default: u32): u32
    if opt |val|
        ret val
    end if
    ret default
end fun

fun checked_add(a: u32, b: u32): ?u32
    ret some (a +? b)
end fun

// 4294967295 + 1 overflows u32, returns None -> default 999.
debuglog unwrap_or_default(checked_add(@4294967295, @1), @999)
