----------
module sys/test/bigmath
----------

fun compute_large(x: int, y: int): int
    let a = x + y
    let mult = @1000000 + @0
    let b = a * mult
    ret b
end fun

----------
script
----------

require module sys/test/bigmath
import bigmath.compute_large

let x = @42 + @0
let y = @58 + @0
let output = compute_large(x, y)
