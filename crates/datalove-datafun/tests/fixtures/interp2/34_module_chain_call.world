----------
module sys/test/base
----------

fun increment(x: int): int
    let one = @1 + @0
    ret x + one
end fun

----------
module sys/test/derived
----------

require module sys/test/base
import base.increment

fun add_five(x: int): int
    let a = increment(x)
    let b = increment(a)
    let c = increment(b)
    let d = increment(c)
    let e = increment(d)
    ret e
end fun

----------
script
----------

require module sys/test/derived
import derived.add_five

let output = add_five(@10 + @0)
