// Test deeply nested if with lets at each level.
fun complex(a: int, b: int): int
    let sum = a + b
    if sum .> @10
        let x = sum - @10
        if x .> @5
            let y = x * @2
            ret y
        else
            ret x
        end if
    else
        ret sum
    end if
end fun

let output = complex(@7, @8)
