----------
module sys/test/ops1
----------

fun add(x: int, y: int): int
    ret x + y
end fun

fun double(x: int): int
    let two = @2 + @0
    ret x * two
end fun

----------
module sys/test/ops2
----------

fun multiply(x: int, y: int): int
    ret x * y
end fun

fun square(x: int): int
    ret x * x
end fun

----------
script
----------

require module sys/test/ops1
require module sys/test/ops2
import ops1.add
import ops1.double
import ops2.multiply
import ops2.square

let a = add(@3 + @0, @4 + @0)
let b = double(@5 + @0)
let c = multiply(@2 + @0, @3 + @0)
let d = square(@4 + @0)
let output = add(a, add(b, add(c, d)))
