----------
module sys/test/ops1
----------

fun add(x: u32, y: u32): u32
    ret x +! y
end fun

fun double(x: u32): u32
    ret x *! @2
end fun

----------
module sys/test/ops2
----------

fun multiply(x: u32, y: u32): u32
    ret x *! y
end fun

fun square(x: u32): u32
    ret x *! x
end fun

----------
script
----------

require module sys/test/ops1
require module sys/test/ops2
import ops1.add
import ops1.double
import ops2.multiply
import ops2.square

let a = add(@3, @4)
let b = double(@5)
let c = multiply(@2, @3)
let d = square(@4)
let output = add(a, add(b, add(c, d)))
