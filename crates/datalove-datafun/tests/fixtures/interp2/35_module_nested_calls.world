----------
module sys/test/calc
----------

fun base(x: int): int
    let two = @2 + @0
    ret x * two
end fun

fun level1(x: int): int
    let a = base(x)
    let b = base(a)
    ret b
end fun

fun level2(x: int): int
    let a = level1(x)
    let three = @3 + @0
    let b = level1(three)
    ret a + b
end fun

fun top(x: int): int
    let a = level2(x)
    let one = @1 + @0
    let b = level1(one)
    ret a + b
end fun

----------
script
----------

require module sys/test/calc
import calc.top

let output = top(@5 + @0)
