fun inc(x: int): int
  ret x + :int/1
end fun
---
fun double(x: int): int
  ret x + x
end fun
---
inc(5)
---
double(5)
---
double(inc(5))
---
inc(double(5))
---
fun multiply(a: int, b: int): int
  ret a * b
end fun
---
fun add(a: int, b: int): int
  ret a + b
end fun
---
fun compute(x: int, y: int): int
  let a = add(x, y)
  let b = multiply(a, :int/2)
  ret b
end fun
---
compute(3, 4)
