fun abs(x: i32): i32
  if x .< 0
    ret 0 - x
  else
    ret x
  end if
end fun
---
abs(5)
---
abs(-5)
---
fun classify(x: u32): u32
  if x .< 10
    ret 1
  else
    if x .< 20
      ret 2
    else
      ret 3
    end if
  end if
end fun
---
classify(5)
---
classify(15)
---
classify(25)
---
fun grade(score: u32): u32
  if score >= 90
    ret 4
  else
    if score >= 80
      ret 3
    else
      if score >= 70
        ret 2
      else
        ret 1
      end if
    end if
  end if
end fun
---
grade(95)
---
grade(85)
---
grade(75)
---
grade(65)
