var b = 125
---
let flag = true
---
if flag
  set b = 500
end if
---
type Flag: enum { atom Yes, atom No }
let f: Flag = atom No
---
match f
case atom Yes
  set b = 1
case atom No
  set b = 2
end match
---
var i = 0
---
loop while i .< 3
  set i = i + 1
end loop
---
loop
  set i = i + 1
  break
end loop
---
debuglog b
---
b
---
i
