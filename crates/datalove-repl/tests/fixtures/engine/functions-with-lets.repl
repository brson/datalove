fun compute(x: @u32): @u32
  let a = x + @1
  let b = a * @2
  ret b - @1
end fun
---
compute(@5)
---
fun fib(n: @u32): @u32
  if n <= @1
    ret @1
  else
    let a = fib(n - @1)
    let b = fib(n - @2)
    ret a + b
  end if
end fun
---
fib(@6)
---
fun shadow(x: @u32): @u32
  let y = x + @1
  let y = y * @2
  ret y
end fun
---
shadow(@5)
