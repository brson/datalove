fun compute(x: int): int
  let a = x + :int/1
  let b = a * :int/2
  ret b - :int/1
end fun
---
compute(5)
---
fun fib(n: int): int
  if n <= :int/1
    ret :int/1
  else
    let a = fib(n - :int/1)
    let b = fib(n - :int/2)
    ret a + b
  end if
end fun
---
fib(6)
---
fun shadow(x: int): int
  let y = x + :int/1
  let y = y * :int/2
  ret y
end fun
---
shadow(5)
