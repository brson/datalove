      "labels": [
        {
          "message": "a set or map over a type parameter needs `is ord`",
          "span": [
            153,
            156
          ],
          "text": "#{}"
        }
      ],
      "message": "`T` has not said it can be ordered, and this binding puts it in a set or a map",
      "notes": [
        "a set keeps its elements in order and a map keeps its keys in order, so say so with `where { T is ord, }`, which every type there is satisfies"
      ]
    },
