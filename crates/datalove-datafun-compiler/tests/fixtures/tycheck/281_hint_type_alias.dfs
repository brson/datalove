// A type alias in a hint, which synthesis resolved through no alias map and so
// reported as unresolved -- `let a: Age = 5` worked where `: Age / 5` did not.
type Age: u32
type Ages: [u32]
type MaybeAge: ?u32
type Colour: enum { atom Red, atom Blue }
type Point: { x: u32, y: u32 }

let a = : Age / 5
let b = : Ages / [1, 2, 3]
let c = : MaybeAge / some 4
let d = : Colour / atom Red
let e = : Point / { x = 1, y = 2 }

// And over a name rather than a literal.
let n: Age = 7
let f = : Age / n

// The other thing a bare name in type position can be, which goes through the
// same conversion.
fun pick<T>(x: T): T
  let y = : T / x
  ret y
end fun
