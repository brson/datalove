// An expected type still reaches `@`, and widening still has to be asked for.
type Colour: enum { atom Red, atom Blue }

fun widen_binding(n: u8): int
  let r: int = n@
  ret r
end fun

fun widen_argument(n: u8): int
  ret to_int(n@)
end fun

fun to_int(n: int): int
  ret n
end fun

fun widen_return(n: u8): int
  ret n@
end fun

fun widen_across_comparison(a: u8, b: int): bool
  ret a@ .< b
end fun

let widened: Colour = (atom Red)@
