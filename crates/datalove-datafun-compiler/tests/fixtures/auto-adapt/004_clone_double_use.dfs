// Test: double use of linear value requires @ operator
// Normal mode: should fail with ownership error D002 "value moved twice"
// Auto-adapt mode: should succeed by automatically inserting @
//
// Note: This test only verifies type checking auto-adapt currently.
// Ownership auto-adapt is implemented but not yet wired into this test runner.

fn test_ownership(s: string) -> (string, string) {
    // Second use of 's' would be a D002 error without @
    (s, @s)
}

let result = test_ownership("hello")
