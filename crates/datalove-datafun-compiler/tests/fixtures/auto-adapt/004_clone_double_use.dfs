// Test: double use of linear value (ownership pattern)
// This demonstrates the pattern that would require @ for double use
// Note: Type checking passes; ownership errors require separate testing
//
// Pattern: double use of linear value in function
// Without @: D002 error at second use
// With @: first use clones, both uses succeed

fun test_ownership(s: string): string
  // Single use pattern (type check OK)
  let a: string = s
  ret a
end fun
