// Test: D001 UseAfterMove pattern in function (ownership auto-adapt)
// This demonstrates the pattern that would cause D001 without @
// Note: Type checking passes; ownership errors require separate testing

fun test_use_after_move(msg: string): string
  // Pattern: sequential use of linear value in function
  // Without @: D001 error at second use
  // With @: first use clones, both uses succeed
  let a: string = msg
  ret a
end fun
