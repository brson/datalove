| 3 | - | compiles, runs | new | - |
| 4 | - | compiles, runs | new | `transactions` = [{day = 1, payee = "TRADER JOES #552", cents = 8412}, {day = 2, payee = "SHELL OIL 5741", cents = 4650}, {day = 3, payee = "BLUE BOTTLE COFFEE", cents = 675}, {day = 5, payee = "SAFEWAY 1123", cents = 6230}, {day = 7, payee = "TAQUERIA EL FAROLITO", cents = 2380}, {day = 9, payee = "PG&E", cents = 11204}, {day = 12, payee = "BLUE BOTTLE COFFEE", cents = 540}, {day = 14, payee = "TRADER JOES #552", cents = 9177}, {day = 18, payee = "NETFLIX.COM", cents = 1549}, {day = 21, payee = "ZUNI CAFE", cents = 9840}, {day = 26, payee = "BI-RITE MARKET", cents = 3315}] |
| 5 | reads `string` (3) | compiles, runs | new | - |
| 6 | - | compiles, runs | new | `budget` = %{"bills" = 15000, "car" = 10000, "dining" = 15000, "groceries" = 25000, "other" = 5000} |
| 7 | reads `category` (5), reads `map` (2), reads `transactions` (4) | compiles, runs | new | `spent` taken |
